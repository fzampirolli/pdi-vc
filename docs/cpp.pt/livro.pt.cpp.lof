\contentsline {figure}{\numberline {4.37}{\ignorespaces Simulador EP04\_08: Gradiente Morfológico, Top-hat e Black-hat}}{277}{figure.caption.173}%
\contentsline {figure}{\numberline {4.38}{\ignorespaces Simulador EP04\_09: Transformada de Distância (Camadas de Erosão)}}{279}{figure.caption.174}%
\contentsline {figure}{\numberline {4.39}{\ignorespaces Simulador EP04\_10: Separação de Blobs, Rotulação e Descritores}}{281}{figure.caption.175}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Decomposição de Fourier 1D: uma onda quadrada (linha tracejada) é aproximada pela soma das primeiras senoides (linhas coloridas). Quanto mais termos, melhor a aproximação.}}{286}{figure.caption.176}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Simulador interativo da decomposição de Fourier 1D: visualização da soma de senoides com diferentes frequências, amplitudes e fases. Adicione termos e observe a convergência para formas de onda arbitrárias.}}{287}{figure.caption.177}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Toda frequência no espectro (ponto isolado) corresponde a uma onda senoidal 2D rotacionada no domínio espacial.}}{291}{figure.caption.178}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Simulador interativo da síntese de Fourier 2D. Altere a posição horizontal (\(u\)) e vertical (\(v\)) do coeficiente no espectro de frequências centrado e observe como a distância em relação ao centro dita a frequência espacial (espessura) e o ângulo dita a orientação da onda senoidal gerada.}}{291}{figure.caption.179}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Diagrama conceitual do espectro de Fourier 2D centrado.}}{293}{figure.caption.182}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Experimento de troca de fase: Imagem A (moedas) e Imagem B (padrão geométrico) reconstruídas com magnitudes e fases trocadas. O resultado mostra que a estrutura visual é \textbf {muito mais sensível à fase} do que à magnitude: quando a fase de B é mantida, a imagem resultante preserva a organização espacial de B, mesmo com a magnitude de A. A magnitude, por sua vez, influencia principalmente o contraste e a textura. Observe que a qualidade da reconstrução não é perfeita --- há artefatos visíveis ---, evidenciando a interdependência entre fase e magnitude para uma representação fiel da imagem.}}{298}{figure.caption.183}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Comparação de eficiência: Convolução Não Separável (Espacial 2D), Separável (Espacial 1D) e via FFT.}}{302}{figure.caption.186}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Sem \emph {padding}, um deslocamento severo faz a imagem vazar para o lado oposto (convolução circular).}}{305}{figure.caption.187}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Teorema da Convolução: filtrar no domínio do espaço (Gaussiana) equivale a multiplicar o espectro por \(H(u,v)\) na frequência. As saídas coincidem visualmente.}}{307}{figure.caption.188}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces A Dualidade Perigosa: o corte abrupto na Frequência (cilindro Ideal) vira obrigatoriamente uma \emph {sinc} no espaço. Suas ondulações causam o \emph {ringing} fantasma nas bordas da imagem.}}{309}{figure.caption.189}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Filtros passa-baixa.}}{310}{figure.caption.194}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Simulador interativo de filtros no domínio da frequência.}}{311}{figure.caption.195}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Comparação entre filtros passa-baixa: Ideal (D₀=30), Gaussiano (D₀=30) e Butterworth (D₀=30, n=2). Perfis de H(u,v) ao longo de uma linha central e imagens filtradas correspondentes.}}{314}{figure.caption.196}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Filtro passa-alta Gaussiano. (a) Original; (b) Filtro passa-alta (D₀=30) - as bordas das moedas e fundo texturizado são realçados.}}{316}{figure.caption.197}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Remoção de ruído periódico via filtro \emph {notch} no domínio da frequência: (a) imagem com ruído senoidal, (b) espectro mostrando os picos do ruído, (c) máscara \emph {notch} centrada nos picos, (d) imagem restaurada.}}{319}{figure.caption.198}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Fourier global é cego para a posição. Os espectros não dizem onde as bordas estão.}}{322}{figure.caption.199}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Funções da \emph {Wavelet} (ψ). Note como elas rapidamente decaem para zero (suporte compacto), ao contrário das senoides infinitas de Fourier.}}{325}{figure.caption.200}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Diagrama da decomposição \emph {wavelet} 2D em dois níveis.}}{326}{figure.caption.201}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Simulação da decomposição \emph {wavelet} 2D.}}{327}{figure.caption.202}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Decomposição \emph {wavelet} 2D de 2 níveis com \emph {wavelet} Haar: subbandas LL, LH, HL, HH em cada nível. As subbandas de detalhe revelam estruturas orientadas em diferentes escalas utilizando um padrão sintético.}}{331}{figure.caption.203}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Comparação entre famílias de \emph {wavelets}: Haar, db4, sym4 e bior2.2. Subbanda LL₁ (aproximação) e HH₁ (diagonal) para cada escolha, ilustrando o compromisso entre compactação e suavidade com base no padrão sintético.}}{334}{figure.caption.204}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Reconstrução \emph {wavelet} com limiarização de coeficientes (\emph {hard thresholding}): à medida que o limiar aumenta, mais detalhes são zerados, produzindo imagens progressivamente mais suaves. Métrica PSNR quantifica a perda de qualidade sobre o padrão sintético.}}{338}{figure.caption.205}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces O Alfabeto Visual do JPEG: As 64 funções de base da DCT-II. O coeficiente DC fica no topo esquerdo (suave). Ao descer e avançar à direita, a oscilação espacial aumenta drasticamente.}}{343}{figure.caption.207}%
\contentsline {figure}{\numberline {5.24}{\ignorespaces DCT 2D em bloco 8×8: coeficientes e reconstrução progressiva.}}{347}{figure.caption.208}%
\contentsline {figure}{\numberline {5.25}{\ignorespaces \emph {Pipeline} JPEG simplificado aplicado à imagem clássica do \emph {Cameraman}: DCT em blocos 8×8, quantização com diferentes fatores de qualidade e reconstrução via IDCT. Os artefatos de bloco (\emph {blocking artifacts}) tornam-se visualmente evidentes em fatores de qualidade reduzidos (\(Q=10\) e \(Q=25\)).}}{350}{figure.caption.209}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Simulador interativo de compressão DCT-JPEG: ajuste o fator de qualidade e visualize em tempo real os coeficientes zerados, o bloco reconstruído e o erro de quantização.}}{351}{figure.caption.210}%
\contentsline {figure}{\numberline {5.27}{\ignorespaces Análise comparativa de artefatos de compressão sob fator de qualidade reduzido (\(Q=10\)). À esquerda, observa-se o artefato de bloco característico da discretização por DCT no JPEG. À direita, evidencia-se o efeito de atenuação e suavização de bordas intrínseco ao padrão WebP.}}{355}{figure.caption.213}%
\contentsline {figure}{\numberline {5.28}{\ignorespaces Curva taxa-distorção: PSNR vs tamanho de arquivo para JPEG, WebP e PNG aplicada à imagem do \emph {Cameraman}.}}{357}{figure.caption.214}%
\contentsline {figure}{\numberline {5.29}{\ignorespaces Análise espacial de degradação: imagens reconstruídas e respectivos mapas de erro absoluto normalizados para diferentes fatores de qualidade JPEG.}}{361}{figure.caption.215}%
\contentsline {figure}{\numberline {5.30}{\ignorespaces \emph {Pipeline} completo de remoção de ruído misto: (1) adição de ruído gaussiano e periódico; (2) identificação de picos de interferência no espectro de frequências; (3) aplicação de máscara \emph {notch} com atenuação gaussiana suave; (4) pós-processamento via filtro bilateral para eliminação do ruído estocástico residual.}}{366}{figure.caption.216}%
\contentsline {figure}{\numberline {5.31}{\ignorespaces Mapa conceitual das transformações e propriedades no domínio da frequência.}}{367}{figure.caption.217}%
\contentsline {figure}{\numberline {5.32}{\ignorespaces Simulador EP05\_01: Filtro Passa-Baixa Ideal no Espectro}}{373}{figure.caption.218}%
\contentsline {figure}{\numberline {5.33}{\ignorespaces Simulador EP05\_02: Filtro Notch}}{375}{figure.caption.219}%
\contentsline {figure}{\numberline {5.34}{\ignorespaces Simulador EP05\_03: Quantização DCT (\emph {round-trip})}}{377}{figure.caption.220}%
\contentsline {figure}{\numberline {5.35}{\ignorespaces Simulador EP05\_04: DFT 2D manual}}{378}{figure.caption.221}%
\contentsline {figure}{\numberline {5.36}{\ignorespaces Simulador EP05\_05: \emph {Pipeline} JPEG completo em bloco}}{380}{figure.caption.222}%
