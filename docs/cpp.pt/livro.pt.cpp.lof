\contentsline {figure}{\numberline {4.1}{\ignorespaces Imagem com moedas de vários tipos. Crédito: GAZI.MD.AHAD (CC BY-SA 4.0).}}{192}{figure.caption.123}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces CLAHE (realce adaptativo com limite de contraste) antes da limiarização de Otsu: original, realçado, histograma e binarização. (A trilha Python também traça as curvas de \(\mitsigma ^2_B(T)\).)}}{194}{figure.caption.124}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Elemento estruturante em formato de cruz (\(B_{\text {cruz}}\)) utilizado para conectividade-4.}}{196}{figure.caption.126}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Erosão e dilatação em imagem binária 10×10 com elemento estruturante `L' assimétrico 3×3. Validação da dualidade erosão--dilatação.}}{202}{figure.caption.128}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Simulador: Erosão Morfológica (A ⊖ B\_L)}}{203}{figure.caption.129}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Abertura, fechamento, composição e filtro sequencial alternado aplicados à binarização Otsu das moedas (pré-processadas por realce de contraste). Elemento estruturante: disco 13×13.}}{206}{figure.caption.132}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Simulador interativo de dilatação geodésica: o marcador f (verde) propaga-se passo a passo pelos caminhos livres da máscara g, sem atravessar paredes.}}{208}{figure.caption.134}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Resolução de labirinto no domínio complementar: com máscara e marcador invertidos, \emph {mm::cero} e \emph {mm::suprec} propagam a onda geodésica pelos corredores.}}{211}{figure.caption.136}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \emph {Pipeline} de Reconstrução Morfológica por Dilatação Condicionada: a máscara contém dois objetos, o marcador isola apenas o núcleo do objeto principal, e as iterações reconstroem sua forma exata até a convergência.}}{214}{figure.caption.138}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \emph {Pipeline} de preenchimento de buracos (\emph {clohole}): o marcador vem da borda da imagem, restrito ao complemento \(f^c\). A dilatação geodésica reconstrói o fundo externo; após a complementação, os buracos internos ficam preenchidos.}}{217}{figure.caption.141}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \emph {Pipeline} de eliminação de estruturas de borda (\emph {edgeoff}): o marcador captura as raízes conectadas às extremidades, a reconstrução delimita esses elementos e a subtração preserva só os objetos totalmente internos.}}{219}{figure.caption.142}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces \emph {Pipeline} completo de segmentação com CLAHE: Otsu → abertura (r=9) → clohole → abertura (r=33) → edgeoff.}}{221}{figure.caption.143}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Simulador interativo avançado de morfologia com elemento estruturante editável e perfil 1D.}}{223}{figure.caption.147}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Morfologia em tons de cinza e seus histogramas: erosão, dilatação, gradiente, top-hat e black-hat. Elemento estruturante: disco de diâmetro 19.}}{225}{figure.caption.148}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Algoritmo de rotulação por \emph {flood-fill} com pilha.}}{227}{figure.caption.150}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Simulador interativo de rotulação de componentes conexas (\emph {connected component labeling}): visualização da expansão flood-fill, conectividade-4 e conectividade-8.}}{228}{figure.caption.151}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Efeito da conectividade na rotulação (\emph {mm::label0}): pixels diagonalmente adjacentes formam componentes distintas em conectividade-4 e se fundem em conectividade-8.}}{230}{figure.caption.152}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Algoritmo da Transformada de Distância.}}{232}{figure.caption.153}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Simulador interativo da Transformada de Distância (TD) iterativa via erosão em tons de cinza. Pixels fora da imagem assumem o valor máximo (144), propagando os custos a partir do fundo interno.}}{233}{figure.caption.154}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Transformada de Distância em imagem binária 10×10. Esquerda: original (\emph {foreground} = 255). Centro: mm.dist1 iterativa (erosões com cruz). Direita: mm.dist (L2).}}{234}{figure.caption.155}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Simulador interativo 2D (4x4) com sincronização estrita de filas de propagação horizontal (b) para obter a convergência exata descrita no artigo.}}{235}{figure.caption.156}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Menor caminho geodésico em um labirinto. As distâncias geodésicas são calculadas a partir da entrada e da saída usando mm.gdist. Os pixels cujo somatório das duas distâncias é igual à distância mínima entre os marcadores pertencem a um caminho ótimo.}}{237}{figure.caption.157}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Algoritmo Didático de \emph {Watershed} por Crescimento de Regiões Limitado por Máscara.}}{240}{figure.caption.158}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Simulador interativo do Algoritmo \emph {Watershed} por propagação morfológica. Desenhe a máscara, posicione os marcadores e ajuste o Elemento Estruturante para observar a inundação. Quando as bacias se encontram simultaneamente, o empate é resolvido assumindo uma das regiões de forma aleatória.}}{241}{figure.caption.159}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} \emph {watershed} delimitado por máscara em imagem binária 20×20.}}{242}{figure.caption.160}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces \emph {Pipeline} \emph {Watershed} para separação de moedas sobrepostas: da máscara binária dilatada até os contornos finais anotados sobre a imagem original.}}{246}{figure.caption.161}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Componentes conexos extraídos após o \emph {pipeline} CLAHE → Otsu → limpeza morfológica. Cada objeto é colorido com cor distinta e anotado com sua área em pixels.}}{250}{figure.caption.162}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Contornos extraídos com \emph {findContours}. Cada moeda é anotada com sua circularidade --- valores próximos de 1 confirmam forma circular.}}{253}{figure.caption.163}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces \emph {Bounding boxes} derivadas dos componentes conexos sobrepostas à imagem original. As anotações são exportadas no formato YOLO (\emph {classe cx cy w h}), com coordenadas normalizadas para o intervalo {[}0,1{]}.}}{256}{figure.caption.164}%
\contentsline {figure}{\numberline {4.30}{\ignorespaces Simulador EP04\_01: Limiarização Global por Limiar Fixo (p' = (p \textgreater {} T) ? 255 : 0)}}{262}{figure.caption.166}%
\contentsline {figure}{\numberline {4.31}{\ignorespaces Simulador EP04\_02: Limiarização Automática de Otsu (T* = argmax σ²\_B(T))}}{264}{figure.caption.167}%
\contentsline {figure}{\numberline {4.32}{\ignorespaces Simulador EP04\_03: Dilatação Binária Plana (g = f ⊕ B)}}{266}{figure.caption.168}%
\contentsline {figure}{\numberline {4.33}{\ignorespaces Simulador EP04\_04: Erosão Binária Plana (g = f ⊖ B)}}{268}{figure.caption.169}%
\contentsline {figure}{\numberline {4.34}{\ignorespaces Simulador EP04\_05: Abertura Morfológica (g = (f ⊖ B) ⊕ B)}}{270}{figure.caption.170}%
\contentsline {figure}{\numberline {4.35}{\ignorespaces Simulador EP04\_06: Fechamento Morfológico (g = (f ⊕ B) ⊖ B)}}{272}{figure.caption.171}%
