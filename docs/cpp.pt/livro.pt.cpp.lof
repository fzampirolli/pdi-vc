\contentsline {figure}{\numberline {3.1}{\ignorespaces \emph {Mandrill} (\emph {Mandrillus sphinx}) fotografado em ambiente natural na África do Sul. Crédito: Carlos Guilherme Rodrigues (CC BY-SA 3.0).}}{113}{figure.caption.63}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Operações aritméticas saturadas: adição de constante (clareamento) e subtração de constante (escurecimento com saturação em 0).}}{115}{figure.caption.65}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Retrato de um leopardo (\emph {Panthera pardus}) em ambiente natural. Crédito: C. Brück (CC BY-SA 4.0).}}{116}{figure.caption.67}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces \emph {Alpha blending} entre recortes alinhados de mandrill e do leopardo (Figura~\ref {fig-03-leopardo}) para diferentes valores de α. Em α=1 vê-se apenas mandrill; em α=0, apenas o leopardo; valores intermediários fundem os olhares das duas imagens proporcionalmente.}}{118}{figure.caption.68}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Operações lógicas bit a bit com máscara circular: AND (isolamento da ROI), OR (iluminação da ROI) e NOT (negativo).}}{119}{figure.caption.70}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Histogramas da imagem original, de uma versão escurecida (−80) e de uma clareada (+80). A subtração/adição satura em 0 e 255.}}{121}{figure.caption.73}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Equalização de histograma numa imagem 5×5 de 3 bits (L=8): tons concentrados em \{2,3,4\} são redistribuídos pela CDF. \emph {mm::equalize(img, 3)} faz o mapeamento.}}{123}{figure.caption.75}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Equalização de histograma global (mm::equalize, via CDF) e os histogramas antes/depois. CLAHE (adaptativa) fica só na trilha Python --- não tem equivalente em morph.hpp.}}{125}{figure.caption.76}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Especificação de histograma (mapear o mandril para o perfil tonal do leopardo) precisa da CDF inversa da referência --- fica só na trilha Python. Aqui, a equalização global do mandril, como comparação.}}{127}{figure.caption.78}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Correlação com \emph {kernel} de média 3×3: versão didática mm::conv0 (bordas preservadas) vs.~mm::conv (borda refletida). A diferença se concentra nas bordas.}}{134}{figure.caption.83}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces \emph {Patch} 5×5 extraído da imagem do leopardo (posição {[}250:255, 250:255{]}). A janela amarela destaca a vizinhança 3×3 centrada no pixel {[}1,1{]} onde a correlação será calculada.}}{136}{figure.caption.84}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Filtro de média com \emph {kernels} de tamanho crescente (3×3, 7×7, 15×15). O borramento das bordas aumenta com o tamanho do \emph {kernel}.}}{138}{figure.caption.86}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces \emph {Kernel} Gaussiano 5×5 (σ=1): resposta ao impulso do filtro --- pesos maiores no centro, decrescendo radialmente.}}{140}{figure.caption.88}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Comparação entre filtro de média e Gaussiano (\emph {kernel} 9×9, σ=0). O Gaussiano preserva melhor as bordas, visível no detalhe do rosto.}}{142}{figure.caption.89}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Simulador: Filtragem Espacial de Realce 1D (Unsharp Masking e High-Boost)}}{143}{figure.caption.91}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces \emph {Kernel} Laplaciano w4 sobre o \emph {patch} 5×5: a janela amarela destaca a vizinhança 3×3 onde o operador de segunda derivada é calculado.}}{145}{figure.caption.95}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Laplaciano aplicado à imagem do leopardo: resposta bruta (bordas) com w4 e w8, e imagens realçadas pela subtração do Laplaciano. w8 é mais sensível às diagonais.}}{147}{figure.caption.96}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces Operador de Sobel na imagem do leopardo: a magnitude \textbar ∇f\textbar {} combina os gradientes horizontal e vertical, revelando todas as bordas. A decomposição Gx/Gy com sinal fica na trilha Python --- mm::sobel devolve a magnitude já com clip.}}{149}{figure.caption.100}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces Operador de Prewitt: magnitude do gradiente, comparável ao Sobel mas sem a ponderação central. mm::prewitt devolve \textbar ∇f\textbar {} com clip.}}{150}{figure.caption.102}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Realce por \emph {Unsharp Masking} num \emph {patch} do leopardo: mm::usm faz suavização Gaussiana, subtrai da original (máscara de alta frequência) e reintroduz a máscara realçada.}}{153}{figure.caption.104}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces \emph {Unsharp Masking} na imagem do leopardo com σ=1 e k de 0.5 a 8.0. Para k\textgreater 2 surgem halos nas bordas e o ruído de fundo aparece.}}{154}{figure.caption.105}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Detector de Canny com diferentes pares de limiar: limiares baixos capturam mais bordas (inclusive ruído); limiares altos retêm apenas as bordas mais fortes.}}{155}{figure.caption.106}%
\contentsline {figure}{\numberline {3.23}{\ignorespaces Ruído sal e pimenta com densidades crescentes (2\%, 5\%, 10\%): metade dos pixels corrompidos vira sal (255), metade pimenta (0).}}{158}{figure.caption.107}%
\contentsline {figure}{\numberline {3.24}{\ignorespaces Filtros para ruído sal e pimenta (10\%): Gaussiano, Média e Mediana. Bilateral e morfológico (open+close) ficam só na trilha Python --- bilateral não tem equivalente em morph.hpp e morfologia é do próximo capítulo.}}{161}{figure.caption.109}%
\contentsline {figure}{\numberline {3.25}{\ignorespaces \emph {Pipeline} de pré-processamento: equalização → Gaussiano → Canny. A trilha Python usa CLAHE no lugar da equalização global; CLAHE não tem equivalente em morph.hpp.}}{163}{figure.caption.110}%
