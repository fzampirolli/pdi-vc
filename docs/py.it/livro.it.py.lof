\contentsline {figure}{\numberline {7.1}{\ignorespaces Esempio motivazionale: diverse frutta che formano raggruppamenti distinti in uno spazio di caratteristiche.}}{368}{figure.caption.252}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Panoramica del \emph {pipeline} classico di classificazione delle immagini: estrazione dei descrittori (LBP, HOG), costruzione dello spazio delle caratteristiche e classificazione tramite k-NN. Non si applica a modelli di Deep Learning (CNN, YOLO), che apprendono \emph {feature end-to-end} direttamente dai pixel. \textbf {Fonte:} elaborato con l'ausilio di Gemini Notebook (\{GOOGLE\}, 2025).}}{369}{figure.caption.253}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Confronto visivo di diversi descrittori applicati alla stessa immagine. Ogni descrittore rivela aspetti distinti della scena.}}{371}{figure.caption.254}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Istogramma dei codici LBP dell'immagine dei cameramen. Ogni barra rappresenta la frequenza relativa di un codice LBP, formando il vettore di caratteristiche utilizzato per descrivere la texture.}}{372}{figure.caption.255}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Primi 100 componenti del vettore di caratteristiche HOG.}}{374}{figure.caption.256}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Importanza della normalizzazione delle caratteristiche per il classificatore k-NN.}}{377}{figure.caption.257}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Mappa concettuale del processo di classificazione delle immagini mediante descrittori classici (LBP, HOG, pixel grezzi) e classificatore tradizionale (k-NN). Non si applica ai modelli di Deep Learning (CNN, YOLO), che apprendono \emph {feature end-to-end} direttamente dai pixel.}}{378}{figure.caption.258}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Matrici di confusione ottenute dal classificatore k-NN utilizzando tre diversi descrittori. Le righe rappresentano la classe reale (Mela, Banana e Arancia) e le colonne la classe predetta. Maggiore è la concentrazione di valori sulla diagonale principale, migliore è la prestazione del descrittore.}}{381}{figure.caption.259}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Confronto dettagliato dell'accuratezza globale in uno scenario realistico. Si noti come i descrittori estratti strutturalmente (LBP e HOG) superino l'uso delle intensità pure dei pixel grezzi.}}{382}{figure.caption.260}%
\contentsline {figure}{\numberline {7.10}{\ignorespaces Illustrazione del processo di generazione di dati sintetici con \emph {make\_classification}. A sinistra, visualizzazione delle tre classi in uno spazio bidimensionale formato da due caratteristiche informative. A destra, importanza relativa di ciascuna caratteristica per la classificazione, evidenziando che solo 7 delle 10 caratteristiche sono effettivamente discriminative, mentre le restanti sono ridondanti (2) o ripetute (1).}}{385}{figure.caption.261}%
\contentsline {figure}{\numberline {7.11}{\ignorespaces Classificazione di un nuovo campione tramite l'algoritmo k-NN. Il punto di test (stella) viene classificato in base ai tre vicini più prossimi, evidenziati da cerchi.}}{388}{figure.caption.262}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces Simulatore interattivo della frontiera di decisione del k-NN: aggiungi punti di addestramento e regola il valore di k per osservare l'effetto sulla regione di decisione.}}{389}{figure.caption.263}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces Campione di cifre scritte a mano dal database \emph {load\_digits}, utilizzato come caso di studio di classificazione.}}{390}{figure.caption.264}%
\contentsline {figure}{\numberline {7.14}{\ignorespaces Matrice di confusione del classificatore k-NN addestrato con vettori di intensità grezzi (pixel).}}{391}{figure.caption.265}%
\contentsline {figure}{\numberline {7.15}{\ignorespaces Confronto di accuratezza tra descrittori di pixel grezzi e HOG per il classificatore k-NN (k=3) sulla base di cifre.}}{392}{figure.caption.266}%
\contentsline {figure}{\numberline {7.16}{\ignorespaces Precisione media per cross-validazione (5 fold) in funzione del parametro k, per la base di cifre con vettori di intensità grezzi.}}{394}{figure.caption.267}%
\contentsline {figure}{\numberline {7.17}{\ignorespaces Precisione sui set di addestramento e test per diversi valori di \(k\). Le regioni colorate rappresentano, in modo concettuale, tendenze di comportamento del classificatore: maggiore rischio di sovradattamento (rosso), compromesso tra bias e varianza (verde) e maggiore rischio di sottoadattamento (blu).}}{396}{figure.caption.268}%
\contentsline {figure}{\numberline {7.18}{\ignorespaces Campioni sintetici delle tre classi di consistenza utilizzate nell'esperimento di classificazione, generati con rumore gaussiano e variabilità intra-classe.}}{398}{figure.caption.269}%
\contentsline {figure}{\numberline {7.19}{\ignorespaces Precisione media ottenuta tramite validazione incrociata (5-fold) per i descrittori di Pixel Grezzi, LBP e HOG applicati alla base di texture sintetiche.}}{400}{figure.caption.270}%
\contentsline {figure}{\numberline {7.20}{\ignorespaces Metriche di valutazione dettagliate per il classificatore k-NN con descrittori LBP}}{403}{figure.caption.271}%
\contentsline {figure}{\numberline {7.21}{\ignorespaces Simulatore EP07\_01: Classificatore k-NN Passo dopo Passo}}{409}{figure.caption.272}%
\contentsline {figure}{\numberline {7.22}{\ignorespaces Simulatore EP07\_02: Effetto della Normalizzazione \emph {Z-score} sulla Distanza k-NN}}{411}{figure.caption.273}%
\contentsline {figure}{\numberline {7.23}{\ignorespaces Simulatore EP07\_03: Precisione x Richiamo}}{413}{figure.caption.274}%
\contentsline {figure}{\numberline {7.24}{\ignorespaces Simulatore EP07\_04: Codice LBP di un Intorno 3×3}}{415}{figure.caption.275}%
\contentsline {figure}{\numberline {7.25}{\ignorespaces Simulatore EP07\_05: Istogramma HOG di una Cella (mappatura degli angoli in bin)}}{418}{figure.caption.276}%
\contentsline {figure}{\numberline {7.26}{\ignorespaces Simulatore EP07\_06: \emph {Pipeline} k-NN Multi-Classe (votazione, spareggio e matrice di confusione)}}{421}{figure.caption.277}%
