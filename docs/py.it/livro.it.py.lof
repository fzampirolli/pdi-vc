\contentsline {figure}{\numberline {3.1}{\ignorespaces \emph {Mandrill} (\emph {Mandrillus sphinx}) fotografato in ambiente naturale in Sud Africa. Credito: Carlos Guilherme Rodrigues (CC BY-SA 3.0).}}{99}{figure.caption.64}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Operazioni aritmetiche sature: somma di costante (schiarimento) e sottrazione di costante (oscuramento con saturazione a 0).}}{100}{figure.caption.66}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Ritratto di un leopardo (\emph {Panthera pardus}) in ambiente naturale. Credito: C. Brück (CC BY-SA 4.0).}}{101}{figure.caption.68}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces \emph {Alpha blending} tra ritagli allineati del mandrillo e del leopardo (Figura~\ref {fig-03-leopardo}) per diversi valori di α. Con α=1 si vede solo il mandrillo; con α=0, solo il leopardo; valori intermedi fondono proporzionalmente gli sguardi delle due immagini.}}{101}{figure.caption.69}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Operazioni logiche bit a bit con maschera circolare: AND (isolamento della ROI), OR (illuminazione della ROI) e NOT (negativo).}}{102}{figure.caption.71}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Istogrammi dell'immagine originale, di una versione scurita (−80) e di una schiarita (+80). La sottrazione/addizione satura a 0 e 255.}}{103}{figure.caption.74}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Equalizzazione dell'istogramma in un'immagine 5×5 con 3 bit (L=8): immagine originale con toni concentrati in \{2,3,4\}, immagine equalizzata con toni redistribuiti in \{1,5,7\}, e i rispettivi istogrammi che evidenziano la distribuzione delle frequenze.}}{106}{figure.caption.76}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Equalizzazione dell'istogramma: mm.equalize (globale tramite CDF) vs.~CLAHE (adattativa con limitazione del contrasto). Gli istogrammi rivelano la diffusione progressiva delle intensità.}}{107}{figure.caption.77}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Specifica dell'istogramma: mandrillo mappato sul profilo tonale del leopardo. La CDF dell'output approssima la CDF di riferimento.}}{108}{figure.caption.79}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Correlazione con \emph {kernel} di media 3×3: versione didattica (mm.conv0) vs.~vettorizzata (mm.conv via cv2.filter2D). La differenza massima di 39 si verifica ai bordi.}}{115}{figure.caption.84}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces \emph {Patch} 5×5 estratto dall'immagine del leopardo (posizione {[}250:255, 250:255{]}). La finestra gialla evidenzia l'intorno 3×3 centrato sul pixel {[}1,1{]} dove verrà calcolata la correlazione.}}{115}{figure.caption.85}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Filtro medio con \emph {kernel} di dimensione crescente (3×3, 7×7, 15×15). La sfocatura dei bordi aumenta con la dimensione del \emph {kernel}.}}{117}{figure.caption.87}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces \emph {Kernel} Gaussiano 5×5 (σ=1): pesi normalizzati, maggiori al centro e decrescenti radialmente. La griglia facilita la lettura di ogni coefficiente.}}{118}{figure.caption.89}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Confronto tra filtro medio e Gaussiano (\emph {kernel} 9×9, σ=0). Il Gaussiano preserva meglio i bordi, visibile nel dettaglio del volto.}}{119}{figure.caption.90}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Simulatore: Filtraggio Spaziale di Enfasi 1D (Unsharp Masking e High-Boost)}}{120}{figure.caption.92}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces \emph {Kernel} Laplaciano w4 applicato al \emph {patch} 5×5: la finestra gialla evidenzia il vicinato 3×3 dove l'operatore di derivata seconda viene calcolato.}}{122}{figure.caption.96}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Laplaciano applicato all'immagine del leopardo: risposta grezza (bordi) con w4 e w8, e immagini evidenziate dalla sottrazione del Laplaciano. w8 è più sensibile alle diagonali.}}{123}{figure.caption.97}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces Operatore di Sobel sull'immagine del leopardo: Gx rileva i bordi verticali, Gy rileva i bordi orizzontali, e la magnitudine \textbar ∇f\textbar {} li combina entrambi, rivelando tutti i bordi indipendentemente dalla direzione.}}{125}{figure.caption.101}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces Operatore di Prewitt: Gx, Gy e magnitudine --- paragonabile al Sobel, ma senza ponderazione Gaussiana perpendicolare.}}{125}{figure.caption.103}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Enfatizzazione della nitidezza tramite \emph {Unsharp Masking} sull'immagine del leopardo: l'immagine sfocata viene sottratta dall'originale per generare la maschera ad alta frequenza, che viene poi reintrodotta per enfatizzare bordi e dettagli.}}{127}{figure.caption.105}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces \emph {Unsharp Masking} sull'immagine del leopardo con σ=1 e k da 0.5 a 8.0. Per k\textgreater 2 compaiono aloni sui bordi e il rumore di sfondo appare.}}{128}{figure.caption.106}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Rivelatore di Canny con diverse coppie di soglia: soglie basse catturano più bordi (incluso il rumore); soglie alte mantengono solo i bordi più forti.}}{129}{figure.caption.107}%
\contentsline {figure}{\numberline {3.23}{\ignorespaces Rumore sale e pepe con densità crescenti (2\%, 5\%, 10\%). Il parametro prob indica la frazione totale di pixel corrotti, metà sale (255) e metà pepe (0).}}{130}{figure.caption.108}%
\contentsline {figure}{\numberline {3.24}{\ignorespaces Confronto di filtri per la rimozione del rumore sale e pepe (10\%): Gaussiano, Media, Mediana, Bilaterale e Morfologico. Riga superiore: immagini complete; riga inferiore: ritaglio della regione di interesse.}}{133}{figure.caption.110}%
\contentsline {figure}{\numberline {3.25}{\ignorespaces \emph {Pipeline} di preprocessamento: CLAHE → Gaussiano → Canny. Ogni fase prepara l'immagine per la successiva, ottenendo bordi puliti e ben definiti.}}{134}{figure.caption.111}%
\contentsline {figure}{\numberline {3.26}{\ignorespaces Simulatore EP03\_01: Addizione Saturata con Costante (p' = clip(p + k))}}{138}{figure.caption.112}%
\contentsline {figure}{\numberline {3.27}{\ignorespaces Simulatore EP03\_02: Alpha Blending di Due Immagini (g = α·f1 + (1−α)·f2)}}{140}{figure.caption.113}%
\contentsline {figure}{\numberline {3.28}{\ignorespaces Simulatore EP03\_03: Inversione dell'immagine --- Negativo fotografico (p' = 255 − p)}}{142}{figure.caption.114}%
\contentsline {figure}{\numberline {3.29}{\ignorespaces Simulatore EP03\_04: Equalizzazione dell'istogramma (Livelli L = 2\^{}B)}}{144}{figure.caption.115}%
\contentsline {figure}{\numberline {3.30}{\ignorespaces Simulatore EP03\_05: Applicazione di Maschera AND Binaria}}{146}{figure.caption.116}%
\contentsline {figure}{\numberline {3.31}{\ignorespaces Simulatore EP03\_06: Filtro Media con Kernel N×N}}{148}{figure.caption.117}%
\contentsline {figure}{\numberline {3.32}{\ignorespaces Simulatore EP03\_07: Operatore Laplaciano (w4) per l'Enfasi dei Bordi}}{150}{figure.caption.118}%
\contentsline {figure}{\numberline {3.33}{\ignorespaces Simulatore EP03\_08: Gradiente di Sobel (Gx e Gy)}}{153}{figure.caption.119}%
\contentsline {figure}{\numberline {3.34}{\ignorespaces Simulatore EP03\_09: Filtro della Mediana 3×3}}{155}{figure.caption.120}%
