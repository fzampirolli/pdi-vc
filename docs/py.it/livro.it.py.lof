\contentsline {figure}{\numberline {4.1}{\ignorespaces Immagine con monete di vari tipi. Crediti: GAZI.MD.AHAD (CC BY-SA 4.0).}}{161}{figure.caption.124}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Comparação dos pré-processamentos: imagem \textbar {} histograma+T* \textbar {} σ²B(T) \textbar {} Otsu. A melhor separação bimodal indica o limiar mais confiável.}}{164}{figure.caption.125}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Elemento strutturante a forma di croce (\(B_{\text {cruz}}\)) utilizzato per la connettività-4.}}{166}{figure.caption.127}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Erosione e dilatazione su immagine binaria 10×10 con elemento strutturante `L' asimmetrico 3×3. Validazione della dualità erosione--dilatazione.}}{172}{figure.caption.129}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Simulatore: Erosione Morfologica (A ⊖ B\_L)}}{172}{figure.caption.130}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Apertura, chiusura, composizione e filtro sequenziale alternato applicati alla binarizzazione di Otsu delle monete (pre-processate con miglioramento del contrasto). Elemento strutturante: disco 13×13.}}{174}{figure.caption.133}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Simulatore interattivo di dilatazione geodetica: il marker f (verde) si propaga passo dopo passo attraverso i percorsi liberi della maschera g, senza attraversare pareti.}}{176}{figure.caption.135}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Risoluzione del labirinto tramite Operazioni Complementari: invertendo la maschera e il marker all'inizio del \emph {pipeline}, il flusso viene risolto direttamente nel dominio complementare tramite mm.cero e mm.suprec, eliminando inversioni ridondanti.}}{179}{figure.caption.137}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \emph {Pipeline} di Ricostruzione Morfologica per Dilatazione Condizionata: la maschera contiene due oggetti, il marcatore isola solo il nucleo dell'oggetto principale, e le iterazioni ricostruiscono la sua forma esatta fino alla convergenza.}}{181}{figure.caption.139}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \emph {Pipeline} di riempimento dei buchi (\emph {clohole}): il marcatore proviene dal bordo dell'immagine, ristretto al complemento \(f^c\). La dilatazione geodetica ricostruisce lo sfondo esterno; dopo la complementazione, i buchi interni risultano riempiti.}}{183}{figure.caption.142}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \emph {Pipeline} di eliminazione delle strutture di bordo (\emph {edgeoff}): il marker cattura le radici connesse alle estremità, la ricostruzione delimita questi elementi e la sottrazione preserva solo gli oggetti totalmente interni.}}{184}{figure.caption.143}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces \emph {Pipeline} completo di segmentazione con CLAHE: Otsu → apertura (r=9) → clohole → apertura (r=33) → edgeoff.}}{185}{figure.caption.144}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Simulatore interattivo avanzato di morfologia con elemento strutturante modificabile e profilo 1D.}}{186}{figure.caption.148}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Morfologia in toni di grigio e i rispettivi istogrammi. L'erosione riduce le intensità locali, la dilatazione le amplia, il gradiente evidenzia i bordi, e gli operatori Top-hat e Black-hat mettono in risalto dettagli locali brillanti e scuri. Elemento strutturante: disco di diametro 19.}}{188}{figure.caption.149}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Algoritmo di etichettatura per \emph {flood-fill} con pila.}}{191}{figure.caption.151}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Simulatore interattivo di etichettatura delle componenti connesse (\emph {connected component labeling}): visualizzazione dell'espansione flood-fill, connettività-4 e connettività-8.}}{192}{figure.caption.152}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Effetto della connettività sull'etichettatura: l'immagine binaria 10×10 contiene pixel diagonalmente adiacenti. Con connettività-4, questi pixel formano componenti distinte; con connettività-8, si fondono in un'unica componente.}}{192}{figure.caption.153}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Algoritmo della Trasformata della Distanza.}}{194}{figure.caption.154}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Simulatore interattivo della Trasformata della Distanza (TD) iterativa tramite erosione in toni di grigio. I pixel fuori dall'immagine assumono il valore massimo (144), propagando i costi a partire dallo sfondo interno.}}{195}{figure.caption.155}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Trasformata della Distanza su immagine binaria 10×10. A sinistra: originale (\emph {foreground} = 255). Centro: mm.dist1 iterativa (erosioni con croce). A destra: mm.dist (L2).}}{195}{figure.caption.156}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Simulatore interattivo 2D (4x4) con sincronizzazione rigorosa delle code di propagazione orizzontale (b) per ottenere la convergenza esatta descritta nell'articolo.}}{196}{figure.caption.157}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Percorso geodetico minimo in un labirinto. Le distanze geodetiche sono calcolate da ingresso e uscita usando mm.gdist. I pixel la cui somma delle due distanze è uguale alla distanza minima tra i marcatori appartengono a un percorso ottimale.}}{198}{figure.caption.158}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Algoritmo Didattico di \emph {Watershed} per Crescita di Regioni Limitato da Maschera.}}{199}{figure.caption.159}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Simulatore interattivo dell'Algoritmo \emph {Watershed} per propagazione morfologica. Disegna la maschera, posiziona i marcatori e regola l'Elemento Strutturante per osservare l'inondazione. Quando i bacini si incontrano simultaneamente, il pareggio viene risolto assumendo una delle regioni in modo casuale.}}{200}{figure.caption.160}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} \emph {watershed} delimitato da maschera su immagine binaria 20×20.}}{202}{figure.caption.161}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces \emph {Pipeline} \emph {Watershed} per la separazione di monete sovrapposte: dalla maschera binaria dilatata fino ai contorni finali annotati sull'immagine originale.}}{203}{figure.caption.162}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Componenti connessi estratti dopo la pipeline CLAHE → Otsu → pulizia morfologica. Ogni oggetto è colorato con colore distinto e annotato con la sua area in pixel.}}{205}{figure.caption.163}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Contorni estratti con \emph {findContours}. Ogni moneta è annotata con la sua circolarità --- valori vicini a 1 confermano la forma circolare.}}{207}{figure.caption.164}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces \emph {Bounding boxes} derivate dai componenti connessi sovrapposte all'immagine originale. Le annotazioni vengono esportate nel formato YOLO (\emph {classe cx cy w h}), con coordinate normalizzate all'intervallo {[}0,1{]}.}}{209}{figure.caption.165}%
\contentsline {figure}{\numberline {4.30}{\ignorespaces Simulatore EP04\_01: Soglia Globale con Soglia Fissa (p' = (p \textgreater {} T) ? 255 : 0)}}{214}{figure.caption.167}%
\contentsline {figure}{\numberline {4.31}{\ignorespaces Simulatore EP04\_02: Soglia Automatica di Otsu (T* = argmax σ²\_B(T))}}{216}{figure.caption.168}%
\contentsline {figure}{\numberline {4.32}{\ignorespaces Simulatore EP04\_03: Dilatazione Binaria Piana (g = f ⊕ B)}}{219}{figure.caption.169}%
\contentsline {figure}{\numberline {4.33}{\ignorespaces Simulatore EP04\_04: Erosione Binaria Piana (g = f ⊖ B)}}{221}{figure.caption.170}%
\contentsline {figure}{\numberline {4.34}{\ignorespaces Simulatore EP04\_05: Apertura Morfologica (g = (f ⊖ B) ⊕ B)}}{223}{figure.caption.171}%
\contentsline {figure}{\numberline {4.35}{\ignorespaces Simulatore EP04\_06: Chiusura Morfologica (g = (f ⊕ B) ⊖ B)}}{225}{figure.caption.172}%
\contentsline {figure}{\numberline {4.36}{\ignorespaces Simulatore EP04\_07: Dilatazione ed Erosione con Pesi (mm.dil1 / mm.ero1)}}{228}{figure.caption.173}%
\contentsline {figure}{\numberline {4.37}{\ignorespaces Simulatore EP04\_08: Gradiente Morfologico, Top-hat e Black-hat}}{230}{figure.caption.174}%
\contentsline {figure}{\numberline {4.38}{\ignorespaces Simulatore EP04\_09: Trasformata di Distanza (Strati di Erosione)}}{232}{figure.caption.175}%
