\contentsline {figure}{\numberline {6.1}{\ignorespaces Campione di immagini pubbliche da \emph {skimage.data}, raggruppate per area di applicazione.}}{308}{figure.caption.224}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Confronto tra strategie di pre-elaborazione per la binarizzazione dell'immagine testuale: (a) immagine originale; (b) sogliatura diretta con il metodo di Otsu; (c) sfondo stimato mediante filtro gaussiano; (d) immagine dopo normalizzazione dello sfondo (divisione per l'immagine smussata); (e) CLAHE seguito da sogliatura di Otsu; e (f) normalizzazione dello sfondo seguita da sogliatura di Otsu. Le immagini illustrano l'effetto di ciascuna tecnica sulla compensazione delle variazioni di illuminazione e sulla qualità della segmentazione.}}{309}{figure.caption.225}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Confronto del testo estratto da Tesseract da quattro versioni della stessa immagine: (a) immagine originale; (b) CLAHE seguito da sogliatura di Otsu; (c) normalizzazione dello sfondo seguita da sogliatura di Otsu; e (d) normalizzazione dello sfondo in scala di grigi, senza sogliatura. Il confronto evidenzia che la binarizzazione esterna non sempre favorisce il riconoscimento, poiché Tesseract esegue già internamente la propria binarizzazione adattiva.}}{312}{figure.caption.226}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Flusso di riconoscimento e traduzione automatica. L'immagine preprocessata tramite normalizzazione dello sfondo, senza sogliatura, viene utilizzata come input per Tesseract OCR, e il testo riconosciuto viene tradotto dall'inglese al portoghese tramite la libreria \emph {deep-translator}.}}{313}{figure.caption.227}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces \emph {Pipeline} di ingestione dei documenti: rasterizzazione adattiva delle pagine PDF in matrici discrete in formato PNG, visualizzando la seconda pagina.}}{316}{figure.caption.228}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Simulatore interattivo di correzione dell'inclinazione (\emph {deskew}): sposta il \emph {cursore} per inclinare il documento e osserva le tre fasi del \emph {pipeline} --- immagine inclinata, bordi Canny e risultato corretto.}}{319}{figure.caption.229}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces \emph {Pipeline} di raddrizzamento assiale: visualizzazione comparativa tra l'input ruotato originale, la mappa dei gradienti strutturali di Canny e il risultato finale allineato con sfondo normalizzato in bianco.}}{319}{figure.caption.230}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Rilevamento dei dischi marcatori, estrazione dei contorni e raddrizzamento tramite trasformazione prospettica.}}{322}{figure.caption.231}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Simulatore interattivo di filtraggio per circolarità: sposta il \emph {cursore} per regolare la soglia C e osserva quali componenti sono accettati (verde) o scartati (rosso).}}{323}{figure.caption.232}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces \emph {Pipeline} di elaborazione del \emph {QRCode}: sogliatura, apertura morfologica, inversione e ritaglio finale per la decodifica.}}{326}{figure.caption.233}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Simulatore interattivo del \emph {pipeline} di isolamento del QRCode: naviga tra le fasi di filtraggio, regola l'elemento strutturante della chiusura morfologica e osserva la rilevazione del contorno quadrato sull'immagine originale del layout.}}{327}{figure.caption.234}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Decodifica di codici a barre lineari con \emph {pyzbar}: immagine di ingresso e dati estratti.}}{329}{figure.caption.235}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Immagine della scheda delle risposte in scala di grigi caricata dal PDF rasterizzato.}}{331}{figure.caption.236}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Area di risposta estratta da \emph {getAnswerArea}: regione rettificata contenente i riquadri di marcatura.}}{332}{figure.caption.237}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Regione del \emph {QRCode} isolata da \emph {segmentQRcode} all'interno dell'area di risposte rettificata.}}{333}{figure.caption.238}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Ritaglio inferiore dell'area delle risposte, concentrandosi sui riquadri delle bolle da segmentare.}}{334}{figure.caption.239}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Risposte lette automaticamente da MCTest dopo la segmentazione e classificazione di tutte le bolle.}}{336}{figure.caption.240}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Rilevamento di difetti per sottrazione di immagine: prodotto di riferimento, immagine con difetto simulato e maschera di anomalia rilevata.}}{338}{figure.caption.241}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Simulatore interattivo di ispezione industriale per sottrazione di immagini: controlla le distorsioni geometriche di disallineamento (registrazione) e la soglia di rilevamento per osservare l'impatto sui falsi positivi.}}{339}{figure.caption.242}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Rilevamento di eterogeneità della texture: mappa di varianza locale e maschera di anomalia.}}{341}{figure.caption.243}%
\contentsline {figure}{\numberline {6.21}{\ignorespaces Simulatore EP06\_01: IoU tra maschera di riferimento e maschera predetta}}{348}{figure.caption.244}%
\contentsline {figure}{\numberline {6.22}{\ignorespaces Simulatore EP06\_02: Filtro di Marcatori per Circolarità}}{350}{figure.caption.245}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Simulatore EP06\_03: Classificazione delle Marcature OMR}}{352}{figure.caption.246}%
\contentsline {figure}{\numberline {6.24}{\ignorespaces Simulatore EP06\_04: Stimatore della Pendenza per Mediana Angolare}}{354}{figure.caption.247}%
\contentsline {figure}{\numberline {6.25}{\ignorespaces Simulatore EP06\_05: Normalizzazione dello sfondo per divisione}}{356}{figure.caption.248}%
\contentsline {figure}{\numberline {6.26}{\ignorespaces Simulatore EP06\_06: Mappa di Varianza Locale per Rilevamento di Texture}}{358}{figure.caption.249}%
\contentsline {figure}{\numberline {6.27}{\ignorespaces Simulatore EP06\_07: \emph {Pipeline} di Ispezione --- Registrazione per Traslazione e Sottrazione}}{360}{figure.caption.250}%
\contentsline {figure}{\numberline {6.28}{\ignorespaces Simulatore EP06\_08: Segmentazione Geometrica + Verifica tramite Decodifica di QRCode}}{364}{figure.caption.251}%
