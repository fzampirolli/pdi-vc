\contentsline {figure}{\numberline {7.22}{\ignorespaces Simulador EP07\_02: Efeito da Normalização \emph {Z-score} na Distância k-NN}}{407}{figure.caption.275}%
\contentsline {figure}{\numberline {7.23}{\ignorespaces Simulador EP07\_03: Precisão x Revocação}}{409}{figure.caption.276}%
