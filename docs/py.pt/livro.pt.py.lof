\contentsline {figure}{\numberline {8.16}{\ignorespaces Simulador EP08\_02: RANSAC --- Votação por Inliers entre Modelos Candidatos}}{459}{figure.caption.298}%
\contentsline {figure}{\numberline {8.17}{\ignorespaces Simulador EP08\_03: Soma Retangular em O(1) --- Múltiplas Situações de Borda}}{462}{figure.caption.299}%
\contentsline {figure}{\numberline {8.18}{\ignorespaces Simulador EP08\_04: IoU e Supressão de Não-Máximos}}{464}{figure.caption.300}%
\contentsline {figure}{\numberline {8.19}{\ignorespaces Simulador EP08\_05: Rotulação de Componentes Conectados --- Conectividade 4 vs.~8}}{466}{figure.caption.301}%
