\contentsline {figure}{\numberline {8.1}{\ignorespaces Visão geral dos principais conceitos abordados neste capítulo, incluindo correspondência de características, detecção de objetos, segmentação de imagens e suas relações com abordagens modernas baseadas em \emph {Deep Learning}. \textbf {Fonte:} elaborado com auxílio do Gemini Notebook (Google, 2025).}}{425}{figure.caption.282}%
\contentsline {figure}{\numberline {8.2}{\ignorespaces Comparação do desempenho de diferentes implementações da distância de Hamming.}}{428}{figure.caption.284}%
\contentsline {figure}{\numberline {8.3}{\ignorespaces Simulador interativo do descritor ORB: explore a lógica de rotação e construção do descritor binário. Altere a rotação para observar como o padrão de amostragem de testes binários do BRIEF (linhas verdes e vermelhas) se orienta dinamicamente para garantir a invariância angular.}}{429}{figure.caption.285}%
\contentsline {figure}{\numberline {8.4}{\ignorespaces Imagem original gerada pelo Gemini e versão rotacionada (20°), simulando uma mudança de ponto de vista.}}{430}{figure.caption.286}%
\contentsline {figure}{\numberline {8.5}{\ignorespaces As 5 melhores correspondências de características ORB entre a imagem original e a cena sintética, antes da filtragem por RANSAC.}}{432}{figure.caption.287}%
\contentsline {figure}{\numberline {8.6}{\ignorespaces Simulador interativo do algoritmo RANSAC: ajuste o limiar de distância e execute o algoritmo para observar a separação entre \emph {inliers} e \emph {outliers}.}}{433}{figure.caption.288}%
\contentsline {figure}{\numberline {8.7}{\ignorespaces Simulador interativo do RANSAC aplicado ao registro de imagens: pontos-chave de duas imagens são casados por um descritor, algumas correspondências são espúrias (\emph {outliers}), e o RANSAC estima a transformação de similaridade que alinha a maioria delas.}}{434}{figure.caption.289}%
\contentsline {figure}{\numberline {8.8}{\ignorespaces Correspondências classificadas como \emph {inliers} (verde) pelo RANSAC ao estimar a homografia entre as duas imagens.}}{435}{figure.caption.290}%
\contentsline {figure}{\numberline {8.9}{\ignorespaces Registro da imagem da cena utilizando a homografia inversa estimada pelo RANSAC.}}{436}{figure.caption.291}%
\contentsline {figure}{\numberline {8.10}{\ignorespaces Detecção de faces e olhos com \emph {Haar Cascade}.}}{439}{figure.caption.292}%
\contentsline {figure}{\numberline {8.11}{\ignorespaces Efeito da Supressão de Não-Máximos (NMS): múltiplas detecções redundantes (esquerda) são reduzidas a uma detecção por objeto (direita).}}{441}{figure.caption.293}%
\contentsline {figure}{\numberline {8.12}{\ignorespaces Segmentação clássica (não baseada em aprendizado profundo): máscara semântica (moeda x fundo) via limiarização de Otsu, e segmentação de instâncias via rotulação de componentes conectados.}}{444}{figure.caption.294}%
\contentsline {figure}{\numberline {8.13}{\ignorespaces Separação de moedas que se tocam via transformada de distância + \emph {watershed}, sem erosão do contorno das moedas.}}{446}{figure.caption.295}%
\contentsline {figure}{\numberline {8.14}{\ignorespaces \emph {Bounding boxes} reconstruídas a partir do arquivo de anotações YOLO exportado por \emph {mm.saveMeasures}, sobrepostas à imagem original das moedas.}}{450}{figure.caption.296}%
