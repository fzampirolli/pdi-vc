\contentsline {figure}{\numberline {5.25}{\ignorespaces Simulador: Normalização de Fundo por Divisão}}{330}{figure.caption.221}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Simulador: Mapa de Variância Local para Detecção de Textura}}{332}{figure.caption.222}%
