\contentsline {figure}{\numberline {7.1}{\ignorespaces Visão geral dos principais conceitos abordados neste capítulo, incluindo correspondência de características, detecção de objetos, segmentação de imagens e suas relações com abordagens modernas baseadas em \emph {Deep Learning}. \textbf {Fonte:} elaborado com auxílio do Gemini Notebook (Google, 2025).}}{363}{figure.caption.234}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Comparação do desempenho de diferentes implementações da distância de Hamming.}}{366}{figure.caption.236}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Simulador interativo do descritor ORB: explore a lógica de rotação e construção do descritor binário. Altere a rotação para observar como o padrão de amostragem de testes binários do BRIEF (linhas verdes e vermelhas) se orienta dinamicamente para garantir a invariância angular.}}{367}{figure.caption.237}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Imagem original gerada pelo Gemini e versão rotacionada (20°), simulando uma mudança de ponto de vista.}}{368}{figure.caption.238}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces As 5 melhores correspondências de características ORB entre a imagem original e a cena sintética, antes da filtragem por RANSAC.}}{370}{figure.caption.239}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Simulador interativo do algoritmo RANSAC: ajuste o limiar de distância e execute o algoritmo para observar a separação entre \emph {inliers} e \emph {outliers}.}}{371}{figure.caption.240}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Simulador interativo do RANSAC aplicado ao registro de imagens: pontos-chave de duas imagens são casados por um descritor, algumas correspondências são espúrias (\emph {outliers}), e o RANSAC estima a transformação de similaridade que alinha a maioria delas.}}{372}{figure.caption.241}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Correspondências classificadas como \emph {inliers} (verde) pelo RANSAC ao estimar a homografia entre as duas imagens.}}{373}{figure.caption.242}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Registro da imagem da cena utilizando a homografia inversa estimada pelo RANSAC.}}{374}{figure.caption.243}%
\contentsline {figure}{\numberline {7.10}{\ignorespaces Detecção de faces e olhos com \emph {Haar Cascade}.}}{377}{figure.caption.244}%
\contentsline {figure}{\numberline {7.11}{\ignorespaces Efeito da Supressão de Não-Máximos (NMS): múltiplas detecções redundantes (esquerda) são reduzidas a uma detecção por objeto (direita).}}{379}{figure.caption.245}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces Segmentação clássica (não baseada em aprendizado profundo): máscara semântica (moeda x fundo) via limiarização de Otsu, e segmentação de instâncias via rotulação de componentes conectados.}}{382}{figure.caption.246}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces Separação de moedas que se tocam via transformada de distância + \emph {watershed}, sem erosão do contorno das moedas.}}{384}{figure.caption.247}%
\contentsline {figure}{\numberline {7.14}{\ignorespaces \emph {Bounding boxes} reconstruídas a partir do arquivo de anotações YOLO exportado por \emph {mm.saveMeasures}, sobrepostas à imagem original das moedas.}}{388}{figure.caption.248}%
\contentsline {figure}{\numberline {7.15}{\ignorespaces Simulador: Distância de Hamming entre Dois Descritores Binários}}{396}{figure.caption.249}%
\contentsline {figure}{\numberline {7.16}{\ignorespaces Simulador: RANSAC --- Votação por Inliers entre Modelos Candidatos}}{398}{figure.caption.250}%
\contentsline {figure}{\numberline {7.17}{\ignorespaces Simulador: Soma Retangular em O(1) --- Múltiplas Situações de Borda}}{400}{figure.caption.251}%
\contentsline {figure}{\numberline {7.18}{\ignorespaces Simulador: IoU e Supressão de Não-Máximos}}{402}{figure.caption.252}%
\contentsline {figure}{\numberline {7.19}{\ignorespaces Simulador: Rotulação de Componentes Conectados --- Conectividade 4 vs.~8}}{405}{figure.caption.253}%
\contentsline {figure}{\numberline {7.20}{\ignorespaces Imagem utilizada no EP08\_06. À esquerda, a imagem original. À direita, a imagem com as \emph {bounding boxes} do arquivo de gabarito.}}{407}{figure.caption.254}%
