\contentsline {figure}{\numberline {6.1}{\ignorespaces Exemplo motivacional: diferentes frutas formando agrupamentos distintos em um espaço de características.}}{302}{figure.caption.206}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Panorama do \emph {pipeline} clássico de classificação de imagens: extração de descritores (LBP, HOG), formação do espaço de características e classificação via k-NN. Não se aplica a modelos de \emph {deep learning} (CNNs, YOLO), que aprendem \emph {features end-to-end} diretamente dos pixels. \textbf {Fonte:} elaborado com auxílio do Gemini Notebook (Google, 2025).}}{303}{figure.caption.207}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Comparação visual de diferentes descritores aplicados à mesma imagem. Cada descritor revela aspectos distintos da cena.}}{305}{figure.caption.208}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Histograma dos códigos LBP da imagem do cameramen. Cada barra representa a frequência relativa de um código LBP, formando o vetor de características utilizado para descrever a textura.}}{306}{figure.caption.209}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Primeiros 100 componentes do vetor de características HOG.}}{308}{figure.caption.210}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Importância da normalização das características para o classificador k-NN.}}{311}{figure.caption.211}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Mapa conceitual do processo de classificação de imagens utilizando descritores clássicos (LBP, HOG, pixels brutos) e classificador tradicional (k-NN). Não se aplica a modelos de \emph {deep learning} (CNNs, YOLO), que aprendem \emph {features end-to-end} diretamente dos pixels.}}{312}{figure.caption.212}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Matrizes de confusão obtidas pelo classificador k-NN utilizando três descritores diferentes. As linhas representam a classe real (Maçã, Banana e Laranja) e as colunas a classe predita. Quanto maior a concentração de valores na diagonal principal, melhor o desempenho do descritor.}}{315}{figure.caption.213}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Comparação detalhada de acurácia global em cenário realista. Observe como os descritores extraídos estruturalmente (LBP e HOG) superam o uso de intensidades puras de pixels brutos.}}{316}{figure.caption.214}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Ilustração do processo de geração de dados sintéticos com \emph {make\_classification}. À esquerda, visualização das três classes em um espaço bidimensional formado por duas características informativas. À direita, importância relativa de cada característica para a classificação, evidenciando que apenas 7 das 10 características são efetivamente discriminativas, enquanto as demais são redundantes (2) ou repetidas (1).}}{319}{figure.caption.215}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Classificação de uma nova amostra pelo algoritmo k-NN. O ponto de teste (estrela) é classificado a partir dos três vizinhos mais próximos, destacados por círculos.}}{322}{figure.caption.216}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Simulador interativo da fronteira de decisão do k-NN: adicione pontos de treinamento e ajuste o valor de k para observar o efeito sobre a região de decisão.}}{323}{figure.caption.217}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Amostra de dígitos manuscritos da base \emph {load\_digits}, utilizada como estudo de caso de classificação.}}{324}{figure.caption.218}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Matriz de confusão do classificador k-NN treinado com vetores de intensidade brutos (pixels).}}{325}{figure.caption.219}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Comparação de acurácia entre descritores de pixels brutos e HOG para o classificador k-NN (k=3) na base de dígitos.}}{326}{figure.caption.220}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Acurácia média por validação cruzada (5 partições) em função do parâmetro k, para a base de dígitos com vetores de intensidade brutos.}}{328}{figure.caption.221}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Acurácia nos conjuntos de treinamento e teste para diferentes valores de \(k\). As regiões coloridas representam, de forma conceitual, tendências de comportamento do classificador: maior risco de sobreajuste (vermelho), compromisso entre viés e variância (verde) e maior risco de subajuste (azul).}}{330}{figure.caption.222}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Amostras sintéticas das três classes de textura utilizadas no experimento de classificação, geradas com ruído gaussiano e variabilidade intra-classe.}}{332}{figure.caption.223}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Acurácia média obtida via validação cruzada (5-fold) para os descritores de Pixels Brutos, LBP e HOG aplicados à base de texturas sintéticas.}}{334}{figure.caption.224}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Métricas de avaliação detalhadas para o classificador k-NN com descritores LBP}}{337}{figure.caption.225}%
\contentsline {figure}{\numberline {6.21}{\ignorespaces Simulador: Classificador k-NN Passo a Passo}}{343}{figure.caption.226}%
\contentsline {figure}{\numberline {6.22}{\ignorespaces Simulador: Efeito da Normalização Z-score na Distância k-NN}}{345}{figure.caption.227}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Simulador: Precisão x Revocação}}{347}{figure.caption.228}%
\contentsline {figure}{\numberline {6.24}{\ignorespaces Simulador: Codigo LBP}}{349}{figure.caption.229}%
\contentsline {figure}{\numberline {6.25}{\ignorespaces Simulador Didático: Histograma HOG de uma Celula (mapeamento de ângulos para bins)}}{352}{figure.caption.230}%
\contentsline {figure}{\numberline {6.26}{\ignorespaces Simulador: Pipeline k-NN Multi-Classe (votacao, desempate e matriz de confusao)}}{355}{figure.caption.231}%
\contentsline {figure}{\numberline {6.27}{\ignorespaces Mosaicos de referência (formato PGM ASCII) utilizados no EP07\_07. Caso 1: grade 2x2 com uma amostra de cada classe. Caso 2: grade 3x3 com classes repetidas e maior variabilidade.}}{360}{figure.caption.232}%
