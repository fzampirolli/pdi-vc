\contentsline {figure}{\numberline {3.30}{\ignorespaces Simulador: Aplicação de Máscara AND Binária}}{146}{figure.caption.117}%
\contentsline {figure}{\numberline {3.31}{\ignorespaces Simulador: Filtro de Média com \emph {Kernel} N×N}}{148}{figure.caption.118}%
