\contentsline {figure}{\numberline {3.33}{\ignorespaces Simulador: Gradiente de Sobel: Gx e Gy}}{178}{figure.caption.119}%
\contentsline {figure}{\numberline {3.34}{\ignorespaces Simulador: Filtro da Mediana 3×3}}{180}{figure.caption.120}%
\contentsline {figure}{\numberline {3.35}{\ignorespaces Simulador: \emph {Unsharp Masking} (USM)}}{182}{figure.caption.121}%
