\contentsline {figure}{\numberline {7.1}{\ignorespaces Exemplo motivacional: diferentes frutas formando agrupamentos distintos em um espaço de características.}}{364}{figure.caption.254}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Panorama do \emph {pipeline} clássico de classificação de imagens: extração de descritores (LBP, HOG), formação do espaço de características e classificação via k-NN. Não se aplica a modelos de \emph {deep learning} (CNNs, YOLO), que aprendem \emph {features end-to-end} diretamente dos pixels. \textbf {Fonte:} elaborado com auxílio do Gemini Notebook (Google, 2025).}}{365}{figure.caption.255}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Comparação visual de diferentes descritores aplicados à mesma imagem. Cada descritor revela aspectos distintos da cena.}}{367}{figure.caption.256}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Histograma dos códigos LBP da imagem do cameramen. Cada barra representa a frequência relativa de um código LBP, formando o vetor de características utilizado para descrever a textura.}}{368}{figure.caption.257}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Primeiros 100 componentes do vetor de características HOG.}}{370}{figure.caption.258}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Importância da normalização das características para o classificador k-NN.}}{373}{figure.caption.259}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Mapa conceitual do processo de classificação de imagens utilizando descritores clássicos (LBP, HOG, pixels brutos) e classificador tradicional (k-NN). Não se aplica a modelos de \emph {deep learning} (CNNs, YOLO), que aprendem \emph {features end-to-end} diretamente dos pixels.}}{374}{figure.caption.260}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Matrizes de confusão obtidas pelo classificador k-NN utilizando três descritores diferentes. As linhas representam a classe real (Maçã, Banana e Laranja) e as colunas a classe predita. Quanto maior a concentração de valores na diagonal principal, melhor o desempenho do descritor.}}{377}{figure.caption.261}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Comparação detalhada de acurácia global em cenário realista. Observe como os descritores extraídos estruturalmente (LBP e HOG) superam o uso de intensidades puras de pixels brutos.}}{378}{figure.caption.262}%
\contentsline {figure}{\numberline {7.10}{\ignorespaces Ilustração do processo de geração de dados sintéticos com \emph {make\_classification}. À esquerda, visualização das três classes em um espaço bidimensional formado por duas características informativas. À direita, importância relativa de cada característica para a classificação, evidenciando que apenas 7 das 10 características são efetivamente discriminativas, enquanto as demais são redundantes (2) ou repetidas (1).}}{381}{figure.caption.263}%
\contentsline {figure}{\numberline {7.11}{\ignorespaces Classificação de uma nova amostra pelo algoritmo k-NN. O ponto de teste (estrela) é classificado a partir dos três vizinhos mais próximos, destacados por círculos.}}{384}{figure.caption.264}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces Simulador interativo da fronteira de decisão do k-NN: adicione pontos de treinamento e ajuste o valor de k para observar o efeito sobre a região de decisão.}}{385}{figure.caption.265}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces Amostra de dígitos manuscritos da base \emph {load\_digits}, utilizada como estudo de caso de classificação.}}{386}{figure.caption.266}%
\contentsline {figure}{\numberline {7.14}{\ignorespaces Matriz de confusão do classificador k-NN treinado com vetores de intensidade brutos (pixels).}}{387}{figure.caption.267}%
\contentsline {figure}{\numberline {7.15}{\ignorespaces Comparação de acurácia entre descritores de pixels brutos e HOG para o classificador k-NN (k=3) na base de dígitos.}}{388}{figure.caption.268}%
\contentsline {figure}{\numberline {7.16}{\ignorespaces Acurácia média por validação cruzada (5 partições) em função do parâmetro k, para a base de dígitos com vetores de intensidade brutos.}}{390}{figure.caption.269}%
\contentsline {figure}{\numberline {7.17}{\ignorespaces Acurácia nos conjuntos de treinamento e teste para diferentes valores de \(k\). As regiões coloridas representam, de forma conceitual, tendências de comportamento do classificador: maior risco de sobreajuste (vermelho), compromisso entre viés e variância (verde) e maior risco de subajuste (azul).}}{392}{figure.caption.270}%
\contentsline {figure}{\numberline {7.18}{\ignorespaces Amostras sintéticas das três classes de textura utilizadas no experimento de classificação, geradas com ruído gaussiano e variabilidade intra-classe.}}{394}{figure.caption.271}%
\contentsline {figure}{\numberline {7.19}{\ignorespaces Acurácia média obtida via validação cruzada (5-fold) para os descritores de Pixels Brutos, LBP e HOG aplicados à base de texturas sintéticas.}}{396}{figure.caption.272}%
\contentsline {figure}{\numberline {7.20}{\ignorespaces Métricas de avaliação detalhadas para o classificador k-NN com descritores LBP}}{399}{figure.caption.273}%
