\contentsline {figure}{\numberline {8.22}{\ignorespaces Simulador EP08\_08: Filtragem de Mediana em Tons de Cinza e Medição de Objetos OpenCV}}{472}{figure.caption.304}%
\contentsline {figure}{\numberline {8.23}{\ignorespaces Simulador EP08\_09: Gradiente de Iluminação, Limiar Adaptativo e Medição OpenCV}}{473}{figure.caption.305}%
