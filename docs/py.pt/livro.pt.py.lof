\contentsline {figure}{\numberline {4.1}{\ignorespaces Decomposição de Fourier 1D: uma onda quadrada (linha tracejada) é aproximada pela soma das primeiras senoides (linhas coloridas). Quanto mais termos, melhor a aproximação.}}{213}{figure.caption.150}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Simulador interativo da decomposição de Fourier 1D: visualização da soma de senoides com diferentes frequências, amplitudes e fases. Adicione termos e observe a convergência para formas de onda arbitrárias.}}{214}{figure.caption.151}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Toda frequência no espectro (ponto isolado) corresponde a uma onda senoidal 2D rotacionada no domínio espacial.}}{216}{figure.caption.152}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Simulador interativo da síntese de Fourier 2D. Altere a posição horizontal (\(u\)) e vertical (\(v\)) do coeficiente no espectro de frequências centrado e observe como a distância em relação ao centro dita a frequência espacial (espessura) e o ângulo dita a orientação da onda senoidal gerada.}}{216}{figure.caption.153}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Diagrama conceitual do espectro de Fourier 2D centrado.}}{218}{figure.caption.156}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Experimento de troca de fase: Imagem A (moedas) e Imagem B (padrão geométrico) reconstruídas com magnitudes e fases trocadas. O resultado mostra que a estrutura visual é \textbf {muito mais sensível à fase} do que à magnitude: quando a fase de B é mantida, a imagem resultante preserva a organização espacial de B, mesmo com a magnitude de A. A magnitude, por sua vez, influencia principalmente o contraste e a textura. Observe que a qualidade da reconstrução não é perfeita --- há artefatos visíveis ---, evidenciando a interdependência entre fase e magnitude para uma representação fiel da imagem.}}{220}{figure.caption.157}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Comparação de eficiência: Convolução Não Separável (Espacial 2D), Separável (Espacial 1D) e via FFT.}}{222}{figure.caption.160}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Sem \emph {padding}, um deslocamento severo faz a imagem vazar para o lado oposto (convolução circular).}}{223}{figure.caption.161}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Verificação do Teorema da Convolução: a diferença pixel a pixel entre a convolução espacial (cv2.filter2D) e a multiplicação em frequência (FFT) é numericamente nula --- confirmando a equivalência teórica.}}{224}{figure.caption.162}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces A Dualidade Perigosa: O corte abrupto na Frequência (Cilindro) transforma-se obrigatoriamente numa Sinc espacial. Suas ondulações causam o \emph {ringing} fantasma nas bordas da imagem.}}{225}{figure.caption.163}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Filtros passa-baixa.}}{226}{figure.caption.168}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Simulador interativo de filtros no domínio da frequência.}}{227}{figure.caption.169}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Comparação entre filtros passa-baixa: Ideal (D₀=30), Gaussiano (D₀=30) e Butterworth (D₀=30, n=2). Perfis de H(u,v) ao longo de uma linha central e imagens filtradas correspondentes.}}{229}{figure.caption.170}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Filtro passa-alta Gaussiano. (a) Original; (b) Filtro passa-alta (D₀=30) - as bordas das moedas e fundo texturizado são realçados.}}{230}{figure.caption.171}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Remoção de ruído periódico via filtro \emph {notch} no domínio da frequência: (a) imagem com ruído senoidal, (b) espectro mostrando os picos do ruído, (c) máscara \emph {notch} centrada nos picos, (d) imagem restaurada.}}{231}{figure.caption.172}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Fourier global é cego para a posição. Os espectros não dizem onde as bordas estão.}}{233}{figure.caption.173}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Funções da \emph {Wavelet} (ψ). Note como elas rapidamente decaem para zero (suporte compacto), ao contrário das senoides infinitas de Fourier.}}{235}{figure.caption.174}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Diagrama da decomposição \emph {wavelet} 2D em dois níveis.}}{235}{figure.caption.175}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Simulação da decomposição \emph {wavelet} 2D.}}{236}{figure.caption.176}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Decomposição \emph {wavelet} 2D de 2 níveis com \emph {wavelet} Haar: subbandas LL, LH, HL, HH em cada nível. As subbandas de detalhe revelam estruturas orientadas em diferentes escalas utilizando um padrão sintético.}}{238}{figure.caption.177}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Comparação entre famílias de \emph {wavelets}: Haar, db4, sym4 e bior2.2. Subbanda LL₁ (aproximação) e HH₁ (diagonal) para cada escolha, ilustrando o compromisso entre compactação e suavidade com base no padrão sintético.}}{240}{figure.caption.178}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Reconstrução \emph {wavelet} com limiarização de coeficientes (\emph {hard thresholding}): à medida que o limiar aumenta, mais detalhes são zerados, produzindo imagens progressivamente mais suaves. Métrica PSNR quantifica a perda de qualidade sobre o padrão sintético.}}{242}{figure.caption.179}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces O Alfabeto Visual do JPEG: As 64 funções de base da DCT-II. O coeficiente DC fica no topo esquerdo (suave). Ao descer e avançar à direita, a oscilação espacial aumenta drasticamente.}}{245}{figure.caption.181}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces DCT 2D em bloco 8×8: coeficientes e reconstrução progressiva.}}{247}{figure.caption.182}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} JPEG simplificado aplicado à imagem clássica do \emph {Cameraman}: DCT em blocos 8×8, quantização com diferentes fatores de qualidade e reconstrução via IDCT. Os artefatos de bloco (\emph {blocking artifacts}) tornam-se visualmente evidentes em fatores de qualidade reduzidos (\(Q=10\) e \(Q=25\)).}}{250}{figure.caption.183}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces Simulador interativo de compressão DCT-JPEG: ajuste o fator de qualidade e visualize em tempo real os coeficientes zerados, o bloco reconstruído e o erro de quantização.}}{251}{figure.caption.184}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Análise comparativa de artefatos de compressão sob fator de qualidade reduzido (\(Q=10\)). À esquerda, observa-se o artefato de bloco característico da discretização por DCT no JPEG. À direita, evidencia-se o efeito de atenuação e suavização de bordas intrínseco ao padrão WebP.}}{253}{figure.caption.187}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Curva taxa-distorção: PSNR vs tamanho de arquivo para JPEG, WebP e PNG aplicada à imagem do \emph {Cameraman}.}}{255}{figure.caption.188}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces Análise espacial de degradação: imagens reconstruídas e respectivos mapas de erro absoluto normalizados para diferentes fatores de qualidade JPEG.}}{257}{figure.caption.189}%
\contentsline {figure}{\numberline {4.30}{\ignorespaces \emph {Pipeline} completo de remoção de ruído misto: (1) adição de ruído gaussiano e periódico; (2) identificação de picos de interferência no espectro de frequências; (3) aplicação de máscara \emph {notch} com atenuação gaussiana suave; (4) pós-processamento via filtro bilateral para eliminação do ruído estocástico residual.}}{261}{figure.caption.190}%
\contentsline {figure}{\numberline {4.31}{\ignorespaces Mapa conceitual das transformações e propriedades no domínio da frequência.}}{262}{figure.caption.191}%
\contentsline {figure}{\numberline {4.32}{\ignorespaces Simulador: Filtro Passa-Baixa Ideal no Espectro}}{267}{figure.caption.192}%
\contentsline {figure}{\numberline {4.33}{\ignorespaces Simulador: Filtro Notch}}{269}{figure.caption.193}%
\contentsline {figure}{\numberline {4.34}{\ignorespaces Simulador: Quantização DCT (round-trip)}}{271}{figure.caption.194}%
\contentsline {figure}{\numberline {4.35}{\ignorespaces Simulador: DFT 2D manual}}{273}{figure.caption.195}%
\contentsline {figure}{\numberline {4.36}{\ignorespaces Simulador: \emph {Pipeline} JPEG completo em bloco}}{275}{figure.caption.196}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Amostra de imagens públicas do \emph {skimage.data}, agrupadas por área de aplicação.}}{281}{figure.caption.197}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces \emph {Pipeline} de ingestão de documentos: rasterização adaptativa de páginas PDF para matrizes discretas em formato PNG, exibindo a página dois.}}{283}{figure.caption.198}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Simulador interativo de correção de inclinação (\emph {deskew}): mova o \emph {slider} para inclinar o documento e observe as três etapas do \emph {pipeline} --- imagem inclinada, bordas Canny e resultado corrigido.}}{286}{figure.caption.199}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces \emph {Pipeline} de retificação axial: exibição comparativa entre a entrada rotacionada original, o mapa de gradientes estruturais de Canny e o resultado final alinhado com fundo normalizado em branco.}}{287}{figure.caption.200}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Comparação entre estratégias de pré-processamento para binarização da imagem de texto: (a) imagem original; (b) limiarização direta pelo método de Otsu; (c) fundo estimado por filtragem Gaussiana; (d) imagem após normalização de fundo (divisão pela imagem suavizada); (e) CLAHE seguido de limiarização por Otsu; e (f) normalização de fundo seguida de limiarização por Otsu. As imagens ilustram o efeito de cada técnica na compensação de variações de iluminação e na qualidade da segmentação.}}{289}{figure.caption.201}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Comparação do texto extraído pelo Tesseract a partir de quatro versões da mesma imagem: (a) imagem original; (b) CLAHE seguido de limiarização por Otsu; (c) normalização de fundo seguida de limiarização por Otsu; e (d) normalização de fundo em tons de cinza, sem limiarização. A comparação evidencia que a binarização externa nem sempre favorece o reconhecimento, uma vez que o Tesseract já realiza sua própria binarização adaptativa internamente.}}{292}{figure.caption.202}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Fluxo de reconhecimento e tradução automática. A imagem pré-processada por normalização de fundo, sem limiarização, é utilizada como entrada para o Tesseract OCR, e o texto reconhecido é traduzido do inglês para o português por meio da biblioteca \emph {deep-translator}.}}{294}{figure.caption.203}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Detecção dos discos marcadores, extração de contornos e retificação por transformação de perspectiva.}}{296}{figure.caption.204}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Simulador interativo de filtragem por circularidade: mova o \emph {slider} para ajustar o limiar C e observe quais componentes são aceitos (verde) ou rejeitados (vermelho).}}{297}{figure.caption.205}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces \emph {Pipeline} de processamento do \emph {QRCode}: limiarização, abertura morfológica, inversão e recorte final para decodificação.}}{300}{figure.caption.206}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Simulador interativo do \emph {pipeline} de isolamento do QRCode: navegue pelas etapas de filtragem, ajuste o elemento estruturante do fechamento morfológica e veja a detecção do contorno quadrado sobre a imagem original do gabarito.}}{300}{figure.caption.207}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Decodificação de código de barras linear com \emph {pyzbar}: imagem de entrada e dados extraídos.}}{302}{figure.caption.208}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Imagem da folha de respostas em escala de cinza carregada a partir do PDF rasterizado.}}{305}{figure.caption.209}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Área de respostas extraída por \emph {getAnswerArea}: região retificada contendo os quadros de marcação.}}{306}{figure.caption.210}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Região do \emph {QRCode} isolada por \emph {segmentQRcode} dentro da área de respostas retificada.}}{307}{figure.caption.211}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Recorte inferior da área de respostas, concentrando os quadros de bolhas a serem segmentados.}}{308}{figure.caption.212}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Respostas lidas automaticamente pelo MCTest após segmentação e classificação de todas as bolhas.}}{310}{figure.caption.213}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Detecção de defeito por subtração de imagem: produto de referência, imagem com defeito simulado e máscara de anomalia detectada.}}{312}{figure.caption.214}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Simulador interativo de inspeção industrial por subtração de imagens: controle as distorções geométricas de desalinhamento (registro) e o limiar de detecção para observar o impacto nos falsos positivos.}}{313}{figure.caption.215}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Detecção de heterogeneidade de textura: mapa de variância local e máscara de anomalia.}}{315}{figure.caption.216}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Simulador: IoU entre máscara de referência e máscara predita}}{322}{figure.caption.217}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Simulador: Filtro de Marcadores por Circularidade}}{324}{figure.caption.218}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces Simulador: Classificação de Marcações OMR}}{326}{figure.caption.219}%
