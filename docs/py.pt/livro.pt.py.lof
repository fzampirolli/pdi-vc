\contentsline {figure}{\numberline {4.1}{\ignorespaces Imagem com moedas de vários tipos. Crédito: GAZI.MD.AHAD (CC BY-SA 4.0).}}{185}{figure.caption.124}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Comparação dos pré-processamentos: imagem \textbar {} histograma+T* \textbar {} σ²B(T) \textbar {} Otsu. A melhor separação bimodal indica o limiar mais confiável.}}{188}{figure.caption.125}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Elemento estruturante em formato de cruz (\(B_{\text {cruz}}\)) utilizado para conectividade-4.}}{190}{figure.caption.127}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Erosão e dilatação em imagem binária 10×10 com elemento estruturante `L' assimétrico 3×3. Validação da dualidade erosão--dilatação.}}{196}{figure.caption.129}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Simulador interativo de erosão morfológica: visualização do critério de inclusão do elemento estruturante assimétrico \(B_L\) sobre a imagem binária \(A\).}}{197}{figure.caption.130}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Abertura, fechamento, composição e filtro sequencial alternado aplicados à binarização Otsu das moedas com CLAHE. Elemento estruturante: disco 13×13.}}{199}{figure.caption.133}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Simulador interativo de dilatação geodésica: o marcador \(f\) (verde) propaga-se passo a passo pelos caminhos livres da máscara \(g\), sem atravessar paredes --- ilustrando como \( delta_g^{(n)}(f)\) encontra a saída do labirinto.}}{200}{figure.caption.135}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Resolução de labirinto via Operações Complementares: Invertendo a máscara e o marcador no início do \emph {pipeline}, o fluxo é resolvido diretamente no domínio complementar através de mm.cero e mm.suprec, eliminando re-inversões redundantes.}}{203}{figure.caption.137}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \emph {Pipeline} de Reconstrução Morfológica por Dilatação Condicionada: a máscara contém dois objetos, o marcador isola apenas o núcleo do objeto principal, e as iterações subsequentes em laço reconstroem sua forma exata até a convergência.}}{205}{figure.caption.139}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \emph {Pipeline} de preenchimento de buracos (\emph {clohole}): o marcador é obtido a partir da borda da imagem e restringido ao complemento \(f^c\). As iterações de dilatação geodésica reconstruem o fundo externo; após a complementação final, os buracos internos ficam preenchidos.}}{207}{figure.caption.142}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \emph {Pipeline} de eliminação de estruturas de borda (\emph {edgeoff}): o marcador captura as raízes conectadas às extremidades da matriz, a reconstrução delimita a extensão desses elementos e a subtração booleana preserva unicamente os objetos totalmente internos.}}{208}{figure.caption.143}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces \emph {Pipeline} completo de segmentação com CLAHE: Otsu → abertura (r=9) → clohole → abertura (r=33) → edgeoff.}}{209}{figure.caption.144}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Simulador interativo avançado de morfologia com elemento estruturante editável e perfil 1D.}}{210}{figure.caption.148}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Morfologia em tons de cinza e seus respectivos histogramas. A erosão reduz intensidades locais, a dilatação as amplia, o gradiente destaca bordas, e os operadores Top-hat e Black-hat evidenciam detalhes locais brilhantes e escuros. Elemento estruturante: disco de diâmetro 19.}}{212}{figure.caption.149}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Algoritmo de rotulação por \emph {flood-fill} com pilha: passo a passo, cards, linha do tempo, código Python e fluxograma.}}{214}{figure.caption.151}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Simulador interativo de rotulação de componentes conexas (\emph {connected component labeling}): visualização da expansão flood-fill, conectividade-4 e conectividade-8.}}{215}{figure.caption.152}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Efeito da conectividade na rotulação: a imagem binária 10×10 contém pixels diagonalmente adjacentes. Com conectividade-4, esses pixels formam componentes distintas; com conectividade-8, fundem-se em uma única componente.}}{216}{figure.caption.153}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Algoritmo da Transformada de Distância: passo a passo, cards, linha do tempo, código Python e fluxograma.}}{218}{figure.caption.154}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Simulador interativo da Transformada de Distância (TD) iterativa via erosão em tons de cinza. Pixels fora da imagem agora assumem o valor máximo (144), propagando os custos apenas a partir do fundo interno.}}{219}{figure.caption.155}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Transformada de Distância em imagem binária 10×10. Esquerda: imagem original (\emph {foreground} = 255). Centro: mm.dist1 iterativa (erosões com elemento cruz). Direita: mm.dist (L2 Euclidiana).}}{220}{figure.caption.156}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Simulador interativo 2D (4x4) com sincronização estrita de filas de propagação horizontal (b) para obter a convergência exata descrita no artigo.}}{221}{figure.caption.157}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Menor caminho geodésico em um labirinto. As distâncias geodésicas são calculadas a partir da entrada e da saída usando mm.gdist. Os pixels cujo somatório das duas distâncias é igual à distância mínima entre os marcadores pertencem a um caminho ótimo.}}{222}{figure.caption.158}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Algoritmo Didático de \emph {Watershed} por Crescimento de Regiões Limitado por Máscara: passo a passo, cards, linha do tempo, código Python e fluxograma.}}{224}{figure.caption.159}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Simulador interativo do Algoritmo \emph {Watershed} por propagação morfológica. Desenhe a máscara, posicione os marcadores e ajuste o Elemento Estruturante para observar a inundação. Quando as bacias se encontram simultaneamente, o empate é resolvido assumindo uma das regiões de forma aleatória.}}{225}{figure.caption.160}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} \emph {watershed} delimitado por máscara em imagem binária 20×20.}}{226}{figure.caption.161}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces \emph {Pipeline} \emph {Watershed} para separação de moedas sobrepostas: da máscara binária dilatada até os contornos finais anotados sobre a imagem original.}}{228}{figure.caption.162}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Componentes conexos extraídos após o \emph {pipeline} CLAHE → Otsu → limpeza morfológica. Cada objeto é colorido com cor distinta e anotado com sua área em pixels.}}{230}{figure.caption.163}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Contornos extraídos com \emph {findContours}. Cada moeda é anotada com sua circularidade --- valores próximos de 1 confirmam forma circular.}}{232}{figure.caption.164}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces \emph {Bounding boxes} derivadas dos componentes conexos sobrepostas à imagem original. As anotações são exportadas no formato YOLO (\emph {classe cx cy w h}), com coordenadas normalizadas para o intervalo {[}0,1{]}.}}{233}{figure.caption.165}%
\contentsline {figure}{\numberline {4.30}{\ignorespaces Simulador: Limiarização Global por Limiar Fixo}}{239}{figure.caption.167}%
\contentsline {figure}{\numberline {4.31}{\ignorespaces Simulador: Limiarização Automática de Otsu}}{241}{figure.caption.168}%
\contentsline {figure}{\numberline {4.32}{\ignorespaces Simulador: Dilatação Binária Plana (mm.dil0)}}{244}{figure.caption.169}%
\contentsline {figure}{\numberline {4.33}{\ignorespaces Simulador: Erosão Binária Plana (mm.ero0)}}{246}{figure.caption.170}%
\contentsline {figure}{\numberline {4.34}{\ignorespaces Simulador: Abertura Morfológica (erosão + dilatação)}}{248}{figure.caption.171}%
\contentsline {figure}{\numberline {4.35}{\ignorespaces Simulador: Fechamento Morfológico (dilatação + erosão)}}{250}{figure.caption.172}%
\contentsline {figure}{\numberline {4.36}{\ignorespaces Simulador: Dilatação e Erosão com Pesos (mm.dil1 / mm.ero1)}}{252}{figure.caption.173}%
\contentsline {figure}{\numberline {4.37}{\ignorespaces Simulador: Gradiente Morfológico, Top-hat e Black-hat}}{254}{figure.caption.174}%
\contentsline {figure}{\numberline {4.38}{\ignorespaces Simulador: Transformada de Distância}}{257}{figure.caption.175}%
\contentsline {figure}{\numberline {4.39}{\ignorespaces Simulador: Separação de Blobs, Rotulação e Descritores}}{259}{figure.caption.176}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Decomposição de Fourier 1D: uma onda quadrada (linha tracejada) é aproximada pela soma das primeiras senoides (linhas coloridas). Quanto mais termos, melhor a aproximação.}}{261}{figure.caption.177}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Simulador interativo da decomposição de Fourier 1D: visualização da soma de senoides com diferentes frequências, amplitudes e fases. Adicione termos e observe a convergência para formas de onda arbitrárias.}}{263}{figure.caption.178}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Toda frequência no espectro (ponto isolado) corresponde a uma onda senoidal 2D rotacionada no domínio espacial.}}{264}{figure.caption.179}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Simulador interativo da síntese de Fourier 2D. Altere a posição horizontal (\(u\)) e vertical (\(v\)) do coeficiente no espectro de frequências centrado e observe como a distância em relação ao centro dita a frequência espacial (espessura) e o ângulo dita a orientação da onda senoidal gerada.}}{265}{figure.caption.180}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Diagrama conceitual do espectro de Fourier 2D centrado.}}{266}{figure.caption.183}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Experimento de troca de fase: Imagem A (moedas) e Imagem B (padrão geométrico) reconstruídas com magnitudes e fases trocadas. O resultado mostra que a estrutura visual é \textbf {muito mais sensível à fase} do que à magnitude: quando a fase de B é mantida, a imagem resultante preserva a organização espacial de B, mesmo com a magnitude de A. A magnitude, por sua vez, influencia principalmente o contraste e a textura. Observe que a qualidade da reconstrução não é perfeita --- há artefatos visíveis ---, evidenciando a interdependência entre fase e magnitude para uma representação fiel da imagem.}}{269}{figure.caption.184}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Comparação de eficiência: Convolução Não Separável (Espacial 2D), Separável (Espacial 1D) e via FFT.}}{271}{figure.caption.187}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Sem \emph {padding}, um deslocamento severo faz a imagem vazar para o lado oposto (convolução circular).}}{272}{figure.caption.188}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Verificação do Teorema da Convolução: a diferença pixel a pixel entre a convolução espacial (cv2.filter2D) e a multiplicação em frequência (FFT) é numericamente nula --- confirmando a equivalência teórica.}}{273}{figure.caption.189}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces A Dualidade Perigosa: O corte abrupto na Frequência (Cilindro) transforma-se obrigatoriamente numa Sinc espacial. Suas ondulações causam o \emph {ringing} fantasma nas bordas da imagem.}}{274}{figure.caption.190}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Filtros passa-baixa.}}{275}{figure.caption.195}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Simulador interativo de filtros no domínio da frequência.}}{276}{figure.caption.196}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Comparação entre filtros passa-baixa: Ideal (D₀=30), Gaussiano (D₀=30) e Butterworth (D₀=30, n=2). Perfis de H(u,v) ao longo de uma linha central e imagens filtradas correspondentes.}}{278}{figure.caption.197}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Filtro passa-alta Gaussiano. (a) Original; (b) Filtro passa-alta (D₀=30) - as bordas das moedas e fundo texturizado são realçados.}}{279}{figure.caption.198}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Remoção de ruído periódico via filtro \emph {notch} no domínio da frequência: (a) imagem com ruído senoidal, (b) espectro mostrando os picos do ruído, (c) máscara \emph {notch} centrada nos picos, (d) imagem restaurada.}}{280}{figure.caption.199}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Fourier global é cego para a posição. Os espectros não dizem onde as bordas estão.}}{282}{figure.caption.200}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Funções da \emph {Wavelet} (ψ). Note como elas rapidamente decaem para zero (suporte compacto), ao contrário das senoides infinitas de Fourier.}}{284}{figure.caption.201}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Diagrama da decomposição \emph {wavelet} 2D em dois níveis.}}{284}{figure.caption.202}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Simulação da decomposição \emph {wavelet} 2D.}}{285}{figure.caption.203}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Decomposição \emph {wavelet} 2D de 2 níveis com \emph {wavelet} Haar: subbandas LL, LH, HL, HH em cada nível. As subbandas de detalhe revelam estruturas orientadas em diferentes escalas utilizando um padrão sintético.}}{287}{figure.caption.204}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Comparação entre famílias de \emph {wavelets}: Haar, db4, sym4 e bior2.2. Subbanda LL₁ (aproximação) e HH₁ (diagonal) para cada escolha, ilustrando o compromisso entre compactação e suavidade com base no padrão sintético.}}{289}{figure.caption.205}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Reconstrução \emph {wavelet} com limiarização de coeficientes (\emph {hard thresholding}): à medida que o limiar aumenta, mais detalhes são zerados, produzindo imagens progressivamente mais suaves. Métrica PSNR quantifica a perda de qualidade sobre o padrão sintético.}}{291}{figure.caption.206}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces O Alfabeto Visual do JPEG: As 64 funções de base da DCT-II. O coeficiente DC fica no topo esquerdo (suave). Ao descer e avançar à direita, a oscilação espacial aumenta drasticamente.}}{294}{figure.caption.208}%
\contentsline {figure}{\numberline {5.24}{\ignorespaces DCT 2D em bloco 8×8: coeficientes e reconstrução progressiva.}}{296}{figure.caption.209}%
\contentsline {figure}{\numberline {5.25}{\ignorespaces \emph {Pipeline} JPEG simplificado aplicado à imagem clássica do \emph {Cameraman}: DCT em blocos 8×8, quantização com diferentes fatores de qualidade e reconstrução via IDCT. Os artefatos de bloco (\emph {blocking artifacts}) tornam-se visualmente evidentes em fatores de qualidade reduzidos (\(Q=10\) e \(Q=25\)).}}{299}{figure.caption.210}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Simulador interativo de compressão DCT-JPEG: ajuste o fator de qualidade e visualize em tempo real os coeficientes zerados, o bloco reconstruído e o erro de quantização.}}{300}{figure.caption.211}%
\contentsline {figure}{\numberline {5.27}{\ignorespaces Análise comparativa de artefatos de compressão sob fator de qualidade reduzido (\(Q=10\)). À esquerda, observa-se o artefato de bloco característico da discretização por DCT no JPEG. À direita, evidencia-se o efeito de atenuação e suavização de bordas intrínseco ao padrão WebP.}}{302}{figure.caption.214}%
\contentsline {figure}{\numberline {5.28}{\ignorespaces Curva taxa-distorção: PSNR vs tamanho de arquivo para JPEG, WebP e PNG aplicada à imagem do \emph {Cameraman}.}}{304}{figure.caption.215}%
\contentsline {figure}{\numberline {5.29}{\ignorespaces Análise espacial de degradação: imagens reconstruídas e respectivos mapas de erro absoluto normalizados para diferentes fatores de qualidade JPEG.}}{306}{figure.caption.216}%
\contentsline {figure}{\numberline {5.30}{\ignorespaces \emph {Pipeline} completo de remoção de ruído misto: (1) adição de ruído gaussiano e periódico; (2) identificação de picos de interferência no espectro de frequências; (3) aplicação de máscara \emph {notch} com atenuação gaussiana suave; (4) pós-processamento via filtro bilateral para eliminação do ruído estocástico residual.}}{310}{figure.caption.217}%
\contentsline {figure}{\numberline {5.31}{\ignorespaces Mapa conceitual das transformações e propriedades no domínio da frequência.}}{311}{figure.caption.218}%
\contentsline {figure}{\numberline {5.32}{\ignorespaces Simulador: Filtro Passa-Baixa Ideal no Espectro}}{317}{figure.caption.219}%
\contentsline {figure}{\numberline {5.33}{\ignorespaces Simulador: Filtro Notch}}{319}{figure.caption.220}%
\contentsline {figure}{\numberline {5.34}{\ignorespaces Simulador: Quantização DCT (round-trip)}}{321}{figure.caption.221}%
\contentsline {figure}{\numberline {5.35}{\ignorespaces Simulador: DFT 2D manual}}{322}{figure.caption.222}%
\contentsline {figure}{\numberline {5.36}{\ignorespaces Simulador: \emph {Pipeline} JPEG completo em bloco}}{325}{figure.caption.223}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Amostra de imagens públicas do \emph {skimage.data}, agrupadas por área de aplicação.}}{331}{figure.caption.224}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Comparação entre estratégias de pré-processamento para binarização da imagem de texto: (a) imagem original; (b) limiarização direta pelo método de Otsu; (c) fundo estimado por filtragem Gaussiana; (d) imagem após normalização de fundo (divisão pela imagem suavizada); (e) CLAHE seguido de limiarização por Otsu; e (f) normalização de fundo seguida de limiarização por Otsu. As imagens ilustram o efeito de cada técnica na compensação de variações de iluminação e na qualidade da segmentação.}}{333}{figure.caption.225}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Comparação do texto extraído pelo Tesseract a partir de quatro versões da mesma imagem: (a) imagem original; (b) CLAHE seguido de limiarização por Otsu; (c) normalização de fundo seguida de limiarização por Otsu; e (d) normalização de fundo em tons de cinza, sem limiarização. A comparação evidencia que a binarização externa nem sempre favorece o reconhecimento, uma vez que o Tesseract já realiza sua própria binarização adaptativa internamente.}}{336}{figure.caption.226}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Fluxo de reconhecimento e tradução automática. A imagem pré-processada por normalização de fundo, sem limiarização, é utilizada como entrada para o Tesseract OCR, e o texto reconhecido é traduzido do inglês para o português por meio da biblioteca \emph {deep-translator}.}}{337}{figure.caption.227}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces \emph {Pipeline} de ingestão de documentos: rasterização adaptativa de páginas PDF para matrizes discretas em formato PNG, exibindo a página dois.}}{340}{figure.caption.228}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Simulador interativo de correção de inclinação (\emph {deskew}): mova o \emph {slider} para inclinar o documento e observe as três etapas do \emph {pipeline} --- imagem inclinada, bordas Canny e resultado corrigido.}}{343}{figure.caption.229}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces \emph {Pipeline} de retificação axial: exibição comparativa entre a entrada rotacionada original, o mapa de gradientes estruturais de Canny e o resultado final alinhado com fundo normalizado em branco.}}{344}{figure.caption.230}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Detecção dos discos marcadores, extração de contornos e retificação por transformação de perspectiva.}}{347}{figure.caption.231}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Simulador interativo de filtragem por circularidade: mova o \emph {slider} para ajustar o limiar C e observe quais componentes são aceitos (verde) ou rejeitados (vermelho).}}{348}{figure.caption.232}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces \emph {Pipeline} de processamento do \emph {QRCode}: limiarização, abertura morfológica, inversão e recorte final para decodificação.}}{350}{figure.caption.233}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Simulador interativo do \emph {pipeline} de isolamento do QRCode: navegue pelas etapas de filtragem, ajuste o elemento estruturante do fechamento morfológica e veja a detecção do contorno quadrado sobre a imagem original do gabarito.}}{351}{figure.caption.234}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Decodificação de código de barras linear com \emph {pyzbar}: imagem de entrada e dados extraídos.}}{353}{figure.caption.235}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Imagem da folha de respostas em escala de cinza carregada a partir do PDF rasterizado.}}{355}{figure.caption.236}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Área de respostas extraída por \emph {getAnswerArea}: região retificada contendo os quadros de marcação.}}{356}{figure.caption.237}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Região do \emph {QRCode} isolada por \emph {segmentQRcode} dentro da área de respostas retificada.}}{357}{figure.caption.238}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Recorte inferior da área de respostas, concentrando os quadros de bolhas a serem segmentados.}}{358}{figure.caption.239}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Respostas lidas automaticamente pelo MCTest após segmentação e classificação de todas as bolhas.}}{360}{figure.caption.240}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Detecção de defeito por subtração de imagem: produto de referência, imagem com defeito simulado e máscara de anomalia detectada.}}{362}{figure.caption.241}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Simulador interativo de inspeção industrial por subtração de imagens: controle as distorções geométricas de desalinhamento (registro) e o limiar de detecção para observar o impacto nos falsos positivos.}}{363}{figure.caption.242}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Detecção de heterogeneidade de textura: mapa de variância local e máscara de anomalia.}}{365}{figure.caption.243}%
\contentsline {figure}{\numberline {6.21}{\ignorespaces Simulador: IoU entre máscara de referência e máscara predita}}{372}{figure.caption.244}%
\contentsline {figure}{\numberline {6.22}{\ignorespaces Simulador: Filtro de Marcadores por Circularidade}}{374}{figure.caption.245}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Simulador: Classificação de Marcações OMR}}{376}{figure.caption.246}%
\contentsline {figure}{\numberline {6.24}{\ignorespaces Simulador: Estimador de Inclinação por Mediana Angular}}{378}{figure.caption.247}%
\contentsline {figure}{\numberline {6.25}{\ignorespaces Simulador: Normalização de Fundo por Divisão}}{380}{figure.caption.248}%
\contentsline {figure}{\numberline {6.26}{\ignorespaces Simulador: Mapa de Variância Local para Detecção de Textura}}{382}{figure.caption.249}%
\contentsline {figure}{\numberline {6.27}{\ignorespaces Simulador: \emph {Pipeline} de Inspeção --- Registro por Translação e Subtração}}{385}{figure.caption.250}%
\contentsline {figure}{\numberline {6.28}{\ignorespaces Simulador: Segmentação Geométrica + Verificação por Decodificação de QRCode}}{388}{figure.caption.251}%
