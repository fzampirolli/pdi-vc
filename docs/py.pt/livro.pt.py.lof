\contentsline {figure}{\numberline {5.1}{\ignorespaces Amostra de imagens públicas do \emph {skimage.data}, agrupadas por área de aplicação.}}{241}{figure.caption.178}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Comparação entre estratégias de pré-processamento para binarização da imagem de texto: (a) imagem original; (b) limiarização direta pelo método de Otsu; (c) fundo estimado por filtragem Gaussiana; (d) imagem após normalização de fundo (divisão pela imagem suavizada); (e) CLAHE seguido de limiarização por Otsu; e (f) normalização de fundo seguida de limiarização por Otsu. As imagens ilustram o efeito de cada técnica na compensação de variações de iluminação e na qualidade da segmentação.}}{243}{figure.caption.179}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Comparação do texto extraído pelo Tesseract a partir de quatro versões da mesma imagem: (a) imagem original; (b) CLAHE seguido de limiarização por Otsu; (c) normalização de fundo seguida de limiarização por Otsu; e (d) normalização de fundo em tons de cinza, sem limiarização. A comparação evidencia que a binarização externa nem sempre favorece o reconhecimento, uma vez que o Tesseract já realiza sua própria binarização adaptativa internamente.}}{246}{figure.caption.180}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Fluxo de reconhecimento e tradução automática. A imagem pré-processada por normalização de fundo, sem limiarização, é utilizada como entrada para o Tesseract OCR, e o texto reconhecido é traduzido do inglês para o português por meio da biblioteca \emph {deep-translator}.}}{247}{figure.caption.181}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces \emph {Pipeline} de ingestão de documentos: rasterização adaptativa de páginas PDF para matrizes discretas em formato PNG, exibindo a página dois.}}{250}{figure.caption.182}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Simulador interativo de correção de inclinação (\emph {deskew}): mova o \emph {slider} para inclinar o documento e observe as três etapas do \emph {pipeline} --- imagem inclinada, bordas Canny e resultado corrigido.}}{253}{figure.caption.183}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces \emph {Pipeline} de retificação axial: exibição comparativa entre a entrada rotacionada original, o mapa de gradientes estruturais de Canny e o resultado final alinhado com fundo normalizado em branco.}}{254}{figure.caption.184}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Detecção dos discos marcadores, extração de contornos e retificação por transformação de perspectiva.}}{257}{figure.caption.185}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Simulador interativo de filtragem por circularidade: mova o \emph {slider} para ajustar o limiar C e observe quais componentes são aceitos (verde) ou rejeitados (vermelho).}}{258}{figure.caption.186}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces \emph {Pipeline} de processamento do \emph {QRCode}: limiarização, abertura morfológica, inversão e recorte final para decodificação.}}{260}{figure.caption.187}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Simulador interativo do \emph {pipeline} de isolamento do QRCode: navegue pelas etapas de filtragem, ajuste o elemento estruturante do fechamento morfológica e veja a detecção do contorno quadrado sobre a imagem original do gabarito.}}{261}{figure.caption.188}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Decodificação de código de barras linear com \emph {pyzbar}: imagem de entrada e dados extraídos.}}{263}{figure.caption.189}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Imagem da folha de respostas em escala de cinza carregada a partir do PDF rasterizado.}}{265}{figure.caption.190}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Área de respostas extraída por \emph {getAnswerArea}: região retificada contendo os quadros de marcação.}}{266}{figure.caption.191}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Região do \emph {QRCode} isolada por \emph {segmentQRcode} dentro da área de respostas retificada.}}{267}{figure.caption.192}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Recorte inferior da área de respostas, concentrando os quadros de bolhas a serem segmentados.}}{268}{figure.caption.193}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Respostas lidas automaticamente pelo MCTest após segmentação e classificação de todas as bolhas.}}{270}{figure.caption.194}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Detecção de defeito por subtração de imagem: produto de referência, imagem com defeito simulado e máscara de anomalia detectada.}}{272}{figure.caption.195}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Simulador interativo de inspeção industrial por subtração de imagens: controle as distorções geométricas de desalinhamento (registro) e o limiar de detecção para observar o impacto nos falsos positivos.}}{273}{figure.caption.196}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Detecção de heterogeneidade de textura: mapa de variância local e máscara de anomalia.}}{275}{figure.caption.197}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Simulador: IoU entre máscara de referência e máscara predita}}{282}{figure.caption.198}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Simulador: Filtro de Marcadores por Circularidade}}{284}{figure.caption.199}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces Simulador: Classificação de Marcações OMR}}{286}{figure.caption.200}%
\contentsline {figure}{\numberline {5.24}{\ignorespaces Simulador: Estimador de Inclinação por Mediana Angular}}{288}{figure.caption.201}%
\contentsline {figure}{\numberline {5.25}{\ignorespaces Simulador: Normalização de Fundo por Divisão}}{290}{figure.caption.202}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Simulador: Mapa de Variância Local para Detecção de Textura}}{292}{figure.caption.203}%
\contentsline {figure}{\numberline {5.27}{\ignorespaces Simulador: \emph {Pipeline} de Inspeção --- Registro por Translação e Subtração}}{295}{figure.caption.204}%
