\contentsline {figure}{\numberline {1.1}{\ignorespaces Comparativo didático entre o sistema visual biológico e o eletrônico: no topo, a anatomia do olho humano destacando a retina e os fotorreceptores (cones e bastonetes); abaixo, a estrutura de uma câmera digital detalhando o sensor CMOS, a matriz de filtros de Bayer (RGGB) e o processo de quantização digital realizado pelo ADC.}}{25}{figure.caption.6}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Coletânea de desafios perceptivos: (topo esquerdo) Vaso de Rubin --- ambiguidade figura-fundo; (topo central) Elefante de Shepard --- incongruência geométrica; (topo direita) Sombra de Adelson --- constância de brilho baseada no contexto; (inferior esquerdo) Grade de pontos --- inibição lateral; (inferior direito) Escada de Schröder.}}{26}{figure.caption.7}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Imagem RGB (3 canais, \(M \times N \times 3\)) e versão RGBA (4 canais, \(M \times N \times 4\)) com transparência alfa gradual da esquerda para a direita. Imagem Mandrill --- \href {https://sipi.usc.edu/database/database.php?volume=misc}{USC SIPI Image Database} (domínio público).}}{30}{figure.caption.9}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Efeito da subamostragem. Os títulos exibem as dimensões (W x H) e o tamanho da matriz em memória (KB).}}{32}{figure.caption.10}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Efeito da redução da profundidade de bits. Os títulos exibem a quantidade de bits, níveis e o tamanho em memória (KB).}}{33}{figure.caption.11}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Ilustração de vizinhanças 4 em uma matriz 3x3. No centro (1,1), o pixel de interesse.}}{34}{figure.caption.12}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Area de Proteção Ambiental Quilombos do Médio Ribeira - Barbudo-rajado (Malacoptila striata). Crédito: Thomas Fuhrmann (CC BY-SA 4.0).}}{37}{figure.caption.13}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Exemplo de translação da imagem do pássaro com deslocamentos (50,50) e (100,50).}}{39}{figure.caption.16}%
\contentsline {figure}{\numberline {1.9}{\ignorespaces Exemplo de rotação da imagem do pássaro em 30° e 45° usando interpolação bilinear.}}{40}{figure.caption.18}%
\contentsline {figure}{\numberline {1.10}{\ignorespaces Comparação de interpolação com zoom no detalhe do olho (recorte 60×60, ampliado 4×). Note o efeito de blocos no vizinho mais próximo vs.~a suavização na bilinear.}}{42}{figure.caption.20}%
\contentsline {figure}{\numberline {1.11}{\ignorespaces Exemplo de cisalhamento da imagem do pássaro: horizontal (shx=0.3), vertical (shy=0.3) e combinado (shx=0.2, shy=0.2).}}{43}{figure.caption.22}%
