\contentsline {figure}{\numberline {4.38}{\ignorespaces Simulador: Transformada de Distância}}{233}{figure.caption.176}%
\contentsline {figure}{\numberline {4.39}{\ignorespaces Simulador: Separação de Blobs, Rotulação e Descritores}}{235}{figure.caption.177}%
