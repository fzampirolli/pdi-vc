\contentsline {figure}{\numberline {3.33}{\ignorespaces Simulador: Gradiente de Sobel: Gx e Gy}}{153}{figure.caption.120}%
\contentsline {figure}{\numberline {3.34}{\ignorespaces Simulador: Filtro da Mediana 3×3}}{155}{figure.caption.121}%
\contentsline {figure}{\numberline {3.35}{\ignorespaces Simulador: \emph {Unsharp Masking} (USM)}}{158}{figure.caption.122}%
