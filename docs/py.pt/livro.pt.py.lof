\contentsline {figure}{\numberline {3.30}{\ignorespaces Simulador: Aplicação de Máscara AND Binária}}{171}{figure.caption.116}%
\contentsline {figure}{\numberline {3.31}{\ignorespaces Simulador: Filtro de Média com \emph {Kernel} N×N}}{173}{figure.caption.117}%
