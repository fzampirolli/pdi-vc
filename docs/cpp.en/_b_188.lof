\babel@toc {english}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces Decomposição de Fourier 1D: uma onda quadrada (linha tracejada) é aproximada pela soma das primeiras senoides (linhas coloridas). Quanto mais termos, melhor a aproximação.}}{ix}{figure.caption.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Interactive simulator of 1D Fourier decomposition: visualization of the sum of sinusoids with different frequencies, amplitudes and phases. Add terms and observe convergence to arbitrary waveforms.}}{x}{figure.caption.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Toda frequência no espectro (ponto isolado) corresponde a uma onda senoidal 2D rotacionada no domínio espacial.}}{xiii}{figure.caption.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Interactive simulator of 2D Fourier synthesis. Change the horizontal (\(u\)) and vertical (\(v\)) position of the coefficient in the centered frequency spectrum and observe how the distance from the center dictates the spatial frequency (thickness) and the angle dictates the orientation of the generated sine wave.}}{xiv}{figure.caption.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Conceptual diagram of the centered 2D Fourier spectrum.}}{xvi}{figure.caption.7}%
\contentsline {figure}{\numberline {6}{\ignorespaces Experimento de troca de fase: Imagem A (moedas) e Imagem B (padrão geométrico) reconstruídas com magnitudes e fases trocadas. O resultado mostra que a estrutura visual é \textbf {muito mais sensível à fase} do que à magnitude: quando a fase de B é mantida, a imagem resultante preserva a organização espacial de B, mesmo com a magnitude de A. A magnitude, por sua vez, influencia principalmente o contraste e a textura. Observe que a qualidade da reconstrução não é perfeita --- há artefatos visíveis ---, evidenciando a interdependência entre fase e magnitude para uma representação fiel da imagem.}}{xxi}{figure.caption.8}%
\contentsline {figure}{\numberline {7}{\ignorespaces Efficiency comparison: Non-separable Convolution (Spatial 2D), Separable (Spatial 1D), and via FFT.}}{xxiii}{figure.caption.11}%
\contentsline {figure}{\numberline {8}{\ignorespaces Sem \emph {padding}, um deslocamento severo faz a imagem vazar para o lado oposto (convolução circular).}}{xxv}{figure.caption.12}%
\contentsline {figure}{\numberline {9}{\ignorespaces Verificação do Teorema da Convolução: a diferença pixel a pixel entre a convolução espacial (cv2.filter2D) e a multiplicação em frequência (FFT) é numericamente nula --- confirmando a equivalência teórica.}}{xxix}{figure.caption.13}%
\contentsline {figure}{\numberline {10}{\ignorespaces A Dualidade Perigosa: o corte abrupto na Frequência (cilindro Ideal) vira obrigatoriamente uma \emph {sinc} no espaço. Suas ondulações causam o \emph {ringing} fantasma nas bordas da imagem.}}{xxxi}{figure.caption.14}%
\contentsline {figure}{\numberline {11}{\ignorespaces Low-pass filters.}}{xxxii}{figure.caption.19}%
\contentsline {figure}{\numberline {12}{\ignorespaces Interactive simulator of filters in the frequency domain.}}{xxxiii}{figure.caption.20}%
\contentsline {figure}{\numberline {13}{\ignorespaces Comparação entre filtros passa-baixa: Ideal (D₀=30), Gaussiano (D₀=30) e Butterworth (D₀=30, n=2). Perfis de H(u,v) ao longo de uma linha central e imagens filtradas correspondentes.}}{xxxvi}{figure.caption.21}%
\contentsline {figure}{\numberline {14}{\ignorespaces Filtro passa-alta Gaussiano. (a) Original; (b) Filtro passa-alta (D₀=30) - as bordas das moedas e fundo texturizado são realçados.}}{xxxviii}{figure.caption.22}%
\contentsline {figure}{\numberline {15}{\ignorespaces Remoção de ruído periódico via filtro \emph {notch} no domínio da frequência: (a) imagem com ruído senoidal, (b) espectro mostrando os picos do ruído, (c) máscara \emph {notch} centrada nos picos, (d) imagem restaurada.}}{xl}{figure.caption.23}%
\contentsline {figure}{\numberline {16}{\ignorespaces Fourier global é cego para a posição. Os espectros não dizem onde as bordas estão.}}{xliii}{figure.caption.24}%
\contentsline {figure}{\numberline {17}{\ignorespaces Funções da \emph {Wavelet} (ψ). Note como elas rapidamente decaem para zero (suporte compacto), ao contrário das senoides infinitas de Fourier.}}{xlvi}{figure.caption.25}%
\contentsline {figure}{\numberline {18}{\ignorespaces Diagram of the 2D wavelet decomposition at two levels.}}{xlvii}{figure.caption.26}%
\contentsline {figure}{\numberline {19}{\ignorespaces Simulation of 2D \emph {wavelet} decomposition.}}{xlix}{figure.caption.27}%
\contentsline {figure}{\numberline {20}{\ignorespaces Decomposição \emph {wavelet} 2D de 2 níveis com \emph {wavelet} Haar: subbandas LL, LH, HL, HH em cada nível. As subbandas de detalhe revelam estruturas orientadas em diferentes escalas utilizando um padrão sintético.}}{lii}{figure.caption.28}%
\contentsline {figure}{\numberline {21}{\ignorespaces Comparação entre famílias de \emph {wavelets}: Haar, db4, sym4 e bior2.2. Subbanda LL₁ (aproximação) e HH₁ (diagonal) para cada escolha, ilustrando o compromisso entre compactação e suavidade com base no padrão sintético.}}{liv}{figure.caption.29}%
\contentsline {figure}{\numberline {22}{\ignorespaces Wavelet reconstruction with coefficient thresholding (\emph {hard thresholding}): as the threshold increases, more details are zeroed out, producing progressively smoother images. The PSNR metric quantifies the quality loss on the synthetic pattern.}}{lv}{figure.caption.30}%
\contentsline {figure}{\numberline {23}{\ignorespaces O Alfabeto Visual do JPEG: As 64 funções de base da DCT-II. O coeficiente DC fica no topo esquerdo (suave). Ao descer e avançar à direita, a oscilação espacial aumenta drasticamente.}}{lix}{figure.caption.32}%
\contentsline {figure}{\numberline {24}{\ignorespaces DCT 2D em bloco 8×8: coeficientes e reconstrução progressiva.}}{lxiii}{figure.caption.33}%
\contentsline {figure}{\numberline {25}{\ignorespaces \emph {Pipeline} JPEG simplificado aplicado à imagem clássica do \emph {Cameraman}: DCT em blocos 8×8, quantização com diferentes fatores de qualidade e reconstrução via IDCT. Os artefatos de bloco (\emph {blocking artifacts}) tornam-se visualmente evidentes em fatores de qualidade reduzidos (\(Q=10\) e \(Q=25\)).}}{lxv}{figure.caption.34}%
\contentsline {figure}{\numberline {26}{\ignorespaces Interactive DCT-JPEG compression simulator: adjust the quality factor and visualize in real time the zeroed coefficients, the reconstructed block, and the quantization error.}}{lxvii}{figure.caption.35}%
\contentsline {figure}{\numberline {27}{\ignorespaces Comparative analysis of compression artifacts under reduced quality factor (\(Q=10\)). On the left, the block artifact characteristic of DCT discretization in JPEG is observed. On the right, the attenuation and edge smoothing effect intrinsic to the WebP standard is evident.}}{lxviii}{figure.caption.38}%
\contentsline {figure}{\numberline {28}{\ignorespaces Rate-distortion curve: PSNR vs file size for JPEG, WebP, and PNG applied to the \emph {Cameraman} image.}}{lxix}{figure.caption.39}%
\contentsline {figure}{\numberline {29}{\ignorespaces Análise espacial de degradação: imagens reconstruídas e respectivos mapas de erro absoluto normalizados para diferentes fatores de qualidade JPEG.}}{lxxii}{figure.caption.40}%
\contentsline {figure}{\numberline {30}{\ignorespaces \emph {Pipeline} completo de remoção de ruído misto: (1) adição de ruído gaussiano e periódico; (2) identificação de picos de interferência no espectro de frequências; (3) aplicação de máscara \emph {notch} com atenuação gaussiana suave; (4) pós-processamento via filtro bilateral para eliminação do ruído estocástico residual.}}{lxxvii}{figure.caption.41}%
\contentsline {figure}{\numberline {31}{\ignorespaces Conceptual map of transformations and properties in the frequency domain.}}{lxxviii}{figure.caption.42}%
\contentsline {figure}{\numberline {32}{\ignorespaces EP05\_01 Simulator: Ideal Low-Pass Filter in the Spectrum}}{lxxxiv}{figure.caption.43}%
\contentsline {figure}{\numberline {33}{\ignorespaces EP05\_02 Simulator: Notch Filter}}{lxxxvi}{figure.caption.44}%
\contentsline {figure}{\numberline {34}{\ignorespaces EP05\_03 Simulator: DCT Quantization (\emph {round-trip})}}{lxxxix}{figure.caption.45}%
\contentsline {figure}{\numberline {35}{\ignorespaces EP05\_04 Simulator: Manual 2D DFT}}{xci}{figure.caption.46}%
\contentsline {figure}{\numberline {36}{\ignorespaces EP05\_05 Simulator: Complete JPEG pipeline in block}}{xciv}{figure.caption.47}%
