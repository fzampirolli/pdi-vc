\contentsline {figure}{\numberline {8.1}{\ignorespaces Overview of the main concepts covered in this chapter, including feature matching, object detection, image segmentation, and their relationships with modern approaches based on \emph {Deep Learning}. \textbf {Source:} prepared with the assistance of Gemini Notebook (\{GOOGLE\}, 2025).}}{424}{figure.caption.280}%
\contentsline {figure}{\numberline {8.2}{\ignorespaces Comparison of performance of different implementations of the Hamming distance.}}{427}{figure.caption.282}%
\contentsline {figure}{\numberline {8.3}{\ignorespaces Interactive simulator of the ORB descriptor: explore the rotation logic and binary descriptor construction. Change the rotation to observe how the BRIEF binary test sampling pattern (green and red lines) dynamically orients itself to ensure angular invariance.}}{428}{figure.caption.283}%
\contentsline {figure}{\numberline {8.4}{\ignorespaces Original image generated by Gemini and rotated version (20°), simulating a change of viewpoint.}}{429}{figure.caption.284}%
