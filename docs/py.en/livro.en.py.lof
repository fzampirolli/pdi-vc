\contentsline {figure}{\numberline {4.1}{\ignorespaces Image with various types of coins. Credit: GAZI.MD.AHAD (CC BY-SA 4.0).}}{157}{figure.caption.124}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Comparison of preprocessings: image \textbar {} histogram+T* \textbar {} σ²B(T) \textbar {} Otsu. The best bimodal separation indicates the most reliable threshold.}}{160}{figure.caption.125}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Structuring element in cross shape (\(B_{\text {cruz}}\)) used for 4-connectivity.}}{162}{figure.caption.127}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Erosion and dilation on a 10×10 binary image with an asymmetric 3×3 structuring element `L'. Validation of the erosion--dilation duality.}}{168}{figure.caption.129}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Simulator: Morphological Erosion (A ⊖ B\_L)}}{168}{figure.caption.130}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Opening, closing, composition, and alternating sequential filter applied to Otsu binarization of coins with CLAHE. Structuring element: 13×13 disk.}}{170}{figure.caption.133}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Interactive simulator of geodesic dilation: the marker f (green) propagates step by step through the free paths of mask g, without crossing walls.}}{172}{figure.caption.135}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Maze resolution via Complementary Operations: Inverting the mask and marker at the start of the \emph {pipeline}, the flow is resolved directly in the complementary domain through mm.cero and mm.suprec, eliminating redundant re-inversions.}}{175}{figure.caption.137}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \emph {Pipeline} of Morphological Reconstruction by Conditioned Dilation: the mask contains two objects, the marker isolates only the core of the main object, and subsequent iterations in a loop reconstruct its exact shape until convergence.}}{177}{figure.caption.139}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \emph {Pipeline} for hole filling (\emph {clohole}): the marker is obtained from the image border and restricted to the complement \(f^c\). Geodesic dilation iterations reconstruct the external background; after final complementation, internal holes are filled.}}{179}{figure.caption.142}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \emph {Pipeline} for removing border structures (\emph {edgeoff}): the marker captures roots connected to the matrix ends, reconstruction delimits the extent of these elements, and boolean subtraction preserves only fully internal objects.}}{180}{figure.caption.143}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces \emph {Pipeline} completo de segmentação com CLAHE: Otsu → abertura (r=9) → clohole → abertura (r=33) → edgeoff.}}{181}{figure.caption.144}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Advanced interactive morphology simulator with editable structuring element and 1D profile.}}{182}{figure.caption.148}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Grayscale morphology and their respective histograms. Erosion reduces local intensities, dilation amplifies them, the gradient highlights edges, and the Top-hat and Black-hat operators highlight bright and dark local details. Structuring element: disk of diameter 19.}}{184}{figure.caption.149}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Flood-fill labeling algorithm with stack.}}{187}{figure.caption.151}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Interactive simulator for connected component labeling: visualization of flood-fill expansion, 4-connectivity and 8-connectivity.}}{188}{figure.caption.152}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Effect of connectivity on labeling: the 10×10 binary image contains diagonally adjacent pixels. With 4-connectivity, these pixels form distinct components; with 8-connectivity, they merge into a single component.}}{188}{figure.caption.153}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Distance Transform Algorithm.}}{190}{figure.caption.154}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Interactive simulator of the Distance Transform (DT) iterative via grayscale erosion. Pixels outside the image assume the maximum value (144), propagating costs from the internal background.}}{191}{figure.caption.155}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Distance Transform on a 10×10 binary image. Left: original image (\emph {foreground} = 255). Center: iterative mm.dist1 (erosions with cross structuring element). Right: mm.dist (Euclidean L2).}}{191}{figure.caption.156}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Interactive 2D simulator (4x4) with strict synchronization of horizontal propagation queues (b) to obtain the exact convergence described in the paper.}}{192}{figure.caption.157}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Shortest geodesic path in a maze. Geodesic distances are calculated from the entrance and exit using mm.gdist. Pixels whose sum of the two distances equals the minimum distance between markers belong to an optimal path.}}{194}{figure.caption.158}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Didactic \emph {Watershed} Algorithm by Region Growing Limited by Mask.}}{195}{figure.caption.159}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Interactive simulator of the \emph {Watershed} algorithm by morphological propagation. Draw the mask, position the markers and adjust the Structuring Element to observe the flooding. When basins meet simultaneously, the tie is resolved by randomly assuming one of the regions.}}{196}{figure.caption.160}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} \emph {watershed} bounded by mask on 20×20 binary image.}}{198}{figure.caption.161}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces Watershed \emph {Pipeline} for separating overlapping coins: from the dilated binary mask to the final annotated contours on the original image.}}{199}{figure.caption.162}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Connected components extracted after the CLAHE → Otsu → morphological cleaning \emph {pipeline}. Each object is colored with a distinct color and annotated with its area in pixels.}}{201}{figure.caption.163}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Contours extracted with \emph {findContours}. Each coin is annotated with its circularity --- values close to 1 confirm a circular shape.}}{203}{figure.caption.164}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces \emph {Bounding boxes} derived from connected components overlaid on the original image. The annotations are exported in YOLO format (\emph {class cx cy w h}), with coordinates normalized to the interval {[}0,1{]}.}}{204}{figure.caption.165}%
\contentsline {figure}{\numberline {4.30}{\ignorespaces EP04\_01 Simulator: Global Thresholding by Fixed Threshold (p' = (p \textgreater {} T) ? 255 : 0)}}{210}{figure.caption.167}%
\contentsline {figure}{\numberline {4.31}{\ignorespaces EP04\_02 Simulator: Automatic Otsu Thresholding (T* = argmax σ²\_B(T))}}{212}{figure.caption.168}%
\contentsline {figure}{\numberline {4.32}{\ignorespaces Simulator EP04\_03: Binary Dilation (g = f ⊕ B)}}{214}{figure.caption.169}%
