\contentsline {figure}{\numberline {5.1}{\ignorespaces 1D Fourier decomposition: a square wave (dashed line) is approximated by the sum of the first sinusoids (colored lines). The more terms, the better the approximation.}}{232}{figure.caption.177}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Interactive simulator of 1D Fourier decomposition: visualization of the sum of sinusoids with different frequencies, amplitudes and phases. Add terms and observe convergence to arbitrary waveforms.}}{233}{figure.caption.178}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Every frequency in the spectrum (isolated point) corresponds to a rotated 2D sine wave in the spatial domain.}}{235}{figure.caption.179}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Interactive simulator of 2D Fourier synthesis. Change the horizontal (\(u\)) and vertical (\(v\)) position of the coefficient in the centered frequency spectrum and observe how the distance from the center dictates the spatial frequency (thickness) and the angle dictates the orientation of the generated sine wave.}}{235}{figure.caption.180}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Conceptual diagram of the centered 2D Fourier spectrum.}}{237}{figure.caption.183}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Phase swap experiment: Image A (coins) and Image B (geometric pattern) reconstructed with swapped magnitudes and phases. The result shows that the visual structure is \textbf {much more sensitive to phase} than to magnitude: when B's phase is preserved, the resulting image retains B's spatial organization, even with A's magnitude. Magnitude, in turn, mainly influences contrast and texture. Note that reconstruction quality is not perfect --- visible artifacts exist ---, highlighting the interdependence between phase and magnitude for a faithful image representation.}}{239}{figure.caption.184}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Efficiency comparison: Non-Separable Convolution (Spatial 2D), Separable (Spatial 1D) and via FFT.}}{241}{figure.caption.187}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Without \emph {padding}, a severe shift makes the image leak to the opposite side (circular convolution).}}{242}{figure.caption.188}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Verification of the Convolution Theorem: the pixel-by-pixel difference between spatial convolution (cv2.filter2D) and frequency multiplication (FFT) is numerically zero --- confirming the theoretical equivalence.}}{243}{figure.caption.189}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces The Dangerous Duality: The abrupt cutoff in Frequency (Cylinder) necessarily transforms into a spatial Sinc. Its ripples cause the ghostly \emph {ringing} at the edges of the image.}}{244}{figure.caption.190}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Low-pass filters.}}{245}{figure.caption.195}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Interactive simulator of filters in the frequency domain.}}{246}{figure.caption.196}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Comparison between low-pass filters: Ideal (D₀=30), Gaussian (D₀=30) and Butterworth (D₀=30, n=2). H(u,v) profiles along a central line and corresponding filtered images.}}{248}{figure.caption.197}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Gaussian high-pass filter. (a) Original; (b) High-pass filter (D₀=30) - the edges of the coins and textured background are enhanced.}}{249}{figure.caption.198}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Periodic noise removal via \emph {notch} filter in the frequency domain: (a) image with sinusoidal noise, (b) spectrum showing noise peaks, (c) \emph {notch} mask centered on the peaks, (d) restored image.}}{250}{figure.caption.199}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Fourier global is blind to position. The spectra do not tell where the edges are.}}{252}{figure.caption.200}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Wavelet functions (ψ). Note how they quickly decay to zero (compact support), unlike the infinite sinusoids of Fourier.}}{254}{figure.caption.201}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Diagram of the 2D wavelet decomposition at two levels.}}{254}{figure.caption.202}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Simulation of 2D \emph {wavelet} decomposition.}}{256}{figure.caption.203}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces 2D \emph {wavelet} decomposition of 2 levels with Haar \emph {wavelet}: LL, LH, HL, HH subbands at each level. The detail subbands reveal oriented structures at different scales using a synthetic pattern.}}{258}{figure.caption.204}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Comparison between \emph {wavelet} families: Haar, db4, sym4, and bior2.2. LL₁ subband (approximation) and HH₁ (diagonal) for each choice, illustrating the trade-off between compactness and smoothness based on the synthetic pattern.}}{259}{figure.caption.205}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Wavelet reconstruction with coefficient thresholding (\emph {hard thresholding}): as the threshold increases, more details are zeroed out, producing progressively smoother images. The PSNR metric quantifies the quality loss on the synthetic pattern.}}{261}{figure.caption.206}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces The Visual Alphabet of JPEG: The 64 basis functions of the DCT-II. The DC coefficient is at the top left (smooth). Going down and to the right, the spatial oscillation increases drastically.}}{264}{figure.caption.208}%
\contentsline {figure}{\numberline {5.24}{\ignorespaces 2D DCT in 8×8 block: coefficients and progressive reconstruction.}}{266}{figure.caption.209}%
\contentsline {figure}{\numberline {5.25}{\ignorespaces \emph {Pipeline} simplified JPEG applied to the classic \emph {Cameraman} image: block DCT 8×8, quantization with different quality factors and reconstruction via IDCT. Blocking artifacts become visually evident at reduced quality factors (\(Q=10\) and \(Q=25\)).}}{269}{figure.caption.210}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Interactive DCT-JPEG compression simulator: adjust the quality factor and visualize in real time the zeroed coefficients, the reconstructed block, and the quantization error.}}{270}{figure.caption.211}%
\contentsline {figure}{\numberline {5.27}{\ignorespaces Comparative analysis of compression artifacts under reduced quality factor (\(Q=10\)). On the left, the block artifact characteristic of DCT discretization in JPEG is observed. On the right, the attenuation and edge smoothing effect intrinsic to the WebP standard is evident.}}{272}{figure.caption.214}%
\contentsline {figure}{\numberline {5.28}{\ignorespaces Rate-distortion curve: PSNR vs file size for JPEG, WebP, and PNG applied to the \emph {Cameraman} image.}}{274}{figure.caption.215}%
\contentsline {figure}{\numberline {5.29}{\ignorespaces Spatial degradation analysis: reconstructed images and respective normalized absolute error maps for different JPEG quality factors.}}{276}{figure.caption.216}%
\contentsline {figure}{\numberline {5.30}{\ignorespaces Full mixed noise removal \emph {pipeline}: (1) addition of Gaussian and periodic noise; (2) identification of interference peaks in the frequency spectrum; (3) application of \emph {notch} mask with smooth Gaussian attenuation; (4) post-processing via bilateral filter to eliminate residual stochastic noise.}}{280}{figure.caption.217}%
\contentsline {figure}{\numberline {5.31}{\ignorespaces Conceptual map of transformations and properties in the frequency domain.}}{281}{figure.caption.218}%
\contentsline {figure}{\numberline {5.32}{\ignorespaces EP05\_01 Simulator: Ideal Low-Pass Filter in the Spectrum}}{286}{figure.caption.219}%
\contentsline {figure}{\numberline {5.33}{\ignorespaces EP05\_02 Simulator: Notch Filter}}{288}{figure.caption.220}%
\contentsline {figure}{\numberline {5.34}{\ignorespaces EP05\_03 Simulator: DCT Quantization (\emph {round-trip})}}{290}{figure.caption.221}%
\contentsline {figure}{\numberline {5.35}{\ignorespaces EP05\_04 Simulator: Manual 2D DFT}}{292}{figure.caption.222}%
\contentsline {figure}{\numberline {5.36}{\ignorespaces EP05\_05 Simulator: Complete JPEG pipeline in block}}{294}{figure.caption.223}%
