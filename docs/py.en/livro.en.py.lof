\contentsline {figure}{\numberline {9.1}{\ignorespaces Overview of the main concepts addressed in this chapter. \textbf {Source:} prepared with the aid of \emph {Gemini Notebook} (\{GOOGLE\}, 2025).}}{482}{figure.caption.308}%
\contentsline {figure}{\numberline {9.2}{\ignorespaces Interactive simulator of classic 2D convolution: choose among the three synthetic 12×12 input images (house, happy or sad face) and a 3×3 filter (Sobel V, Sobel H, Sharpen, or Identity) and step forward to observe how the local inner products of the receptive field build the feature map cell by cell.}}{485}{figure.caption.309}%
\contentsline {figure}{\numberline {9.3}{\ignorespaces Interactive simulator of the Artificial Neuron in a CNN context: toggle between a convolutional layer neuron (where x\_i are pixel intensities in a receptive field and w\_i are kernel weights) and a fully connected layer neuron, adjusting inputs, weights, bias, and activation function to visualize the computation of z and output y in real time.}}{487}{figure.caption.310}%
\contentsline {figure}{\numberline {9.4}{\ignorespaces Interactive Convolutional Layer Simulator: choose among three 12×12 input images (house, happy face, or sad face) to observe how the same fixed \emph {kernels} react to different edges and shapes. Navigate the receptive field with the buttons or automatic playback, adjust the activation function and toggle zero-padding, while the feature map is revealed cell by cell, with detailed term-by-term calculation and the output dimension formula in real time.}}{489}{figure.caption.311}%
\contentsline {figure}{\numberline {9.5}{\ignorespaces Interactive simulator of the ReLU activation function: drag the control to see how negative values are zeroed out and positive values are preserved, both in the curve and in a real feature map.}}{490}{figure.caption.312}%
\contentsline {figure}{\numberline {9.6}{\ignorespaces Interactive \emph {pooling} simulator: choose between \emph {max-pooling} and \emph {average-pooling} and step forward to observe the reduction of the spatial resolution of the feature map.}}{490}{figure.caption.313}%
\contentsline {figure}{\numberline {9.7}{\ignorespaces Interactive simulator of the Loss Function (\emph {Cross-Entropy}): select the real class of the image (House, Happy or Sad) and adjust the probabilities estimated by Softmax to visualize the calculation of the scalar penalty and the graph of the negative logarithm in real time.}}{491}{figure.caption.314}%
\contentsline {figure}{\numberline {9.8}{\ignorespaces Interactive \emph {Backpropagation} simulator: advance through the Chain Rule steps to follow the error signal flow in the reverse direction of the network, observing the computation of partial derivatives of the gradient at each layer.}}{492}{figure.caption.315}%
\contentsline {figure}{\numberline {9.9}{\ignorespaces Interactive simulator of Optimization Algorithms: compare the trajectory of SGD and Adam over a non-convex loss surface with a heatmap and contour lines. The solid line shows the selected optimizer advancing step by step; the dashed line shows, for instant comparison, the full path that the other optimizer would take from the same starting point. Notice how SGD gets stuck in the Local Minimum on the right, while Adam may or may not cross the central barrier depending on accumulated momentum and learning rate. Click anywhere on the plot to reset the starting point of the weights.}}{493}{figure.caption.316}%
\contentsline {figure}{\numberline {9.10}{\ignorespaces Simplified architecture of a CNN for image classification, highlighting the \emph {forward pass} and the training steps through the loss function, backpropagation, and the optimization algorithm.}}{494}{figure.caption.317}%
\contentsline {figure}{\numberline {9.11}{\ignorespaces Interactive simulator of a CNN architecture: choose one of the 12×12 input images (house, happy face, or sad face), click on each block of the \emph {pipeline} --- Input, \emph {Conv+ReLU}, \emph {Pooling}, \emph {Flatten}, \emph {FC}, and \emph {Softmax} --- and run real training steps (\emph {forward pass} + backpropagation) to observe the loss and accuracy evolving, the \emph {kernels} being adjusted, and the \emph {Softmax} starting to point to the correct class.}}{495}{figure.caption.318}%
\contentsline {figure}{\numberline {9.12}{\ignorespaces Interactive simulator for computing the gradient of a weight from the convolutional \emph {kernel}.}}{498}{figure.caption.319}%
\contentsline {figure}{\numberline {9.13}{\ignorespaces Digit samples from the training set after conversion to PyTorch \emph {tensors} and normalization.}}{501}{figure.caption.320}%
\contentsline {figure}{\numberline {9.14}{\ignorespaces Representation of the flow of dimensional transformations of the tensors throughout the \emph {CNNDigitos} architecture.}}{501}{figure.caption.321}%
\contentsline {figure}{\numberline {9.15}{\ignorespaces Training and evaluation curves of the CNN on the digits dataset: evolution of cross-entropy loss on the training set and accuracy on the test set over 50 epochs.}}{505}{figure.caption.322}%
\contentsline {figure}{\numberline {9.16}{\ignorespaces Flow of activations of the trained CNN when processing a real example of the digit 3, from the \emph {load\_digits} dataset: tensor dimensions layer by layer, from input to output \emph {logit}.}}{506}{figure.caption.323}%
\contentsline {figure}{\numberline {9.17}{\ignorespaces Computational graph of \emph {CNNDigitos} generated via \emph {torchviz}, showing the \emph {forward} operations and the gradient nodes (\emph {backward}) associated with each trainable parameter.}}{507}{figure.caption.324}%
\contentsline {figure}{\numberline {9.18}{\ignorespaces Detailed graph of the CNNDigitos class generated via \emph {torchviz}.}}{509}{figure.caption.325}%
\contentsline {figure}{\numberline {9.19}{\ignorespaces Comparison of accuracy between the classic classifiers from Chapter 7 (raw pixels and HOG with k-NN) and the CNN trained in this chapter, on the same digit dataset.}}{510}{figure.caption.326}%
