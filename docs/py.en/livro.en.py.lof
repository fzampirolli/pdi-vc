\contentsline {figure}{\numberline {7.1}{\ignorespaces Motivational example: different fruits forming distinct clusters in a feature space.}}{362}{figure.caption.252}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Overview of the classic image classification \emph {pipeline}: descriptor extraction (LBP, HOG), formation of the feature space, and classification via k-NN. Not applicable to Deep Learning models (CNNs, YOLO), which learn \emph {features} end-to-end directly from pixels. \textbf {Source:} prepared with the aid of Gemini Notebook (\{GOOGLE\}, 2025).}}{363}{figure.caption.253}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Visual comparison of different descriptors applied to the same image. Each descriptor reveals distinct aspects of the scene.}}{365}{figure.caption.254}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Histogram of LBP codes from the cameramen image. Each bar represents the relative frequency of an LBP code, forming the feature vector used to describe the texture.}}{366}{figure.caption.255}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces First 100 components of the HOG feature vector.}}{368}{figure.caption.256}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Importance of feature normalization for the k-NN classifier.}}{370}{figure.caption.257}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Concept map of the image classification process using classical descriptors (LBP, HOG, raw pixels) and a traditional classifier (k-NN). It does not apply to Deep Learning models (CNNs, YOLO), which learn \emph {features end-to-end} directly from pixels.}}{372}{figure.caption.258}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Confusion matrices obtained by the k-NN classifier using three different descriptors. The rows represent the actual class (Apple, Banana, and Orange) and the columns the predicted class. The greater the concentration of values on the main diagonal, the better the descriptor's performance.}}{374}{figure.caption.259}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Detailed comparison of global accuracy in a realistic scenario. Note how structurally extracted descriptors (LBP and HOG) outperform the use of pure raw pixel intensities.}}{375}{figure.caption.260}%
\contentsline {figure}{\numberline {7.10}{\ignorespaces Illustration of the synthetic data generation process with \emph {make\_classification}. On the left, visualization of the three classes in a two-dimensional space formed by two informative features. On the right, relative importance of each feature for classification, showing that only 7 of the 10 features are effectively discriminative, while the others are redundant (2) or duplicated (1).}}{378}{figure.caption.261}%
\contentsline {figure}{\numberline {7.11}{\ignorespaces Classification of a new sample by the k-NN algorithm. The test point (star) is classified using the three nearest neighbors, highlighted by circles.}}{382}{figure.caption.262}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces Interactive simulator of the k-NN decision boundary: add training points and adjust the value of k to observe the effect on the decision region.}}{383}{figure.caption.263}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces Sample of handwritten digits from the \emph {load\_digits} dataset, used as a classification case study.}}{384}{figure.caption.264}%
\contentsline {figure}{\numberline {7.14}{\ignorespaces Confusion matrix of the k-NN classifier trained with raw intensity vectors (pixels).}}{386}{figure.caption.265}%
\contentsline {figure}{\numberline {7.15}{\ignorespaces Comparison of accuracy between raw pixel descriptors and HOG for the k-NN classifier (k=3) on the digits dataset.}}{387}{figure.caption.266}%
\contentsline {figure}{\numberline {7.16}{\ignorespaces Mean accuracy by cross-validation (5 folds) as a function of parameter k, for the digit base with raw intensity vectors.}}{389}{figure.caption.267}%
\contentsline {figure}{\numberline {7.17}{\ignorespaces Accuracy on the training and test sets for different values of \(k\). The colored regions represent, conceptually, behavior trends of the classifier: higher risk of overfitting (red), bias-variance trade-off (green) and higher risk of underfitting (blue).}}{390}{figure.caption.268}%
\contentsline {figure}{\numberline {7.18}{\ignorespaces Synthetic samples of the three texture classes used in the classification experiment, generated with Gaussian noise and intra-class variability.}}{392}{figure.caption.269}%
\contentsline {figure}{\numberline {7.19}{\ignorespaces Average accuracy obtained via cross-validation (5-fold) for the descriptors of Raw Pixels, LBP, and HOG applied to the synthetic textures dataset.}}{394}{figure.caption.270}%
\contentsline {figure}{\numberline {7.20}{\ignorespaces Detailed evaluation metrics for the k-NN classifier with LBP descriptors}}{397}{figure.caption.271}%
