\contentsline {figure}{\numberline {3.4}{\ignorespaces \emph {Alpha blending} between aligned croppings of mandrill and leopard (Figure~\ref {fig-03-leopardo}) for different values of α. At α=1 only the mandrill is visible; at α=0, only the leopard; intermediate values blend the looks of the two images proportionally.}}{98}{figure.caption.69}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Bitwise logical operations with circular mask: AND (ROI isolation), OR (ROI illumination), and NOT (negative).}}{99}{figure.caption.71}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Histograms of the original image, a darkened version, and a lightened version. The values in the second row indicate the number of pixels saturated at 0 (black) and 255 (white).}}{100}{figure.caption.74}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Histogram equalization in a 5×5 image with 3 bits (L=8): original image with tones concentrated in \{2,3,4\}, equalized image with tones redistributed to \{1,5,7\}, and the respective histograms showing the spreading of frequencies.}}{102}{figure.caption.76}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Histogram equalization: mm.equalize (global via CDF) vs.~CLAHE (adaptive with contrast limitation). The histograms reveal the progressive spread of intensities.}}{103}{figure.caption.77}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Histogram specification: mandrill mapped to the leopard's tone profile. The output CDF approximates the reference CDF.}}{105}{figure.caption.79}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Correlation with 3×3 averaging \emph {kernel}: didactic version (mm.conv0) vs.~vectorized (mm.conv via cv2.filter2D). The maximum difference of 39 occurs at the borders.}}{112}{figure.caption.84}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces \emph {Patch} 5×5 extracted from the leopard image (position {[}250:255, 250:255{]}). The yellow window highlights the 3×3 neighborhood centered at pixel {[}1,1{]} where the correlation will be calculated.}}{112}{figure.caption.85}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Average filter with kernels of increasing size (3×3, 7×7, 15×15). The blurring of the edges increases with the kernel size.}}{114}{figure.caption.87}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces \emph {Gaussian} Kernel 5×5 (σ=1): normalized weights, larger at the center and decreasing radially. The grid facilitates reading each coefficient.}}{115}{figure.caption.89}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Comparison between mean filter and Gaussian (9×9 kernel, σ=0). The Gaussian preserves edges better, visible in the face detail.}}{116}{figure.caption.90}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Simulator: 1D Spatial Enhancement Filtering (Unsharp Masking and High-Boost)}}{117}{figure.caption.92}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces \emph {Laplacian kernel} w4 applied to the 5×5 \emph {patch}: the yellow window highlights the 3×3 neighborhood where the second derivative operator is computed.}}{119}{figure.caption.96}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Laplacian applied to the leopard image: raw response (detected edges) with w4 and w8, and images enhanced by subtracting the Laplacian. w8 is more sensitive to diagonals.}}{120}{figure.caption.97}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces Sobel operator on the leopard image: Gx detects vertical edges, Gy detects horizontal edges, and the magnitude \textbar ∇f\textbar {} combines both, revealing all edges regardless of direction.}}{122}{figure.caption.101}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces Prewitt operator: Gx, Gy and magnitude --- comparable to Sobel, but without perpendicular Gaussian weighting.}}{122}{figure.caption.103}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Sharpening highlight by \emph {Unsharp Masking} on the leopard image: the smoothed image is subtracted from the original to generate the high-frequency mask, which is then reintroduced to enhance edges and details.}}{124}{figure.caption.105}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces \emph {Unsharp Masking} on the leopard image with σ=1 and k ranging from 0.5 to 8.0. For k\textgreater 2, edge artifacts (halos) appear and background noise becomes visible.}}{125}{figure.caption.106}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Canny detector with different threshold pairs: low thresholds capture more edges (including noise); high thresholds retain only the strongest edges.}}{126}{figure.caption.107}%
\contentsline {figure}{\numberline {3.23}{\ignorespaces Salt and pepper noise with increasing densities (2\%, 5\%, 10\%). The parameter prob indicates the total fraction of corrupted pixels, half salt (255) and half pepper (0).}}{127}{figure.caption.108}%
\contentsline {figure}{\numberline {3.24}{\ignorespaces Comparison of filters for removing salt-and-pepper noise (10\%): Gaussian, Mean, Median, Bilateral, and Morphological. Top row: full images; bottom row: crop of the region of interest.}}{130}{figure.caption.110}%
