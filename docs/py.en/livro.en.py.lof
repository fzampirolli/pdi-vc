\contentsline {figure}{\numberline {6.1}{\ignorespaces Sample of public images from \emph {skimage.data}, grouped by application area.}}{302}{figure.caption.224}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Comparison between preprocessing strategies for text image binarization: (a) original image; (b) direct thresholding by Otsu's method; (c) background estimated by Gaussian filtering; (d) image after background normalization (division by the smoothed image); (e) CLAHE followed by Otsu thresholding; and (f) background normalization followed by Otsu thresholding. The images illustrate the effect of each technique on compensating for illumination variations and on segmentation quality.}}{303}{figure.caption.225}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Comparison of the text extracted by Tesseract from four versions of the same image: (a) original image; (b) CLAHE followed by Otsu thresholding; (c) background normalization followed by Otsu thresholding; and (d) background normalization in grayscale, without thresholding. The comparison shows that external binarization does not always favor recognition, since Tesseract already performs its own adaptive binarization internally.}}{306}{figure.caption.226}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Automatic recognition and translation flow. The image pre-processed by background normalization, without thresholding, is used as input to Tesseract OCR, and the recognized text is translated from English to Portuguese using the \emph {deep-translator} library.}}{307}{figure.caption.227}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces \emph {Pipeline} for document ingestion: adaptive rasterization of PDF pages into discrete arrays in PNG format, showing page two.}}{310}{figure.caption.228}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Interactive skew correction simulator (\emph {deskew}): move the \emph {slider} to tilt the document and observe the three steps of the \emph {pipeline} --- tilted image, Canny edges, and corrected result.}}{312}{figure.caption.229}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces \emph {Axial rectification pipeline}: comparative display between the original rotated input, the Canny structural gradient map, and the final aligned result with normalized white background.}}{313}{figure.caption.230}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Detection of marker discs, contour extraction, and rectification by perspective transformation.}}{316}{figure.caption.231}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Interactive simulator of circularity filtering: move the \emph {slider} to adjust the threshold C and observe which components are accepted (green) or rejected (red).}}{317}{figure.caption.232}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces \emph {Pipeline} of \emph {QRCode} processing: thresholding, morphological opening, inversion, and final cropping for decoding.}}{319}{figure.caption.233}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Interactive simulator of the QRCode isolation \emph {pipeline}: navigate through the filtering steps, adjust the structuring element of the morphological closing, and see the square contour detection on the original template image.}}{320}{figure.caption.234}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Decoding linear barcodes with \emph {pyzbar}: input image and extracted data.}}{322}{figure.caption.235}%
