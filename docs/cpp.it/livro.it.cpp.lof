\contentsline {figure}{\numberline {3.30}{\ignorespaces Simulatore EP03\_05: Applicazione della Maschera AND Binaria}}{176}{figure.caption.116}%
\contentsline {figure}{\numberline {3.31}{\ignorespaces Simulatore EP03\_06: Filtro Medio con Kernel N×N}}{178}{figure.caption.117}%
