\contentsline {figure}{\numberline {4.1}{\ignorespaces Imagem com moedas de vários tipos. Crédito: GAZI.MD.AHAD (CC BY-SA 4.0).}}{192}{figure.caption.124}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces CLAHE (realce adaptativo com limite de contraste) antes da limiarização de Otsu: original, realçado, histograma e binarização. (A trilha Python também traça as curvas de \(\mitsigma ^2_B(T)\).)}}{194}{figure.caption.125}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Elemento estruturante em formato de cruz (\(B_{\text {cruz}}\)) utilizado para conectividade-4.}}{196}{figure.caption.127}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Erosão e dilatação em imagem binária 10×10 com elemento estruturante `L' assimétrico 3×3. Validação da dualidade erosão--dilatação.}}{202}{figure.caption.129}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Simulatore: Erosione Morfologica (A ⊖ B\_L)}}{203}{figure.caption.130}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Abertura, fechamento, composição e filtro sequencial alternado aplicados à binarização Otsu das moedas (pré-processadas por realce de contraste). Elemento estruturante: disco 13×13.}}{206}{figure.caption.133}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Simulatore interattivo di dilatazione geodetica: il marker f (verde) si propaga passo dopo passo attraverso i percorsi liberi della maschera g, senza attraversare pareti.}}{208}{figure.caption.135}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Resolução de labirinto no domínio complementar: com máscara e marcador invertidos, \emph {mm::cero} e \emph {mm::suprec} propagam a onda geodésica pelos corredores.}}{211}{figure.caption.137}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \emph {Pipeline} de Reconstrução Morfológica por Dilatação Condicionada: a máscara contém dois objetos, o marcador isola apenas o núcleo do objeto principal, e as iterações reconstroem sua forma exata até a convergência.}}{214}{figure.caption.139}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \emph {Pipeline} de preenchimento de buracos (\emph {clohole}): o marcador vem da borda da imagem, restrito ao complemento \(f^c\). A dilatação geodésica reconstrói o fundo externo; após a complementação, os buracos internos ficam preenchidos.}}{217}{figure.caption.142}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \emph {Pipeline} de eliminação de estruturas de borda (\emph {edgeoff}): o marcador captura as raízes conectadas às extremidades, a reconstrução delimita esses elementos e a subtração preserva só os objetos totalmente internos.}}{219}{figure.caption.143}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces \emph {Pipeline} completo de segmentação com CLAHE: Otsu → abertura (r=9) → clohole → abertura (r=33) → edgeoff.}}{221}{figure.caption.144}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Simulatore interattivo avanzato di morfologia con elemento strutturante modificabile e profilo 1D.}}{223}{figure.caption.148}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Morfologia em tons de cinza e seus histogramas: erosão, dilatação, gradiente, top-hat e black-hat. Elemento estruturante: disco de diâmetro 19.}}{225}{figure.caption.149}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Algoritmo di etichettatura per \emph {flood-fill} con pila.}}{227}{figure.caption.151}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Simulatore interattivo di etichettatura delle componenti connesse (\emph {connected component labeling}): visualizzazione dell'espansione flood-fill, connettività-4 e connettività-8.}}{228}{figure.caption.152}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Efeito da conectividade na rotulação (\emph {mm::label0}): pixels diagonalmente adjacentes formam componentes distintas em conectividade-4 e se fundem em conectividade-8.}}{230}{figure.caption.153}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Algoritmo della Trasformata della Distanza.}}{231}{figure.caption.154}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Simulatore interattivo della Trasformata della Distanza (TD) iterativa tramite erosione in toni di grigio. I pixel fuori dall'immagine assumono il valore massimo (144), propagando i costi a partire dallo sfondo interno.}}{232}{figure.caption.155}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Transformada de Distância em imagem binária 10×10. Esquerda: original (\emph {foreground} = 255). Centro: mm.dist1 iterativa (erosões com cruz). Direita: mm.dist (L2).}}{234}{figure.caption.156}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Simulatore interattivo 2D (4x4) con sincronizzazione rigorosa delle code di propagazione orizzontale (b) per ottenere la convergenza esatta descritta nell'articolo.}}{235}{figure.caption.157}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Menor caminho geodésico em um labirinto. As distâncias geodésicas são calculadas a partir da entrada e da saída usando mm.gdist. Os pixels cujo somatório das duas distâncias é igual à distância mínima entre os marcadores pertencem a um caminho ótimo.}}{237}{figure.caption.158}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Algoritmo Didático di \emph {Watershed} per Crescita di Regioni Limitato da Maschera.}}{240}{figure.caption.159}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Simulatore interattivo dell'Algoritmo \emph {Watershed} per propagazione morfologica. Disegna la maschera, posiziona i marcatori e regola l'Elemento Strutturante per osservare l'inondazione. Quando i bacini si incontrano simultaneamente, il pareggio viene risolto assumendo una delle regioni in modo casuale.}}{241}{figure.caption.160}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} \emph {watershed} delimitado por máscara em imagem binária 20×20.}}{242}{figure.caption.161}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces \emph {Pipeline} \emph {Watershed} para separação de moedas sobrepostas: da máscara binária dilatada até os contornos finais anotados sobre a imagem original.}}{246}{figure.caption.162}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Componentes conexos extraídos após o \emph {pipeline} CLAHE → Otsu → limpeza morfológica. Cada objeto é colorido com cor distinta e anotado com sua área em pixels.}}{250}{figure.caption.163}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Contornos extraídos com \emph {findContours}. Cada moeda é anotada com sua circularidade --- valores próximos de 1 confirmam forma circular.}}{253}{figure.caption.164}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces \emph {Bounding boxes} derivadas dos componentes conexos sobrepostas à imagem original. As anotações são exportadas no formato YOLO (\emph {classe cx cy w h}), com coordenadas normalizadas para o intervalo {[}0,1{]}.}}{256}{figure.caption.165}%
\contentsline {figure}{\numberline {4.30}{\ignorespaces Simulatore EP04\_01: Soglia Globale con Soglia Fissa (p' = (p \textgreater {} T) ? 255 : 0)}}{262}{figure.caption.167}%
\contentsline {figure}{\numberline {4.31}{\ignorespaces Simulatore EP04\_02: Sogliatura Automatica di Otsu (T* = argmax σ²\_B(T))}}{264}{figure.caption.168}%
\contentsline {figure}{\numberline {4.32}{\ignorespaces Simulatore EP04\_03: Dilatazione Binaria Piana (g = f ⊕ B)}}{266}{figure.caption.169}%
\contentsline {figure}{\numberline {4.33}{\ignorespaces Simulatore EP04\_04: Erosione Binaria Piana (g = f ⊖ B)}}{269}{figure.caption.170}%
\contentsline {figure}{\numberline {4.34}{\ignorespaces Simulatore EP04\_05: Apertura Morfologica (g = (f ⊖ B) ⊕ B)}}{271}{figure.caption.171}%
\contentsline {figure}{\numberline {4.35}{\ignorespaces Simulatore EP04\_06: Chiusura Morfologica (g = (f ⊕ B) ⊖ B)}}{273}{figure.caption.172}%
\contentsline {figure}{\numberline {4.36}{\ignorespaces Simulatore EP04\_07: Dilatazione ed Erosione con Pesi (mm.dil1 / mm.ero1)}}{276}{figure.caption.173}%
\contentsline {figure}{\numberline {4.37}{\ignorespaces Simulatore EP04\_08: Gradiente morfologico, Top-hat e Black-hat}}{278}{figure.caption.174}%
\contentsline {figure}{\numberline {4.38}{\ignorespaces Simulatore EP04\_09: Trasformata della Distanza (Livelli di Erosione)}}{280}{figure.caption.175}%
\contentsline {figure}{\numberline {4.39}{\ignorespaces Simulatore EP04\_10: Separazione di Blob, Etichettatura e Descrittori}}{282}{figure.caption.176}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Decomposição de Fourier 1D: uma onda quadrada (linha tracejada) é aproximada pela soma das primeiras senoides (linhas coloridas). Quanto mais termos, melhor a aproximação.}}{286}{figure.caption.177}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Simulatore interattivo della decomposizione di Fourier 1D: visualizzazione della somma di sinusoidi con diverse frequenze, ampiezze e fasi. Aggiungi termini e osserva la convergenza verso forme d'onda arbitrarie.}}{288}{figure.caption.178}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Toda frequência no espectro (ponto isolado) corresponde a uma onda senoidal 2D rotacionada no domínio espacial.}}{292}{figure.caption.179}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Simulatore interattivo della sintesi di Fourier 2D. Modifica la posizione orizzontale (\(u\)) e verticale (\(v\)) del coefficiente nello spettro di frequenze centrato e osserva come la distanza dal centro determina la frequenza spaziale (spessore) e l'angolo determina l'orientamento dell'onda sinusoidale generata.}}{292}{figure.caption.180}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Diagramma concettuale dello spettro di Fourier 2D centrato.}}{294}{figure.caption.183}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Esperimento di cambio di fase: Immagine A (monete) e Immagine B (motivo geometrico) ricostruite con magnitudini e fasi scambiate. Il risultato mostra che la struttura visiva è \textbf {molto più sensibile alla fase} che alla magnitudine: quando la fase di B viene mantenuta, l'immagine risultante preserva l'organizzazione spaziale di B, anche con la magnitudine di A. La magnitudine, a sua volta, influenza principalmente il contrasto e la texture. Si noti che la qualità della ricostruzione non è perfetta --- ci sono artefatti visibili ---, evidenziando l'interdipendenza tra fase e magnitudine per una rappresentazione fedele dell'immagine.}}{296}{figure.caption.184}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Comparação de eficiência: Convolução Não Separável (Espacial 2D), Separável (Espacial 1D) e via FFT.}}{299}{figure.caption.187}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Sem \emph {padding}, um deslocamento severo faz a imagem vazar para o lado oposto (convolução circular).}}{302}{figure.caption.188}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Teorema da Convolução: filtrar no domínio do espaço (Gaussiana) equivale a multiplicar o espectro por \(H(u,v)\) na frequência. As saídas coincidem visualmente.}}{304}{figure.caption.189}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces A Dualidade Perigosa: o corte abrupto na Frequência (cilindro Ideal) vira obrigatoriamente uma \emph {sinc} no espaço. Suas ondulações causam o \emph {ringing} fantasma nas bordas da imagem.}}{306}{figure.caption.190}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Filtri passa-basso.}}{307}{figure.caption.195}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Simulatore interattivo di filtri nel dominio della frequenza.}}{308}{figure.caption.196}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Comparação entre filtros passa-baixa: Ideal (D₀=30), Gaussiano (D₀=30) e Butterworth (D₀=30, n=2). Perfis de H(u,v) ao longo de uma linha central e imagens filtradas correspondentes.}}{311}{figure.caption.197}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Filtro passa-alta Gaussiano. (a) Original; (b) Filtro passa-alta (D₀=30) - as bordas das moedas e fundo texturizado são realçados.}}{313}{figure.caption.198}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Remoção de ruído periódico via filtro \emph {notch} no domínio da frequência: (a) imagem com ruído senoidal, (b) espectro mostrando os picos do ruído, (c) máscara \emph {notch} centrada nos picos, (d) imagem restaurada.}}{316}{figure.caption.199}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Fourier global é cego para a posição. Os espectros não dizem onde as bordas estão.}}{319}{figure.caption.200}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Funções da \emph {Wavelet} (ψ). Note como elas rapidamente decaem para zero (suporte compacto), ao contrário das senoides infinitas de Fourier.}}{322}{figure.caption.201}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Diagramma della decomposizione \emph {wavelet} 2D su due livelli.}}{322}{figure.caption.202}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Simulazione della decomposizione \emph {wavelet} 2D.}}{324}{figure.caption.203}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Decomposição \emph {wavelet} 2D de 2 níveis com \emph {wavelet} Haar: subbandas LL, LH, HL, HH em cada nível. As subbandas de detalhe revelam estruturas orientadas em diferentes escalas utilizando um padrão sintético.}}{327}{figure.caption.204}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Comparação entre famílias de \emph {wavelets}: Haar, db4, sym4 e bior2.2. Subbanda LL₁ (aproximação) e HH₁ (diagonal) para cada escolha, ilustrando o compromisso entre compactação e suavidade com base no padrão sintético.}}{330}{figure.caption.205}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Reconstrução \emph {wavelet} com limiarização de coeficientes (\emph {hard thresholding}): à medida que o limiar aumenta, mais detalhes são zerados, produzindo imagens progressivamente mais suaves. Métrica PSNR quantifica a perda de qualidade sobre o padrão sintético.}}{333}{figure.caption.206}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces O Alfabeto Visual do JPEG: As 64 funções de base da DCT-II. O coeficiente DC fica no topo esquerdo (suave). Ao descer e avançar à direita, a oscilação espacial aumenta drasticamente.}}{337}{figure.caption.208}%
\contentsline {figure}{\numberline {5.24}{\ignorespaces DCT 2D em bloco 8×8: coeficientes e reconstrução progressiva.}}{341}{figure.caption.209}%
\contentsline {figure}{\numberline {5.25}{\ignorespaces \emph {Pipeline} JPEG simplificado aplicado à imagem clássica do \emph {Cameraman}: DCT em blocos 8×8, quantização com diferentes fatores de qualidade e reconstrução via IDCT. Os artefatos de bloco (\emph {blocking artifacts}) tornam-se visualmente evidentes em fatores de qualidade reduzidos (\(Q=10\) e \(Q=25\)).}}{344}{figure.caption.210}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Simulatore interattivo di compressione DCT-JPEG: regola il fattore di qualità e visualizza in tempo reale i coefficienti azzerati, il blocco ricostruito e l'errore di quantizzazione.}}{345}{figure.caption.211}%
\contentsline {figure}{\numberline {5.27}{\ignorespaces Análise comparativa de artefatos de compressão sob fator de qualidade reduzido (\(Q=10\)). À esquerda, observa-se o artefato de bloco característico da discretização por DCT no JPEG. À direita, evidencia-se o efeito de atenuação e suavização de bordas intrínseco ao padrão WebP.}}{348}{figure.caption.214}%
\contentsline {figure}{\numberline {5.28}{\ignorespaces Curva distorsione-tasso: PSNR vs dimensione del file per JPEG, WebP e PNG applicata all'immagine del \emph {Cameraman}.}}{349}{figure.caption.215}%
\contentsline {figure}{\numberline {5.29}{\ignorespaces Análise espacial de degradação: imagens reconstruídas e respectivos mapas de erro absoluto normalizados para diferentes fatores de qualidade JPEG.}}{353}{figure.caption.216}%
\contentsline {figure}{\numberline {5.30}{\ignorespaces \emph {Pipeline} completo di rimozione del rumore misto: (1) aggiunta di rumore gaussiano e periodico; (2) identificazione dei picchi di interferenza nello spettro delle frequenze; (3) applicazione di maschera \emph {notch} con attenuazione gaussiana morbida; (4) post-elaborazione tramite filtro bilaterale per l'eliminazione del rumore stocastico residuo.}}{356}{figure.caption.217}%
\contentsline {figure}{\numberline {5.31}{\ignorespaces Mappa concettuale delle trasformazioni e delle proprietà nel dominio delle frequenze.}}{358}{figure.caption.218}%
\contentsline {figure}{\numberline {5.32}{\ignorespaces Simulatore EP05\_01: Filtro Passa-Basso Ideale nello Spettro}}{364}{figure.caption.219}%
\contentsline {figure}{\numberline {5.33}{\ignorespaces Simulatore EP05\_02: Filtro Notch}}{366}{figure.caption.220}%
\contentsline {figure}{\numberline {5.34}{\ignorespaces Simulatore EP05\_03: Quantizzazione DCT (\emph {round-trip})}}{368}{figure.caption.221}%
\contentsline {figure}{\numberline {5.35}{\ignorespaces Simulatore EP05\_04: DFT 2D manuale}}{370}{figure.caption.222}%
\contentsline {figure}{\numberline {5.36}{\ignorespaces Simulatore EP05\_05: \emph {Pipeline} JPEG completo a blocchi}}{372}{figure.caption.223}%
