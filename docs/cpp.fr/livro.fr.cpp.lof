\contentsline {figure}{\numberline {5.33}{\ignorespaces Simulateur EP05\_02: Filtre Notch}}{374}{figure.caption.219}%
\contentsline {figure}{\numberline {5.34}{\ignorespaces Simulateur EP05\_03 : Quantification DCT (\emph {round-trip})}}{376}{figure.caption.220}%
\contentsline {figure}{\numberline {5.35}{\ignorespaces Simulateur EP05\_04: DFT 2D manuel}}{378}{figure.caption.221}%
\contentsline {figure}{\numberline {5.36}{\ignorespaces Simulateur EP05\_05 : \emph {Pipeline} JPEG complet par bloc}}{380}{figure.caption.222}%
