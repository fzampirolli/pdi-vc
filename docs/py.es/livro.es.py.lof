\contentsline {figure}{\numberline {7.1}{\ignorespaces Ejemplo motivacional: diferentes frutas formando agrupaciones distintas en un espacio de características.}}{378}{figure.caption.251}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Panorama del \emph {pipeline} clásico de clasificación de imágenes: extracción de descriptores (LBP, HOG), formación del espacio de características y clasificación mediante k-NN. No se aplica a modelos de Aprendizaje Profundo (CNNs, YOLO), que aprenden \emph {features} de extremo a extremo directamente de los píxeles. \textbf {Fuente:} elaborado con ayuda de Gemini Notebook (\{GOOGLE\}, 2025).}}{379}{figure.caption.252}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Comparación visual de diferentes descriptores aplicados a la misma imagen. Cada descriptor revela aspectos distintos de la escena.}}{381}{figure.caption.253}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Histograma de los códigos LBP de la imagen de los camarógrafos. Cada barra representa la frecuencia relativa de un código LBP, formando el vector de características utilizado para describir la textura.}}{382}{figure.caption.254}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Primeros 100 componentes del vector de características HOG.}}{384}{figure.caption.255}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Importancia de la normalización de las características para el clasificador k-NN.}}{387}{figure.caption.256}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Mapa conceptual del proceso de clasificación de imágenes utilizando descriptores clásicos (LBP, HOG, píxeles brutos) y clasificador tradicional (k-NN). No se aplica a modelos de Aprendizaje Profundo (CNNs, YOLO), que aprenden \emph {features end-to-end} directamente de los píxeles.}}{388}{figure.caption.257}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Matrices de confusión obtenidas por el clasificador k-NN utilizando tres descriptores diferentes. Las filas representan la clase real (Manzana, Plátano y Naranja) y las columnas la clase predicha. Cuanto mayor sea la concentración de valores en la diagonal principal, mejor será el desempeño del descriptor.}}{391}{figure.caption.258}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Comparación detallada de precisión global en escenario realista. Observe cómo los descriptores extraídos estructuralmente (LBP y HOG) superan el uso de intensidades puras de píxeles brutos.}}{392}{figure.caption.259}%
\contentsline {figure}{\numberline {7.10}{\ignorespaces Ilustración del proceso de generación de datos sintéticos con \emph {make\_classification}. A la izquierda, visualización de las tres clases en un espacio bidimensional formado por dos características informativas. A la derecha, importancia relativa de cada característica para la clasificación, evidenciando que solo 7 de las 10 características son efectivamente discriminativas, mientras que las demás son redundantes (2) o repetidas (1).}}{395}{figure.caption.260}%
\contentsline {figure}{\numberline {7.11}{\ignorespaces Clasificación de una nueva muestra por el algoritmo k-NN. El punto de prueba (estrella) se clasifica a partir de los tres vecinos más cercanos, resaltados por círculos.}}{398}{figure.caption.261}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces Simulador interactivo de la frontera de decisión del k-NN: añada puntos de entrenamiento y ajuste el valor de k para observar el efecto sobre la región de decisión.}}{399}{figure.caption.262}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces Muestra de dígitos manuscritos de la base \emph {load\_digits}, utilizada como caso de estudio de clasificación.}}{400}{figure.caption.263}%
\contentsline {figure}{\numberline {7.14}{\ignorespaces Matriz de confusión del clasificador k-NN entrenado con vectores de intensidad brutos (píxeles).}}{401}{figure.caption.264}%
\contentsline {figure}{\numberline {7.15}{\ignorespaces Comparación de precisión entre descriptores de píxeles brutos y HOG para el clasificador k-NN (k=3) en la base de dígitos.}}{402}{figure.caption.265}%
\contentsline {figure}{\numberline {7.16}{\ignorespaces Precisión media por validación cruzada (5 particiones) en función del parámetro k, para la base de dígitos con vectores de intensidad brutos.}}{404}{figure.caption.266}%
\contentsline {figure}{\numberline {7.17}{\ignorespaces Precisión en los conjuntos de entrenamiento y prueba para diferentes valores de \(k\). Las regiones coloreadas representan, de forma conceptual, tendencias de comportamiento del clasificador: mayor riesgo de sobreajuste (rojo), compromiso entre sesgo y varianza (verde) y mayor riesgo de subajuste (azul).}}{406}{figure.caption.267}%
\contentsline {figure}{\numberline {7.18}{\ignorespaces Muestras sintéticas de las tres clases de textura utilizadas en el experimento de clasificación, generadas con ruido gaussiano y variabilidad intra-clase.}}{408}{figure.caption.268}%
\contentsline {figure}{\numberline {7.19}{\ignorespaces Precisión media obtenida mediante validación cruzada (5-fold) para los descriptores de Píxeles Brutos, LBP y HOG aplicados a la base de texturas sintéticas.}}{410}{figure.caption.269}%
