\contentsline {figure}{\numberline {8.10}{\ignorespaces Detección de caras y ojos con \emph {Haar Cascade}.}}{454}{figure.caption.289}%
\contentsline {figure}{\numberline {8.11}{\ignorespaces Efecto de la Supresión de No-Máximos (NMS): múltiples detecciones redundantes (izquierda) se reducen a una detección por objeto (derecha).}}{456}{figure.caption.290}%
\contentsline {figure}{\numberline {8.12}{\ignorespaces Segmentación clásica (no basada en aprendizaje profundo): máscara semántica (moneda x fondo) mediante umbralización de Otsu, y segmentación de instancias mediante etiquetado de componentes conectados.}}{459}{figure.caption.291}%
