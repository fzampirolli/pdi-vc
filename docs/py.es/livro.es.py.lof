\contentsline {figure}{\numberline {4.1}{\ignorespaces Imagen con monedas de varios tipos. Crédito: GAZI.MD.AHAD (CC BY-SA 4.0).}}{161}{figure.caption.123}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Comparación de los preprocesamientos: imagen \textbar {} histograma+T* \textbar {} σ²B(T) \textbar {} Otsu. La mejor separación bimodal indica el umbral más confiable.}}{164}{figure.caption.124}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Elemento estructurante en forma de cruz (\(B_{\text {cruz}}\)) utilizado para conectividad-4.}}{166}{figure.caption.126}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Erosión y dilatación en imagen binaria 10×10 con elemento estructurante `L' asimétrico 3×3. Validación de la dualidad erosión--dilatación.}}{172}{figure.caption.128}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Simulador: Erosión Morfológica (A ⊖ B\_L)}}{172}{figure.caption.129}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Apertura, cierre, composición y filtro secuencial alternado aplicados a la binarización Otsu de las monedas (preprocesadas por realce de contraste). Elemento estructurante: disco 13×13.}}{174}{figure.caption.132}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Simulador interactivo de dilatación geodésica: el marcador f (verde) se propaga paso a paso por los caminos libres de la máscara g, sin atravesar paredes.}}{176}{figure.caption.134}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Resolución de laberinto mediante Operaciones Complementarias: Invirtiendo la máscara y el marcador al inicio del \emph {pipeline}, el flujo se resuelve directamente en el dominio complementario a través de mm.cero y mm.suprec, eliminando reinversiones redundantes.}}{179}{figure.caption.136}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \emph {Pipeline} de Reconstrucción Morfológica por Dilatación Condicionada: la máscara contiene dos objetos, el marcador aísla solo el núcleo del objeto principal, y las iteraciones reconstruyen su forma exacta hasta la convergencia.}}{181}{figure.caption.138}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \emph {Pipeline} de relleno de agujeros (\emph {clohole}): el marcador proviene del borde de la imagen, restringido al complemento \(f^c\). La dilatación geodésica reconstruye el fondo externo; tras la complementación, los agujeros internos quedan rellenos.}}{183}{figure.caption.141}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \emph {Pipeline} de eliminación de estructuras de borde (\emph {edgeoff}): el marcador captura las raíces conectadas a los extremos, la reconstrucción delimita esos elementos y la resta preserva solo los objetos totalmente internos.}}{184}{figure.caption.142}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces \emph {Pipeline} completo de segmentación con CLAHE: Otsu → apertura (r=9) → clohole → apertura (r=33) → edgeoff.}}{185}{figure.caption.143}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Simulador interactivo avanzado de morfología con elemento estructurante editable y perfil 1D.}}{186}{figure.caption.147}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Morfología en tonos de gris y sus respectivos histogramas. La erosión reduce intensidades locales, la dilatación las amplía, el gradiente resalta bordes, y los operadores Top-hat y Black-hat evidencian detalles locales brillantes y oscuros. Elemento estructurante: disco de diámetro 19.}}{188}{figure.caption.148}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Algoritmo de etiquetado por \emph {flood-fill} con pila.}}{191}{figure.caption.150}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Simulador interactivo de etiquetado de componentes conexas (\emph {connected component labeling}): visualización de la expansión flood-fill, conectividad-4 y conectividad-8.}}{192}{figure.caption.151}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Efecto de la conectividad en la etiquetación: la imagen binaria 10×10 contiene píxeles diagonalmente adyacentes. Con conectividad-4, estos píxeles forman componentes distintas; con conectividad-8, se fusionan en un único componente.}}{192}{figure.caption.152}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Algoritmo de la Transformada de Distancia.}}{194}{figure.caption.153}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Simulador interactivo de la Transformada de Distancia (TD) iterativa mediante erosión en tonos de gris. Los píxeles fuera de la imagen asumen el valor máximo (144), propagando los costos a partir del fondo interno.}}{195}{figure.caption.154}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Transformada de Distancia en imagen binaria 10×10. Izquierda: original (\emph {foreground} = 255). Centro: mm.dist1 iterativa (erosiones con cruz). Derecha: mm.dist (L2).}}{196}{figure.caption.155}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Simulador interactivo 2D (4x4) con sincronización estricta de colas de propagación horizontal (b) para obtener la convergencia exacta descrita en el artículo.}}{197}{figure.caption.156}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Camino geodésico más corto en un laberinto. Las distancias geodésicas se calculan desde la entrada y la salida usando mm.gdist. Los píxeles cuya suma de las dos distancias es igual a la distancia mínima entre los marcadores pertenecen a un camino óptimo.}}{198}{figure.caption.157}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Algoritmo Didáctico de \emph {Watershed} por Crecimiento de Regiones Limitado por Máscara.}}{200}{figure.caption.158}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Simulador interactivo del Algoritmo \emph {Watershed} por propagación morfológica. Dibuja la máscara, coloca los marcadores y ajusta el Elemento Estructurante para observar la inundación. Cuando las cuencas se encuentran simultáneamente, el empate se resuelve asumiendo una de las regiones de manera aleatoria.}}{201}{figure.caption.159}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} \emph {watershed} delimitado por máscara en imagen binaria 20×20.}}{202}{figure.caption.160}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces \emph {Pipeline} \emph {Watershed} para separación de monedas superpuestas: desde la máscara binaria dilatada hasta los contornos finales anotados sobre la imagen original.}}{204}{figure.caption.161}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Componentes conexos extraídos tras el \emph {pipeline} CLAHE → Otsu → limpieza morfológica. Cada objeto se colorea con color distinto y se anota con su área en píxeles.}}{206}{figure.caption.162}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Contornos extraídos con \emph {findContours}. Cada moneda se anota con su circularidad --- valores cercanos a 1 confirman forma circular.}}{208}{figure.caption.163}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces \emph {Bounding boxes} derivadas de los componentes conectados superpuestas a la imagen original. Las anotaciones se exportan en el formato YOLO (\emph {clase cx cy w h}), con coordenadas normalizadas al intervalo {[}0,1{]}.}}{209}{figure.caption.164}%
\contentsline {figure}{\numberline {4.30}{\ignorespaces Simulador EP04\_01: Umbralización Global por Umbral Fijo (p' = (p \textgreater {} T) ? 255 : 0)}}{221}{figure.caption.166}%
