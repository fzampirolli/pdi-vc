\contentsline {figure}{\numberline {3.1}{\ignorespaces \emph {Mandrill} (\emph {Mandrillus sphinx}) fotografiado en ambiente natural en Sudáfrica. Crédito: Carlos Guilherme Rodrigues (CC BY-SA 3.0).}}{99}{figure.caption.63}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Operaciones aritméticas saturadas: suma de constante (aclarado) y resta de constante (oscurecido con saturación en 0).}}{100}{figure.caption.65}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Retrato de un leopardo (\emph {Panthera pardus}) en ambiente natural. Crédito: C. Brück (CC BY-SA 4.0).}}{101}{figure.caption.67}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces \emph {Mezcla alfa} entre recortes alineados de mandril y del leopardo (Figura~\ref {fig-03-leopardo}) para diferentes valores de α. En α=1 se ve solo el mandril; en α=0, solo el leopardo; valores intermedios fusionan las miradas de las dos imágenes proporcionalmente.}}{101}{figure.caption.68}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Operaciones lógicas bit a bit con máscara circular: AND (aislamiento de la ROI), OR (iluminación de la ROI) y NOT (negativo).}}{102}{figure.caption.70}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Histogramas de la imagen original, de una versión oscurecida (−80) y de una aclarada (+80). La resta/suma satura en 0 y 255.}}{103}{figure.caption.73}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Ecualización de histograma en imagen 5×5 con 3 bits (L=8): imagen original con tonos concentrados en \{2,3,4\}, imagen ecualizada con tonos redistribuidos para \{1,5,7\}, y los respectivos histogramas evidenciando la dispersión de las frecuencias.}}{106}{figure.caption.75}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Ecualización de histograma: mm.equalize (global vía CDF) vs.~CLAHE (adaptativa con limitación de contraste). Los histogramas revelan la dispersión progresiva de las intensidades.}}{107}{figure.caption.76}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Especificación de histograma: mandril mapeada al perfil tonal del leopardo. La CDF de salida aproxima la CDF de referencia.}}{108}{figure.caption.78}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Correlación con \emph {kernel} de media 3×3: versión didáctica (mm.conv0) vs.~vectorizada (mm.conv vía cv2.filter2D). La diferencia máxima de 39 ocurre en los bordes.}}{114}{figure.caption.83}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces \emph {Patch} 5×5 extraído de la imagen del leopardo (posición {[}250:255, 250:255{]}). La ventana amarilla resalta la vecindad 3×3 centrada en el píxel {[}1,1{]} donde se calculará la correlación.}}{115}{figure.caption.84}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Filtro de media con \emph {kernels} de tamaño creciente (3×3, 7×7, 15×15). El desenfoque de los bordes aumenta con el tamaño del \emph {kernel}.}}{116}{figure.caption.86}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces \emph {Núcleo} Gaussiano 5×5 (σ=1): pesos normalizados, mayores en el centro y decrecientes radialmente. La cuadrícula facilita la lectura de cada coeficiente.}}{117}{figure.caption.88}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Comparación entre filtro de media y Gaussiano (\emph {kernel} 9×9, σ=0). El Gaussiano preserva mejor los bordes, visible en el detalle del rostro.}}{119}{figure.caption.89}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Simulador: Filtrado Espacial de Realce 1D (Unsharp Masking y High-Boost)}}{120}{figure.caption.91}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces \emph {Kernel} Laplaciano w4 aplicado al \emph {patch} 5×5: la ventana amarilla resalta la vecindad 3×3 donde se calcula el operador de segunda derivada.}}{122}{figure.caption.95}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Laplaciano aplicado a la imagen del leopardo: respuesta cruda (bordes) con w4 y w8, e imágenes realzadas por la sustracción del Laplaciano. w8 es más sensible a las diagonales.}}{123}{figure.caption.96}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces Operador de Sobel en la imagen del leopardo: Gx detecta bordes verticales, Gy detecta bordes horizontales, y la magnitud \textbar ∇f\textbar {} combina ambos, revelando todos los bordes independientemente de la dirección.}}{125}{figure.caption.100}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces Operador de Prewitt: Gx, Gy y magnitud --- comparable al Sobel, pero sin ponderación Gaussiana perpendicular.}}{125}{figure.caption.102}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Realce de nitidez por \emph {Unsharp Masking} en la imagen del leopardo: la imagen suavizada se resta de la original para generar la máscara de alta frecuencia, que luego se reintroduce para resaltar bordes y detalles.}}{127}{figure.caption.104}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces \emph {Unsharp Masking} en la imagen del leopardo con σ=1 y k de 0.5 a 8.0. Para k\textgreater 2 aparecen halos en los bordes y el ruido de fondo se nota.}}{128}{figure.caption.105}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Detector de Canny con diferentes pares de umbral: umbrales bajos capturan más bordes (incluso ruido); umbrales altos retienen solo los bordes más fuertes.}}{129}{figure.caption.106}%
\contentsline {figure}{\numberline {3.23}{\ignorespaces Ruido sal y pimienta con densidades crecientes (2\%, 5\%, 10\%). El parámetro prob indica la fracción total de píxeles corrompidos, mitad sal (255) y mitad pimienta (0).}}{130}{figure.caption.107}%
\contentsline {figure}{\numberline {3.24}{\ignorespaces Comparación de filtros para eliminación de ruido sal y pimienta (10\%): Gaussiano, Media, Mediana, Bilateral y Morfológico. Fila superior: imágenes completas; fila inferior: recorte de la región de interés.}}{133}{figure.caption.109}%
\contentsline {figure}{\numberline {3.25}{\ignorespaces \emph {Pipeline} de preprocesamiento: CLAHE → Gaussiano → Canny. Cada etapa prepara la imagen para la siguiente, resultando en bordes limpios y bien definidos.}}{134}{figure.caption.110}%
