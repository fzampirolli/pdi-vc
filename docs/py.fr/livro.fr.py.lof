\contentsline {figure}{\numberline {4.1}{\ignorespaces Image avec des pièces de différents types. Crédit : GAZI.MD.AHAD (CC BY-SA 4.0).}}{163}{figure.caption.124}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Comparaison des pré-traitements : image \textbar {} histogramme+T* \textbar {} σ²B(T) \textbar {} Otsu. La meilleure séparation bimodale indique le seuil le plus fiable.}}{166}{figure.caption.125}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Élément structurant en forme de croix (\(B_{\text {cruz}}\)) utilisé pour la connectivité-4.}}{168}{figure.caption.127}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Érosion et dilatation sur une image binaire 10×10 avec un élément structurant « L » asymétrique 3×3. Validation de la dualité érosion--dilatation.}}{174}{figure.caption.129}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Simulateur : Érosion Morphologique (A ⊖ B\_L)}}{175}{figure.caption.130}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Ouverture, fermeture, composition et filtre séquentiel alterné appliqués à la binarisation d'Otsu des pièces avec CLAHE. Élément structurant : disque 13×13.}}{177}{figure.caption.133}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Simulateur interactif de dilatation géodésique : le marqueur f (vert) se propage pas à pas le long des chemins libres du masque g, sans traverser les murs.}}{179}{figure.caption.135}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Résolution de labyrinthe via Opérations Complémentaires : en inversant le masque et le marqueur au début du \emph {pipeline}, le flux est résolu directement dans le domaine complémentaire via mm.cero et mm.suprec, éliminant les ré-inversions redondantes.}}{182}{figure.caption.137}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \emph {Pipeline} de Reconstruction Morphologique par Dilatation Conditionnée : le masque contient deux objets, le marqueur isole uniquement le noyau de l'objet principal, et les itérations suivantes en boucle reconstruisent sa forme exacte jusqu'à la convergence.}}{184}{figure.caption.139}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \emph {Pipeline} de remplissage de trous (\emph {clohole}) : le marqueur est obtenu à partir du bord de l'image et restreint au complément \(f^c\). Les itérations de dilatation géodésique reconstruisent le fond externe ; après la complémentation finale, les trous internes sont remplis.}}{186}{figure.caption.142}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \emph {Pipeline} de suppression des structures de bord (\emph {edgeoff}) : le marqueur capture les racines connectées aux extrémités de la matrice, la reconstruction délimite l'étendue de ces éléments et la soustraction booléenne préserve uniquement les objets totalement internes.}}{186}{figure.caption.143}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Pipeline complet de segmentation avec CLAHE : Otsu → ouverture (r=9) → clohole → ouverture (r=33) → edgeoff.}}{188}{figure.caption.144}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Simulateur interactif avancé de morphologie avec élément structurant modifiable et profil 1D.}}{189}{figure.caption.148}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Morphologie en niveaux de gris et leurs histogrammes respectifs. L'érosion réduit les intensités locales, la dilatation les amplifie, le gradient met en évidence les bords, et les opérateurs Top-hat et Black-hat révèlent les détails locaux clairs et sombres. Élément structurant : disque de diamètre 19.}}{191}{figure.caption.149}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Algorithme d'étiquetage par \emph {flood-fill} avec pile.}}{194}{figure.caption.151}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Simulateur interactif d'étiquetage de composantes connexes (\emph {connected component labeling}) : visualisation de l'expansion flood-fill, connectivité-4 et connectivité-8.}}{195}{figure.caption.152}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Effet de la connectivité sur l'étiquetage : l'image binaire 10×10 contient des pixels adjacents en diagonale. Avec la connectivité-4, ces pixels forment des composantes distinctes ; avec la connectivité-8, ils fusionnent en une seule composante.}}{195}{figure.caption.153}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Algorithme de la Transformée de Distance.}}{197}{figure.caption.154}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces Simulateur interactif de la Transformée de Distance (TD) itérative via érosion en niveaux de gris. Les pixels hors de l'image prennent la valeur maximale (144), propageant les coûts depuis le fond interne.}}{198}{figure.caption.155}%
\contentsline {figure}{\numberline {4.20}{\ignorespaces Transformée de distance sur une image binaire 10×10. Gauche : image originale (\emph {foreground} = 255). Centre : mm.dist1 itérative (érosions avec élément croix). Droite : mm.dist (L2 euclidienne).}}{199}{figure.caption.156}%
\contentsline {figure}{\numberline {4.21}{\ignorespaces Simulateur interactif 2D (4x4) avec synchronisation stricte des files de propagation horizontale (b) pour obtenir la convergence exacte décrite dans l'article.}}{200}{figure.caption.157}%
\contentsline {figure}{\numberline {4.22}{\ignorespaces Plus court chemin géodésique dans un labyrinthe. Les distances géodésiques sont calculées à partir de l'entrée et de la sortie en utilisant mm.gdist. Les pixels dont la somme des deux distances est égale à la distance minimale entre les marqueurs appartiennent à un chemin optimal.}}{201}{figure.caption.158}%
\contentsline {figure}{\numberline {4.23}{\ignorespaces Algorithme didactique de \emph {Watershed} par croissance de régions limitée par masque.}}{203}{figure.caption.159}%
\contentsline {figure}{\numberline {4.24}{\ignorespaces Simulateur interactif de l'algorithme \emph {Watershed} par propagation morphologique. Dessinez le masque, positionnez les marqueurs et ajustez l'élément structurant pour observer l'inondation. Lorsque les bassins se rencontrent simultanément, l'égalité est résolue en supposant l'une des régions de manière aléatoire.}}{204}{figure.caption.160}%
\contentsline {figure}{\numberline {4.25}{\ignorespaces \emph {Pipeline} \emph {watershed} délimité par masque sur image binaire 20×20.}}{205}{figure.caption.161}%
\contentsline {figure}{\numberline {4.26}{\ignorespaces \emph {Pipeline} \emph {Watershed} pour séparation de pièces superposées : de la masque binaire dilatée jusqu'aux contours finaux annotés sur l'image originale.}}{207}{figure.caption.162}%
\contentsline {figure}{\numberline {4.27}{\ignorespaces Composants connexes extraits après le \emph {pipeline} CLAHE → Otsu → nettoyage morphologique. Chaque objet est coloré avec une couleur distincte et annoté avec sa superficie en pixels.}}{209}{figure.caption.163}%
\contentsline {figure}{\numberline {4.28}{\ignorespaces Contours extraits avec \emph {findContours}. Chaque pièce est annotée avec sa circularité --- des valeurs proches de 1 confirment une forme circulaire.}}{211}{figure.caption.164}%
\contentsline {figure}{\numberline {4.29}{\ignorespaces \emph {Boîtes englobantes} dérivées des composantes connexes superposées à l'image d'origine. Les annotations sont exportées au format YOLO (\emph {classe cx cy w h}), avec des coordonnées normalisées pour l'intervalle {[}0,1{]}.}}{212}{figure.caption.165}%
