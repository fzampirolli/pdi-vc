\contentsline {figure}{\numberline {7.1}{\ignorespaces Exemple motivationnel : différents fruits formant des regroupements distincts dans un espace de caractéristiques.}}{374}{figure.caption.252}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Aperçu du \emph {pipeline} classique de classification d'images : extraction de descripteurs (LBP, HOG), formation de l'espace des caractéristiques et classification via k-NN. Ne s'applique pas aux modèles d'apprentissage profond (CNN, YOLO), qui apprennent des \emph {features} de bout en bout directement à partir des pixels. \textbf {Source :} élaboré avec l'aide de Gemini Notebook (\{GOOGLE\}, 2025).}}{375}{figure.caption.253}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Comparaison visuelle de différents descripteurs appliqués à la même image. Chaque descripteur révèle des aspects distincts de la scène.}}{377}{figure.caption.254}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Histogramme des codes LBP de l'image du cameraman. Chaque barre représente la fréquence relative d'un code LBP, formant le vecteur de caractéristiques utilisé pour décrire la texture.}}{378}{figure.caption.255}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Premiers 100 composants du vecteur de caractéristiques HOG.}}{380}{figure.caption.256}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Importância da normalização das características para o classificador k-NN.}}{383}{figure.caption.257}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Carte conceptuelle du processus de classification d'images utilisant des descripteurs classiques (LBP, HOG, pixels bruts) et un classifieur traditionnel (k-NN). Ne s'applique pas aux modèles d'apprentissage profond (CNN, YOLO), qui apprennent des \emph {features end-to-end} directement à partir des pixels.}}{384}{figure.caption.258}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Matrices de confusion obtenues par le classifieur k-NN utilisant trois descripteurs différents. Les lignes représentent la classe réelle (Pomme, Banane et Orange) et les colonnes la classe prédite. Plus la concentration de valeurs sur la diagonale principale est élevée, meilleure est la performance du descripteur.}}{387}{figure.caption.259}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Comparaison détaillée de l'exactitude globale dans un scénario réaliste. Observez comment les descripteurs extraits structurellement (LBP et HOG) surpassent l'utilisation des intensités pures des pixels bruts.}}{388}{figure.caption.260}%
\contentsline {figure}{\numberline {7.10}{\ignorespaces Illustration du processus de génération de données synthétiques avec \emph {make\_classification}. À gauche, visualisation des trois classes dans un espace bidimensionnel formé par deux caractéristiques informatives. À droite, importance relative de chaque caractéristique pour la classification, montrant que seulement 7 des 10 caractéristiques sont effectivement discriminantes, tandis que les autres sont redondantes (2) ou répétées (1).}}{391}{figure.caption.261}%
\contentsline {figure}{\numberline {7.11}{\ignorespaces Classification d'un nouvel échantillon par l'algorithme k-NN. Le point de test (étoile) est classé à partir des trois voisins les plus proches, mis en évidence par des cercles.}}{394}{figure.caption.262}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces Simulateur interactif de la frontière de décision du k-NN : ajoutez des points d'entraînement et ajustez la valeur de k pour observer l'effet sur la région de décision.}}{395}{figure.caption.263}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces Échantillon de chiffres manuscrits de la base \emph {load\_digits}, utilisé comme étude de cas de classification.}}{396}{figure.caption.264}%
\contentsline {figure}{\numberline {7.14}{\ignorespaces Matrice de confusion du classificateur k-NN entraîné avec des vecteurs d'intensité bruts (pixels).}}{397}{figure.caption.265}%
\contentsline {figure}{\numberline {7.15}{\ignorespaces Comparaison de précision entre les descripteurs de pixels bruts et HOG pour le classificateur k-NN (k=3) sur la base de chiffres.}}{398}{figure.caption.266}%
\contentsline {figure}{\numberline {7.16}{\ignorespaces Précision moyenne par validation croisée (5 partitions) en fonction du paramètre k, pour la base de chiffres avec vecteurs d'intensité bruts.}}{400}{figure.caption.267}%
\contentsline {figure}{\numberline {7.17}{\ignorespaces Précision sur les ensembles d'entraînement et de test pour différentes valeurs de \(k\). Les régions colorées représentent, de manière conceptuelle, les tendances de comportement du classifieur : risque plus élevé de surajustement (rouge), compromis entre biais et variance (vert) et risque plus élevé de sous-ajustement (bleu).}}{402}{figure.caption.268}%
\contentsline {figure}{\numberline {7.18}{\ignorespaces Échantillons synthétiques des trois classes de texture utilisées dans l'expérience de classification, générés avec un bruit gaussien et une variabilité intra-classe.}}{404}{figure.caption.269}%
\contentsline {figure}{\numberline {7.19}{\ignorespaces Précision moyenne obtenue par validation croisée (5-fold) pour les descripteurs de Pixels Bruts, LBP et HOG appliqués à la base de textures synthétiques.}}{406}{figure.caption.270}%
\contentsline {figure}{\numberline {7.20}{\ignorespaces Métriques d'évaluation détaillées pour le classificateur k-NN avec descripteurs LBP}}{409}{figure.caption.271}%
\contentsline {figure}{\numberline {7.21}{\ignorespaces Simulateur EP07\_01 : Classifieur k-NN Pas à Pas}}{415}{figure.caption.272}%
\contentsline {figure}{\numberline {7.22}{\ignorespaces Simulateur EP07\_02: Effet de la Normalisation \emph {Z-score} sur la Distance k-NN}}{418}{figure.caption.273}%
\contentsline {figure}{\numberline {7.23}{\ignorespaces Simulateur EP07\_03 : Précision x Rappel}}{420}{figure.caption.274}%
\contentsline {figure}{\numberline {7.24}{\ignorespaces Simulateur EP07\_04 : Code LBP d'un voisinage 3×3}}{422}{figure.caption.275}%
