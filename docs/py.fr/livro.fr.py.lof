\contentsline {figure}{\numberline {6.22}{\ignorespaces Simulateur EP06\_02 : Filtre de Marqueurs par Circularité}}{355}{figure.caption.245}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Simulateur EP06\_03 : Classification des marquages OMR}}{357}{figure.caption.246}%
