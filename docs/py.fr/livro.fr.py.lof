\contentsline {figure}{\numberline {6.1}{\ignorespaces Échantillon d'images publiques de \emph {skimage.data}, groupées par domaine d'application.}}{312}{figure.caption.224}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Comparaison entre stratégies de prétraitement pour la binarisation de l'image de texte : (a) image originale ; (b) seuillage direct par la méthode d'Otsu ; (c) fond estimé par filtrage gaussien ; (d) image après normalisation du fond (division par l'image lissée) ; (e) CLAHE suivi d'un seuillage par Otsu ; et (f) normalisation du fond suivie d'un seuillage par Otsu. Les images illustrent l'effet de chaque technique sur la compensation des variations d'éclairage et sur la qualité de la segmentation.}}{313}{figure.caption.225}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Comparaison du texte extrait par Tesseract à partir de quatre versions de la même image : (a) image originale ; (b) CLAHE suivi d'un seuillage par Otsu ; (c) normalisation du fond suivie d'un seuillage par Otsu ; et (d) normalisation du fond en niveaux de gris, sans seuillage. La comparaison montre que la binarisation externe ne favorise pas toujours la reconnaissance, car Tesseract effectue déjà sa propre binarisation adaptative en interne.}}{316}{figure.caption.226}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Flux de reconnaissance et de traduction automatique. L'image prétraitée par normalisation du fond, sans seuillage, est utilisée comme entrée pour le Tesseract OCR, et le texte reconnu est traduit de l'anglais vers le portugais à l'aide de la bibliothèque \emph {deep-translator}.}}{318}{figure.caption.227}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces \emph {Pipeline} d'ingestion de documents : rasterisation adaptative de pages PDF en matrices discrètes au format PNG, affichant la page deux.}}{320}{figure.caption.228}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Simulateur interactif de correction d'inclinaison (\emph {deskew}) : déplacez le \emph {curseur} pour incliner le document et observez les trois étapes du \emph {pipeline} --- image inclinée, contours Canny et résultat corrigé.}}{323}{figure.caption.229}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces \emph {Pipeline} de redressement axial : affichage comparatif entre l'entrée rotée d'origine, la carte de gradients structurels de Canny et le résultat final aligné avec un fond normalisé en blanc.}}{324}{figure.caption.230}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Détection des disques marqueurs, extraction des contours et redressement par transformation de perspective.}}{327}{figure.caption.231}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Simulateur interactif de filtrage par circularité : déplacez le \emph {curseur} pour ajuster le seuil C et observez quels composants sont acceptés (vert) ou rejetés (rouge).}}{328}{figure.caption.232}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces \emph {Pipeline} de traitement du \emph {QRCode} : seuillage, ouverture morphologique, inversion et recadrage final pour décodage.}}{331}{figure.caption.233}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Simulateur interactif du \emph {pipeline} d'isolation du QRCode : parcourez les étapes de filtrage, ajustez l'élément structurant de la fermeture morphologique et voyez la détection du contour carré sur l'image originale du gabarit.}}{332}{figure.caption.234}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Décodage de code-barres linéaire avec \emph {pyzbar} : image d'entrée et données extraites.}}{334}{figure.caption.235}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Image de la feuille de réponses en niveaux de gris chargée à partir du PDF rasterisé.}}{336}{figure.caption.236}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Zone de réponses extraite par \emph {getAnswerArea} : région rectifiée contenant les cases de marquage.}}{337}{figure.caption.237}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Région du \emph {QRCode} isolée par \emph {segmentQRcode} dans la zone de réponses rectifiée.}}{338}{figure.caption.238}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Recorte inférieur de la zone de réponses, concentrant les cadres de bulles à segmenter.}}{339}{figure.caption.239}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Réponses lues automatiquement par MCTest après segmentation et classification de toutes les bulles.}}{341}{figure.caption.240}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Détection de défaut par soustraction d'image : produit de référence, image avec défaut simulé et masque d'anomalie détectée.}}{343}{figure.caption.241}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Simulateur interactif d'inspection industrielle par soustraction d'images : contrôlez les distorsions géométriques de désalignement (enregistrement) et le seuil de détection pour observer l'impact sur les faux positifs.}}{344}{figure.caption.242}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Détection d'hétérogénéité de texture : carte de variance locale et masque d'anomalie.}}{346}{figure.caption.243}%
