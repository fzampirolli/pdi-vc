\contentsline {figure}{\numberline {3.1}{\ignorespaces \emph {Mandrill} (\emph {Mandrillus sphinx}) photographié en environnement naturel en Afrique du Sud. L'image a une résolution de 500 px et contient des métadonnées EXIF avec des coordonnées GPS approximatives (-26.20473, 28.22662). Crédit : Carlos Guilherme Rodrigues (CC BY-SA 3.0).}}{99}{figure.caption.64}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Opérations arithmétiques saturées : addition de constante (éclaircissement) et soustraction de constante (assombrissement avec saturation à 0).}}{100}{figure.caption.66}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Portrait d'un léopard (\emph {Panthera pardus}) dans un environnement naturel. Crédit : C. Brück (CC BY-SA 4.0).}}{101}{figure.caption.68}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces \emph {Mélange alpha} entre des découpes alignées de mandrill et du léopard (Figure~\ref {fig-03-leopardo}) pour différentes valeurs de α. À α=1, on ne voit que le mandrill ; à α=0, seulement le léopard ; les valeurs intermédiaires fusionnent proportionnellement les regards des deux images.}}{102}{figure.caption.69}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Opérations logiques bit à bit avec masque circulaire : AND (isolation de la ROI), OR (éclairage de la ROI) et NOT (négatif).}}{103}{figure.caption.71}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Histogramas de l'image originale, d'une version assombrie et d'une version éclaircie. Les valeurs sur la deuxième ligne indiquent le nombre de pixels saturés à 0 (noir) et 255 (blanc).}}{104}{figure.caption.74}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Égalisation d'histogramme sur une image 5×5 avec 3 bits (L=8) : image originale avec des tons concentrés sur \{2,3,4\}, image égalisée avec des tons redistribués sur \{1,5,7\}, et les histogrammes respectifs montrant l'étalement des fréquences.}}{107}{figure.caption.76}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Égalisation d'histogramme : mm.equalize (global via CDF) vs.~CLAHE (adaptative avec limitation de contraste). Les histogrammes révèlent l'étalement progressif des intensités.}}{108}{figure.caption.77}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Spécification de l'histogramme : mandrill mappé vers le profil tonal du léopard. La CDF de sortie se rapproche de la CDF de référence.}}{109}{figure.caption.79}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Corrélation avec \emph {noyau} de moyenne 3×3 : version didactique (mm.conv0) vs.~vectorisée (mm.conv via cv2.filter2D). La différence maximale de 39 se produit sur les bords.}}{116}{figure.caption.84}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces \emph {Patch} 5×5 extrait de l'image du léopard (position {[}250:255, 250:255{]}). La fenêtre jaune met en évidence le voisinage 3×3 centré sur le pixel {[}1,1{]} où la corrélation sera calculée.}}{117}{figure.caption.85}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Filtre de moyenne avec des \emph {kernels} de taille croissante (3×3, 7×7, 15×15). Le flou des bords augmente avec la taille du \emph {kernel}.}}{118}{figure.caption.87}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces \emph {Noyau} gaussien 5×5 (σ=1) : poids normalisés, plus grands au centre et décroissant radialement. La grille facilite la lecture de chaque coefficient.}}{119}{figure.caption.89}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Comparaison entre filtre de moyenne et gaussien (\emph {kernel} 9×9, σ=0). Le gaussien préserve mieux les bords, visible dans le détail du visage.}}{120}{figure.caption.90}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Simulateur : Filtrage spatial d'accentuation 1D (Unsharp Masking et High-Boost)}}{121}{figure.caption.92}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces \emph {Noyau} Laplacien w4 appliqué au \emph {patch} 5×5 : la fenêtre jaune met en évidence le voisinage 3×3 où l'opérateur de dérivée seconde est calculé.}}{123}{figure.caption.96}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Laplacien appliqué à l'image du léopard : réponse brute (bords détectés) avec w4 et w8, et images rehaussées par soustraction du Laplacien. w8 est plus sensible aux diagonales.}}{124}{figure.caption.97}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces Opérateur de Sobel sur l'image du léopard : Gx détecte les bords verticaux, Gy détecte les bords horizontaux, et la magnitude \textbar ∇f\textbar {} combine les deux, révélant tous les bords indépendamment de la direction.}}{126}{figure.caption.101}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces Opérateur de Prewitt : Gx, Gy et magnitude --- comparable à Sobel, mais sans pondération gaussienne perpendiculaire.}}{126}{figure.caption.103}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Réhaussement de netteté par \emph {Unsharp Masking} sur l'image du léopard : l'image lissée est soustraite de l'originale pour générer le masque haute fréquence, qui est ensuite réintroduit pour accentuer les contours et les détails.}}{128}{figure.caption.105}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces \emph {Détourage (Unsharp Masking)} sur l'image du léopard avec σ=1 et k variant de 0.5 à 8.0. Pour k\textgreater 2, des artefacts apparaissent sur les bords (halos) et le bruit de fond commence à être visible.}}{129}{figure.caption.106}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Détecteur de Canny avec différentes paires de seuils : des seuils bas capturent plus de bords (y compris le bruit) ; des seuils élevés ne conservent que les bords les plus forts.}}{130}{figure.caption.107}%
\contentsline {figure}{\numberline {3.23}{\ignorespaces Bruit sel et poivre avec des densités croissantes (2 \%, 5 \%, 10 \%). Le paramètre prob indique la fraction totale de pixels corrompus, moitié sel (255) et moitié poivre (0).}}{131}{figure.caption.108}%
\contentsline {figure}{\numberline {3.24}{\ignorespaces Comparaison de filtres pour la suppression du bruit sel et poivre (10 \%) : Gaussien, Moyenne, Médiane, Bilatéral et Morphologique. Ligne supérieure : images complètes ; ligne inférieure : recadrage de la région d'intérêt.}}{134}{figure.caption.110}%
\contentsline {figure}{\numberline {3.25}{\ignorespaces \emph {Pipeline} de pré-processamento : CLAHE → Gaussiano → Canny. Cada etapa prepara a imagem para a seguinte, resultando em bordas limpas e bem definidas.}}{135}{figure.caption.111}%
\contentsline {figure}{\numberline {3.26}{\ignorespaces Simulateur EP03\_01 : Addition saturée de constante (p' = clip(p + k))}}{139}{figure.caption.112}%
\contentsline {figure}{\numberline {3.27}{\ignorespaces Simulateur EP03\_02 : Mélange Alpha de Deux Images (g = α·f1 + (1−α)·f2)}}{141}{figure.caption.113}%
\contentsline {figure}{\numberline {3.28}{\ignorespaces Simulador EP03\_03 : Inversion d'image --- Négatif photographique (p' = 255 − p)}}{143}{figure.caption.114}%
\contentsline {figure}{\numberline {3.29}{\ignorespaces Simulateur EP03\_04 : Égalisation d'histogramme (Niveaux L = 2\^{}B)}}{145}{figure.caption.115}%
\contentsline {figure}{\numberline {3.30}{\ignorespaces Simulateur EP03\_05: Application de masque AND binaire}}{147}{figure.caption.116}%
\contentsline {figure}{\numberline {3.31}{\ignorespaces Simulateur EP03\_06: Filtre de Moyenne avec Noyau N×N}}{149}{figure.caption.117}%
\contentsline {figure}{\numberline {3.32}{\ignorespaces Simulateur EP03\_07 : Opérateur Laplacien (w4) pour le rehaussement des contours}}{152}{figure.caption.118}%
\contentsline {figure}{\numberline {3.33}{\ignorespaces Simulateur EP03\_08 : Gradient de Sobel (Gx et Gy)}}{154}{figure.caption.119}%
\contentsline {figure}{\numberline {3.34}{\ignorespaces Simulateur EP03\_09 : Filtre de la Médiane 3×3}}{156}{figure.caption.120}%
\contentsline {figure}{\numberline {3.35}{\ignorespaces Simulateur EP03\_10 : \emph {Unsharp Masking} (USM)}}{158}{figure.caption.121}%
