```{mermaid}
%%| label: fig-07-mapa-conceitual
%%| fig-cap: "Mapa conceitual do processo de classificação de imagens utilizando descritores clássicos."
%%| echo: false

%%{init: {'theme': 'base', 'themeVariables': {
  'background': '#fafbfc',
  'primaryColor': '#eef6ff',
  'primaryBorderColor': '#8bb8d6',
  'primaryTextColor': '#1a2a3a',
  'lineColor': '#8ba9c4',
  'fontSize': '15px'
}}}%%

flowchart TD

    IMG["🖼️ Imagem"]

    PRE["🧹 Pré-processamento<br/>(Parte I do livro)"]

    DESC{"🔎 Extração de descritores"}

    P["Pixels<br/>brutos"]
    L["LBP"]
    H["HOG"]

    FV["📊 Vetor de<br/>características"]

    NORM["⚖️ Normalização<br/>(StandardScaler)"]

    DIV["✂️ Divisão em<br/>treinamento e teste"]

    KNN["🤖 Classificador<br/>k-NN"]

    PRED["🏷️ Classe<br/>predita"]

    EVAL{"📈 Avaliação"}

    ACC["Acurácia"]
    CM["Matriz de<br/>confusão"]

    IMG --> PRE
    PRE --> DESC

    DESC --> P
    DESC --> L
    DESC --> H

    P --> FV
    L --> FV
    H --> FV

    FV --> NORM
    NORM --> DIV
    DIV --> KNN
    KNN --> PRED
    PRED --> EVAL

    EVAL --> ACC
    EVAL --> CM

    NOTE["💡 Apenas o descritor muda.<br/>Todo o restante do pipeline permanece igual."]

    DESC -.-> NOTE

    style IMG fill:#dbeafe,stroke:#6096c7,stroke-width:2px
    style PRE fill:#eaf7ea,stroke:#7fb77e,stroke-width:2px
    style DESC fill:#fff8e6,stroke:#d4a017,stroke-width:2px

    style P fill:#f8f9fa,stroke:#adb5bd
    style L fill:#f8f9fa,stroke:#adb5bd
    style H fill:#f8f9fa,stroke:#adb5bd

    style FV fill:#fdebd0,stroke:#e59866,stroke-width:2px
    style NORM fill:#e8f8f5,stroke:#48c9b0,stroke-width:2px
    style DIV fill:#f4ecf7,stroke:#af7ac5,stroke-width:2px
    style KNN fill:#d5f5e3,stroke:#58d68d,stroke-width:2px
    style PRED fill:#ebf5fb,stroke:#5dade2,stroke-width:2px
    style EVAL fill:#f9ebea,stroke:#ec7063,stroke-width:2px

    style ACC fill:#fcf3cf,stroke:#d4ac0d
    style CM fill:#fcf3cf,stroke:#d4ac0d

    style NOTE fill:#fff9e6,stroke:#f5cba7,stroke-width:2px
```
