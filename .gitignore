# Cópias de morph.py/testsuite.py/config.py baixadas em runtime pelas células
# de bootstrap dos notebooks (all/capXX/*.ipynb baixam de BASE_URL se o
# arquivo não existir no diretório local) — nunca versionar, senão ficam
# desatualizadas e bloqueiam o próximo download.
all/*/morph.py
all/*/testsuite.py
all/*/config.py

