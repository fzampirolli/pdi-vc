# Saídas pesadas e intermediárias
runs*

# Arquivos de imagem/vídeo temporários ou grandes se não forem assets diretos
*.mp4
*.avi

# Cache de traduções do pipeline — versionado de propósito (compartilhar
# entre máquinas, evitar retraduzir, permitir correção manual pontual;
# ver pipeline/cache.py). Só o JSON canônico entra no git; os artefatos de
# salvaguarda (backups datados, quarentena de corrupção, .tmp de escrita
# atômica) são locais e efêmeros.
.cache/backups/
.cache/translations.json.tmp
.cache/translations.json.corrupt-*
.cache/translations.json.bak

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs e artefatos LaTeX
*.log
*.aux
*.out
*.toc
*.bcf
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.tex

chave_roboflow.txt

# Quarto
.quarto/

# Gerado pelo pipeline — não editar manualmente
gen/

# Cópias de morph.py/testsuite.py/config.py baixadas em runtime pelas células
# de bootstrap dos notebooks (all/capXX/*.ipynb baixam de BASE_URL se o
# arquivo não existir no diretório local) — nunca versionar, senão ficam
# desatualizadas e bloqueiam o próximo download.
all/*/morph.py
all/*/testsuite.py
all/*/config.py

# Artefatos de build da trilha C++, gerados ao EXECUTAR os notebooks
# (.cpp gerado, binário sem extensão, PNG intermediário do MM_OUT e
# state/ da passagem de mm::Image entre células — ver
# pipeline/notebook_processor.py:TMP_DIR).
all/*/tmp/
notebooks_alunos/*/*/tmp/

# Libs baixadas em runtime por config.setup() ao executar os notebooks do
# aluno (morph.py/.hpp, stb, testsuite, config) — nunca versionar, senão
# ficam desatualizadas e podem bloquear o próximo download.
notebooks_alunos/*/*/morph.py
notebooks_alunos/*/*/morph.hpp
notebooks_alunos/*/*/stb_image.h
notebooks_alunos/*/*/stb_image_write.h
notebooks_alunos/*/*/config.py
notebooks_alunos/*/*/testsuite.py
notebooks_alunos/*/*/_mm_download_tmp.img

# Imagem PGM baixada em runtime pela célula do EP01_11 (lê "aula01fig03b.pgm"
# do diretório de execução) — regenerável, não versionar.
all/*/aula01fig03b.pgm
notebooks_alunos/*/*/aula01fig03b.pgm

# Arquivos duplicados/temporários
*copy*
*\ copy*
patch_simuladores.py

# Notebooks com outputs pesados (opcional)
# *.ipynb  # descomente se quiser versionar só os fontes sem outputs.quarto-version
